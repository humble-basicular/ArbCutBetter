---
/* Paslaugų indeksas pagal grupes: visa eilutė yra nuoroda (pavadinimas, aprašymas, kaina, nuotrauka). */
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
let n = 0;
---
<div class="sx">
  {grupes.map((g) => (
    <div class="sx__grp">
      <div class="sx__gh">
        <h3>{g.pavadinimas}</h3>
        <p class="mute">{g.aprasymas}</p>
      </div>
      <ul role="list" class="sx__list">
        {g.slugs.map((s) => {
          const p = byslug[s]; n += 1;
          return (
            <li class="sx__row">
              <a href={`/paslaugos/${s}`} class="sx__a">
                <span class="sx__n">{String(n).padStart(2, '0')}</span>
                <span class="sx__t"><span class="sx__name">{detales[s].h1}</span><span class="sx__d">{p.aprasymas}</span></span>
                <span class="sx__p">{p.kaina}</span>
                <span class="sx__img"><img src={detales[s].thumb || p.nuotrauka} alt="" width="340" height="340" loading="lazy" decoding="async" /></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
<style>
  .sx { display: grid; gap: clamp(40px, 5vw, 64px); }
  .sx__grp { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 36px; }
  .sx__gh { display: grid; gap: 8px; align-content: start; position: sticky; top: calc(var(--header-h) + 24px); }
  .sx__gh h3 { font-size: clamp(1.4rem, 1.2rem + .6vw, 1.8rem); color: var(--spruce-900); }
  .sx__list { display: grid; gap: 8px; }
  .sx__a { display: grid; grid-template-columns: 44px minmax(0, 1fr) auto 112px; gap: 20px; align-items: center; padding: 14px 14px 14px 18px; background: var(--stone); transition: background var(--t); }
  .sx__a:hover { background: var(--spruce-100); }
  .sx__a:hover .sx__name { text-decoration-color: var(--orange); }
  .sx__n { font-stretch: var(--wide); font-size: 1.1rem; font-weight: 800; color: var(--ink-2); }
  .sx__t { display: grid; gap: 4px; }
  .sx__name { font-stretch: var(--wide); font-weight: 800; font-size: 1.2rem; line-height: 1.2; color: var(--spruce-900); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; text-decoration-color: transparent; transition: text-decoration-color var(--t); }
  .sx__d { font-size: .98rem; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sx__p { font-stretch: var(--wide); font-weight: 800; font-size: 1.15rem; white-space: nowrap; color: var(--spruce-900); }
  .sx__img { width: 112px; height: 84px; overflow: hidden; background: var(--spruce-100); clip-path: polygon(0 0, calc(100% - 14px) 0, 100% 14px, 100% 100%, 0 100%); }
  .sx__img img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 960px) { .sx__grp { grid-template-columns: 1fr; gap: 16px; } .sx__gh { position: static; } }
  @media (max-width: 640px) {
    .sx__a { grid-template-columns: 76px minmax(0, 1fr); grid-template-areas: 'img t' 'img p'; gap: 4px 14px; padding: 10px; }
    .sx__n { display: none; }
    .sx__img { grid-area: img; width: 76px; height: 76px; }
    .sx__t { grid-area: t; } .sx__p { grid-area: p; font-size: 1.05rem; }
    .sx__d { display: none; }
    .sx__name { font-size: 1.05rem; }
  }
</style>
