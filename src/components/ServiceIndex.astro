---
/* Numeruotas paslaugų indeksas pagal grupes: pavadinimas, kam tinka, kaina nuo, nuotrauka. */
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import Icon from './Icon.astro';
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
let n = 0;
---
<div class="sx">
  {grupes.map((g) => (
    <div class="sx__grp">
      <div class="sx__gh">
        <h3>{g.pavadinimas}</h3>
        <p class="mute">{g.aprasymas}</p>
      </div>
      <ul role="list" class="sx__list">
        {g.slugs.map((s) => {
          const p = byslug[s]; n += 1;
          return (
            <li class="sx__row">
              <a href={`/paslaugos/${s}`} class="sx__a">
                <span class="sx__n serif">{String(n).padStart(2, '0')}</span>
                <span class="sx__t"><span class="sx__name">{detales[s].h1}</span><span class="sx__d">{p.aprasymas}</span></span>
                <span class="sx__p">{p.kaina}</span>
                <span class="sx__img"><img src={detales[s].thumb || p.nuotrauka} alt="" width="340" height="340" loading="lazy" decoding="async" /></span>
                <span class="sx__go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</div>
<style>
  .sx { display: grid; gap: clamp(36px, 5vw, 56px); }
  .sx__grp { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 32px; }
  .sx__gh { display: grid; gap: 8px; align-content: start; position: sticky; top: calc(var(--header-h) + 24px); }
  .sx__gh h3 { font-size: 1.7rem; }
  .sx__list { border-top: 2px solid var(--ink); }
  .sx__row { border-bottom: 1px solid var(--line); }
  .sx__a { display: grid; grid-template-columns: 52px minmax(0, 1fr) 110px 96px 28px; gap: 20px; align-items: center; padding: 16px 0; transition: background var(--t); }
  .sx__a:hover { background: rgba(255, 253, 249, .7); }
  .sx__a:hover .sx__name { color: var(--timber); }
  .sx__a:hover .sx__go { transform: translateX(4px); color: var(--timber); }
  .sx__n { font-size: 1.25rem; font-weight: 650; color: var(--timber); padding-left: 4px; }
  .sx__t { display: grid; gap: 4px; }
  .sx__name { font-family: var(--serif); font-weight: 620; font-size: 1.2rem; line-height: 1.25; transition: color var(--t); }
  .sx__d { font-size: .93rem; color: var(--mute); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .sx__p { font-weight: 700; font-size: .95rem; white-space: nowrap; }
  .sx__img { width: 96px; height: 72px; overflow: hidden; background: var(--paper-2); }
  .sx__img img { width: 100%; height: 100%; object-fit: cover; }
  .sx__go { color: var(--ink); transition: transform var(--t), color var(--t); }
  @media (max-width: 960px) { .sx__grp { grid-template-columns: 1fr; gap: 16px; } .sx__gh { position: static; } }
  @media (max-width: 640px) {
    .sx__a { grid-template-columns: 72px minmax(0, 1fr) 20px; grid-template-areas: 'img t go' 'img p go'; gap: 4px 14px; }
    .sx__n { display: none; }
    .sx__img { grid-area: img; width: 72px; height: 72px; }
    .sx__t { grid-area: t; } .sx__p { grid-area: p; color: var(--timber); } .sx__go { grid-area: go; }
    .sx__d { display: none; }
    .sx__name { font-size: 1.08rem; }
  }
</style>
