---
/* Vidinių puslapių antraštė: tamsus plotas, trupiniai, H1, įvadas, veiksmai, nuotrauka. */
import { site } from '@data/site.js';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
const { title, kicker, lead, crumbs = [], photo, photoAlt = '', photoPos = '50% 40%', service = '', actions = true } = Astro.props;
---
<section class:list={['phero', 'on-dark', { 'phero--photo': photo }]}>
  <div class="wrap phero__in">
    <div class="phero__txt">
      {crumbs.length > 0 && (
        <nav aria-label="Naršymo kelias"><ol class="crumbs" role="list">
          <li><a href="/">Pradžia</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol></nav>
      )}
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
      {actions && (
        <div class="btn-row phero__btns">
          <a class="btn btn--primary" href={site.telefonasHref} data-loc="page-hero-call"><Icon name="phone" size={18} /> {site.telefonas}</a>
          <button type="button" class="btn btn--line" data-quote data-service={service}>Gauti kainą</button>
        </div>
      )}
    </div>
    {photo && (
      <div class="phero__ph ph"><Photo name={photo} alt={photoAlt} sizes="(max-width: 860px) 100vw, 40vw" loading="eager" fetchpriority="high" position={photoPos} /></div>
    )}
  </div>
</section>
<style>
  .phero { background: var(--ink); color: var(--paper); }
  .phero__in { display: grid; gap: 40px; padding-block: clamp(40px, 6vw, 72px); }
  .phero--photo .phero__in { grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: stretch; padding-bottom: 0; }
  .phero__txt { display: grid; gap: 18px; align-content: center; padding-bottom: clamp(40px, 6vw, 72px); }
  .phero--photo .phero__txt { padding-bottom: clamp(40px, 6vw, 72px); }
  .phero h1 { max-width: 20ch; }
  .phero__btns { margin-top: 8px; }
  .phero__ph { min-height: 320px; }
  .phero__ph :global(img) { position: absolute; inset: 0; }
  @media (max-width: 860px) {
    .phero--photo .phero__in { grid-template-columns: 1fr; gap: 0; }
    .phero__ph { min-height: 0; aspect-ratio: 4 / 3; margin-inline: calc(var(--gutter) * -1); }
  }
</style>
