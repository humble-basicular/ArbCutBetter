---
/* Vidinių puslapių antraštė: šviesus plotas, trupiniai, H1, įvadas, veiksmai,
   reali nuotrauka nukirsto kampo rėme dešinėje. */
import { site } from '@data/site.js';
import Photo from './Photo.astro';
import { Image } from 'astro:assets';
import mantas from '../assets/cutout/mantas-cutout.png';
const { title, kicker, lead, crumbs = [], photo, photoAlt = '', photoPos = '50% 40%', service = '', actions = true, thumbs = [], thumbAlt = '', cutout = false } = Astro.props;
---
<section class:list={['phero', { 'phero--photo': photo || thumbs.length, 'phero--cutout': cutout }]}>
  <div class="wrap phero__in">
    <div class="phero__txt">
      {crumbs.length > 0 && (
        <nav aria-label="Naršymo kelias"><ol class="crumbs" role="list">
          <li><a href="/">Pradžia</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol></nav>
      )}
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
      {actions && (
        <div class="btn-row phero__btns">
          <a class="btn btn--primary" href={site.telefonasHref} data-loc="page-hero-call"><span class="btn__num">{site.telefonas}</span></a>
          <button type="button" class="btn btn--line" data-quote data-service={service}>Gauti kainą</button>
        </div>
      )}
    </div>
    {photo && (
      <div class="phero__side">
        <div class="phero__ph ph cut"><Photo name={photo} alt={photoAlt} sizes="(max-width: 860px) 100vw, 40vw" widths={[480, 800, 1200]} loading="eager" fetchpriority="high" position={photoPos} /></div>
        {cutout && <Image class="phero__cut" src={mantas} alt="" widths={[360, 560, 760]} sizes="(max-width: 860px) 46vw, 300px" format="webp" quality={84} loading="eager" />}
      </div>
    )}
    {!photo && thumbs.length > 0 && (
      <div class="phero__thumbs">{thumbs.map((t) => <div class="ph cut"><img src={t} alt={thumbAlt} width="283" height="230" decoding="async" /></div>)}</div>
    )}
  </div>
</section>
<style>
  .phero { background: var(--spruce-100); color: var(--ink); }
  .phero__in { display: grid; gap: 40px; padding-block: clamp(32px, 4.5vw, 64px) clamp(44px, 6vw, 80px); }
  .phero--photo .phero__in { grid-template-columns: minmax(0, 1.25fr) minmax(0, .75fr); align-items: center; }
  .phero__txt { display: grid; gap: 18px; align-content: center; min-width: 0; }
  .phero h1 { max-width: 20ch; color: var(--spruce-900); }
  .phero__btns { margin-top: 8px; }
  .phero__side { position: relative; width: 100%; justify-self: end; }
  .phero__ph { aspect-ratio: 4 / 5; max-height: 540px; width: 100%; }
  .phero__ph :global(img) { position: absolute; inset: 0; }
  .phero__thumbs { display: grid; gap: 12px; justify-self: end; width: min(100%, 283px); }
  .phero__thumbs .ph { aspect-ratio: 283 / 230; }
  /* /apie: Manto iškarpa užlipa ant nuotraukos kairiojo krašto ir remiasi į juostos apačią */
  .phero--cutout .phero__in { padding-bottom: 0; align-items: end; }
  .phero--cutout .phero__txt { padding-bottom: clamp(44px, 6vw, 80px); }
  .phero--cutout .phero__ph { aspect-ratio: 4 / 5; margin-left: 14%; width: 86%; }
  .phero__cut { position: absolute; left: -9%; bottom: 0; width: 56%; height: auto; max-height: 104%; object-fit: contain; object-position: bottom; pointer-events: none; }
  @media (max-width: 860px) {
    .phero--photo .phero__in { grid-template-columns: 1fr; gap: 28px; }
    .phero__ph { aspect-ratio: 5 / 4; max-height: none; }
    .phero__btns .btn { flex: 1 1 100%; }
    .phero__thumbs { grid-template-columns: 1fr 1fr; width: 100%; justify-self: stretch; }
    .phero--cutout .phero__txt { padding-bottom: 0; }
    .phero--cutout .phero__ph { aspect-ratio: 1 / 1; margin-left: 24%; width: 76%; }
    .phero__cut { left: -2%; width: 50%; }
  }
</style>
