---
/* Vidinių puslapių antraštė: šviesus plotas, trupiniai, H1, įvadas, veiksmai,
   reali nuotrauka nukirsto kampo rėme dešinėje. */
import { site } from '@data/site.js';
import Photo from './Photo.astro';
const { title, kicker, lead, crumbs = [], photo, photoAlt = '', photoPos = '50% 40%', service = '', actions = true } = Astro.props;
---
<section class:list={['phero', { 'phero--photo': photo }]}>
  <div class="wrap phero__in">
    <div class="phero__txt">
      {crumbs.length > 0 && (
        <nav aria-label="Naršymo kelias"><ol class="crumbs" role="list">
          <li><a href="/">Pradžia</a></li>
          {crumbs.map((c) => <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
        </ol></nav>
      )}
      {kicker && <p class="kicker">{kicker}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
      {actions && (
        <div class="btn-row phero__btns">
          <a class="btn btn--primary" href={site.telefonasHref} data-loc="page-hero-call"><span class="btn__num">{site.telefonas}</span></a>
          <button type="button" class="btn btn--line" data-quote data-service={service}>Gauti kainą</button>
        </div>
      )}
    </div>
    {photo && (
      <div class="phero__ph ph cut"><Photo name={photo} alt={photoAlt} sizes="(max-width: 860px) 100vw, 40vw" widths={[480, 800, 1200]} loading="eager" fetchpriority="high" position={photoPos} /></div>
    )}
  </div>
</section>
<style>
  .phero { background: var(--spruce-100); color: var(--ink); }
  .phero__in { display: grid; gap: 40px; padding-block: clamp(36px, 5vw, 72px) clamp(44px, 6vw, 84px); }
  .phero--photo .phero__in { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); align-items: center; }
  .phero__txt { display: grid; gap: 18px; align-content: center; }
  .phero h1 { max-width: 18ch; color: var(--spruce-900); }
  .phero__btns { margin-top: 8px; }
  .phero__ph { aspect-ratio: 4 / 5; max-height: 560px; width: 100%; justify-self: end; }
  .phero__ph :global(img) { position: absolute; inset: 0; }
  @media (max-width: 860px) {
    .phero--photo .phero__in { grid-template-columns: 1fr; gap: 28px; }
    .phero__ph { aspect-ratio: 5 / 4; max-height: none; }
    .phero__btns .btn { flex: 1 1 100%; }
  }
</style>
