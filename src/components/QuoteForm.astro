---
/* Užklausos forma. Gamyboje siunčia į JarvisWeb Cloudflare Worker /t/form (kind=site_inquiry, site=arbcut):
   jis išsaugo užklausą ir el. paštu praneša gavėjams (tik el. paštas; siuntimas į telefoną — vėliau, „Offer 2“).
   Apsauga: slaptas laukas „website“ ir Workerio limitai; Turnstile tik jei nustatytas PUBLIC_TURNSTILE_SITE_KEY.
   Laukų vardai yra Workerio kontraktas, jų nekeisti. Peržiūroje (PREVIEW) forma inertiška: niekur nesiunčia.
   variant="short" — be paslaugų sąrašo (pradžios puslapio kortelė); variant="chat" — tie patys laukai kaip short,
   pažymėta „Klausimas iš svetainės“ (pokalbių langas). Klasės qf__f--tel/name/msg/addr — maketui (Hero.astro). */
import { site, PREVIEW } from '@data/site.js';
import { paslaugos } from '@data/paslaugos.js';
const { id = 'quote-form', prefix = 'q', service = '', variant = 'full', submit } = Astro.props;
const chat = variant === 'chat';
const short = variant === 'short' || chat;
const mailHref = `mailto:${site.elPastas}?subject=${encodeURIComponent('Nuotraukos kainai')}`;
---
<form
  class:list={['qf', { 'qf--short': short, 'qf--chat': chat }]}
  id={id}
  data-loc={id}
  method="POST"
  action={PREVIEW ? '#perziura' : site.formEndpoint}
  data-preview={PREVIEW ? '1' : undefined}
  novalidate
>
  {!PREVIEW && (
    <>
      <input type="hidden" name="kind" value="site_inquiry" />
      <input type="hidden" name="site" value={site.formSite} />
      {chat && <input type="hidden" name="service" value="Klausimas iš svetainės" />}
      <input type="text" name="website" class="sr-only" tabindex="-1" autocomplete="off" aria-hidden="true" />
    </>
  )}
  <div class="qf__row">
    <div class="qf__f qf__f--tel">
      <label for={`${prefix}-tel`}>{short ? 'Jūsų telefonas' : 'Telefonas'} <span aria-hidden="true">*</span></label>
      <input id={`${prefix}-tel`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="(?:[^0-9]*[0-9]){8,}[^0-9]*" placeholder="+370 6__ _____" />
    </div>
    <div class="qf__f qf__f--name">
      <label for={`${prefix}-name`}>Vardas</label>
      <input id={`${prefix}-name`} name="name" type="text" maxlength="80" autocomplete="name" placeholder="Jūsų vardas" />
    </div>
  </div>
  {!short && (
    <div class="qf__f">
      <label for={`${prefix}-svc`}>Paslauga</label>
      <select id={`${prefix}-svc`} name="service" data-service-select>
        <option value="">Dar nežinau / kita</option>
        {paslaugos.map((p) => <option value={p.pavadinimas} data-slug={p.slug} selected={p.slug === service}>{p.pavadinimas}</option>)}
      </select>
    </div>
  )}
  <div class="qf__f qf__f--msg">
    <label for={`${prefix}-msg`}>{chat ? 'Jūsų klausimas arba darbas' : 'Kokio darbo reikia?'} <span aria-hidden="true">*</span></label>
    <textarea id={`${prefix}-msg`} name="message" rows={short ? 3 : 4} required maxlength="1800" placeholder={chat ? 'Pvz.: ar galėtumėte atvažiuoti šią savaitę?' : 'Pvz.: nupjauti medį, išvalyti latakus, sumontuoti iškabą'}></textarea>
  </div>
  <div class="qf__f qf__f--addr">
    <label for={`${prefix}-city`}>Adresas arba vietovė</label>
    <div class="qf__addr">
      <input id={`${prefix}-city`} name="location" type="text" maxlength="120" autocomplete="street-address" placeholder="Pvz.: Garliava" list={`${prefix}-city-list`} data-addr />
      <button type="button" class="qf__loc" data-locate aria-label="Nustatyti mano vietą" hidden><img src="/assets/v5-brand/raster/icons/ui-pin-160.png" alt="" width="22" height="22" /><span>Mano vieta</span></button>
    </div>
    <datalist id={`${prefix}-city-list`}></datalist>
    <p class="qf__locmsg" data-locate-msg role="status" hidden></p>
  </div>
  {site.features.photoUpload && (
    <div class="qf__f qf__files" data-files>
      <input id={`${prefix}-files`} class="sr-only" type="file" name="files" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple data-files-input aria-describedby={`${prefix}-files-hint`} />
      <label class="qf__pick" for={`${prefix}-files`}><img src="/assets/v5-brand/raster/icons/step-foto-160.png" alt="" width="24" height="24" loading="lazy" /><span>Pridėti nuotraukas</span> <small>nebūtina</small></label>
      <p class="qf__hint" id={`${prefix}-files-hint`}>Iki 5 nuotraukų: visa darbo vieta, kas šalia ir kelias iki jos.</p>
      <ul class="qf__thumbs" role="list" data-files-list hidden></ul>
      <p class="qf__filemsg" data-files-msg role="status" hidden></p>
    </div>
  )}
  {!short && <p class="qf__note">Nuotraukas galite atsiųsti ir el. paštu <a href={mailHref}>{site.elPastas}</a>. Pagal jas kainą pasakome tiksliau.</p>}
  {!PREVIEW && site.turnstileSiteKey && <div class="qf__ts" data-turnstile data-sitekey={site.turnstileSiteKey}></div>}
  <p class="qf__err" role="alert" hidden>{chat ? 'Įrašykite telefoną ir klausimą.' : 'Įrašykite telefoną ir trumpai aprašykite darbą.'}</p>
  <p class="qf__err" data-send-err role="alert" hidden>Nepavyko išsiųsti. Bandykite dar kartą arba skambinkite <a href={site.telefonasHref}>{site.telefonas}</a>.</p>
  <noscript><p class="qf__note">Forma veikia tik su „JavaScript“. Skambinkite <a href={site.telefonasHref}>{site.telefonas}</a>.</p></noscript>
  <div class="qf__foot">
    <button type="submit" class="btn btn--primary qf__btn">{submit || (chat ? 'Siųsti Mantui' : 'Gauti preliminarią kainą')}</button>
    {!short && <span class="qf__req"><span aria-hidden="true">*</span> privalomi laukai</span>}
  </div>
  <div class="qf__done" role="status" hidden tabindex="-1">
    <p class="qf__done-h">{PREVIEW ? 'Ačiū, užklausa paruošta.' : 'Ačiū, užklausą gavome.'}</p>
    {PREVIEW
      ? <p>Tai peržiūros versija: užklausa <strong>niekur neišsiųsta</strong>. Paleidus svetainę ji keliaus Mantui el. paštu.</p>
      : <p>Susisieksime darbo valandomis. Skubiai skambinkite <a href={site.telefonasHref}>{site.telefonas}</a>.</p>}
  </div>
</form>

<style>
  .qf { display: grid; gap: 16px; }
  .qf__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .qf__f { display: grid; gap: 6px; }
  .qf label { font-size: 1rem; font-weight: 700; color: var(--ink); }
  .qf label span { color: var(--orange-ink); }
  .qf input, .qf select, .qf textarea {
    width: 100%; min-height: 54px; padding: 12px 14px; background: #fff; color: var(--ink); font-size: 1.1rem;
    border: 2px solid #A9B3AD; border-radius: var(--radius);
    transition: border-color var(--t), box-shadow var(--t);
  }
  .qf textarea { resize: vertical; min-height: 110px; }
  .qf--short textarea { min-height: 76px; }
  .qf input::placeholder, .qf textarea::placeholder { color: #6A746E; }
  .qf input:focus, .qf select:focus, .qf textarea:focus { outline: none; border-color: var(--spruce-900); box-shadow: 0 0 0 3px var(--orange); }
  .qf [aria-invalid='true'] { border-color: #B3261E; }
  .qf__note { font-size: 1rem; color: var(--ink-2); }
  .qf__note a { color: var(--spruce-900); font-weight: 700; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .qf__addr { display: flex; gap: 8px; align-items: stretch; }
  .qf__addr input { flex: 1 1 auto; min-width: 0; }
  .qf__loc { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 6px; padding-inline: 12px; border: 2px solid var(--spruce-900); border-radius: var(--radius); background: #fff; color: var(--spruce-900); font-weight: 800; font-size: .95rem; white-space: nowrap; transition: background var(--t); }
  .qf__loc:hover { background: var(--spruce-100); }
  .qf__loc[aria-busy='true'] { opacity: .6; cursor: progress; }
  .qf__loc img { width: 22px; height: 22px; }
  .qf__locmsg { font-size: .95rem; color: var(--ink-2); }
  .qf__files { gap: 8px; position: relative; }
  .qf__files input[type='file'] { width: 1px; min-height: 0; padding: 0; border: 0; }
  .qf__pick { display: flex; align-items: center; gap: 10px; min-height: 54px; padding: 10px 14px; border: 2px dashed #A9B3AD; border-radius: var(--radius); background: #fff; font-weight: 800; color: var(--spruce-900); cursor: pointer; transition: border-color var(--t), background var(--t); }
  .qf__pick:hover { border-color: var(--spruce-900); background: var(--spruce-50); }
  .qf__pick img { width: 24px; height: 24px; flex: 0 0 auto; }
  .qf__pick small { margin-left: auto; font-weight: 600; font-size: .9rem; color: var(--ink-2); }
  .qf__files input:focus-visible + .qf__pick { border-color: var(--spruce-900); box-shadow: 0 0 0 3px var(--orange); }
  .qf__hint { font-size: .95rem; color: var(--ink-2); }
  .qf__thumbs { display: flex; flex-wrap: wrap; gap: 8px; }
  .qf__thumbs[hidden] { display: none; }
  .qf__thumbs :global(li) { position: relative; width: 68px; height: 68px; border-radius: 10px; overflow: hidden; background: var(--spruce-100); display: grid; place-items: center; }
  .qf__thumbs :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .qf__thumbs :global(.qf__fn) { padding: 4px; font-size: .7rem; line-height: 1.15; color: var(--ink-2); overflow-wrap: anywhere; text-align: center; }
  .qf__thumbs :global(button) { position: absolute; top: 2px; right: 2px; width: 26px; height: 26px; border-radius: 50%; background: rgba(15, 46, 35, .85); color: #fff; font-weight: 800; line-height: 1; display: grid; place-items: center; }
  .qf__filemsg { font-size: .95rem; font-weight: 700; color: #B3261E; }
  .qf__err { color: #B3261E; font-weight: 700; }
  .qf__foot { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .qf--short .qf__btn { width: 100%; }
  .qf__req { font-size: .95rem; color: var(--ink-2); }
  .qf__done { padding: 18px 20px; background: var(--spruce-100); display: grid; gap: 6px; }
  .qf__done:focus-visible { outline-offset: 0; }
  .qf__done-h { font-family: var(--display); font-size: 1.35rem; font-weight: 800; color: var(--spruce-900); }
  .qf.is-done > :not(.qf__done) { display: none; }
  .qf__err a { color: inherit; text-decoration: underline; white-space: nowrap; }
  .qf__ts { overflow: hidden; }
  .qf__ts:empty { display: none; }
  .qf.is-submitting .qf__btn { opacity: .65; cursor: progress; }
  .qf.is-submitting .qf__pick { opacity: .55; pointer-events: none; }
  .qf__thumbs :global(button:disabled) { opacity: .4; }
  @media (max-width: 560px) { .qf__row { grid-template-columns: 1fr; } }
</style>
