---
/* Logotipas v5 (public/assets/v5-brand/logo/, vektorinis, žr. .agents/research/v5-logo/PROCESS.md).
   Gamyboje rodomas OPTION. Peržiūroje (PREVIEW) į puslapį įdedami visi trys variantai,
   o rodomas tas, kurį nurodo ?logo=1|2|3 (html[data-logo]) — kad vartotojas pamatytų juos tikroje antraštėje. */
import { PREVIEW } from '@data/site.js';
const OPTION = 1;
const NAMES = { 1: 'a-egle', 2: 'aukstalipys', 3: 'pjuvis' };
/* viewBox pločio/aukščio santykiai iš lockup-*.svg ir mark-*.svg */
const RATIO = { 1: 2.922, 2: 2.989, 3: 2.823 };
const MRATIO = { 1: 0.588, 2: 0.702, 3: 0.493 };
const { tone = 'dark', height = 56, mark = false, class: cls } = Astro.props;
const B = '/assets/v5-brand/logo';
const opts = PREVIEW ? [1, 2, 3] : [OPTION];
const src = (o) => mark
  ? `${B}/mark-${NAMES[o]}${tone === 'light' ? '-white' : ''}.svg`
  : `${B}/lockup-${NAMES[o]}-${tone === 'light' ? 'dark' : 'light'}.svg`;
---
{opts.map((o) => (
  <img
    class:list={['logo', cls, PREVIEW && `logo--opt logo--o${o}`]}
    src={src(o)}
    alt="ArbCut"
    width={Math.round(height * (mark ? MRATIO[o] : RATIO[o]))}
    height={height}
    decoding="async"
  />
))}
<style is:global>
  html:not([data-logo]) .logo--opt:not(.logo--o1),
  html[data-logo='1'] .logo--opt:not(.logo--o1),
  html[data-logo='2'] .logo--opt:not(.logo--o2),
  html[data-logo='3'] .logo--opt:not(.logo--o3) { display: none !important; }
</style>
