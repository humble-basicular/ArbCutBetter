---
/* Logotipas: skydo ženklas + „ArbCut“ žodinis ženklas.
   tone="dark" — tamsus ant šviesaus; tone="light" — šviesus ant tamsaus.
   mark — tik skydo ženklas (labai siauriems ekranams). */
const { tone = 'dark', height = 44, mark = false, class: cls } = Astro.props;
const B = '/assets/arbcut-upgrade-brand';
const src = `${B}/logo-horizontal-${tone}-740.webp`;
const w = Math.round(height * 1401 / 352);
---
{mark
  ? <img class:list={['logo', cls]} src={`${B}/mark-light-96.png`} alt="ArbCut" width={Math.round(height * 96 / 111)} height={height} decoding="async" />
  : <img class:list={['logo', cls]} src={src} alt="ArbCut" width={w} height={height} decoding="async" />}
