---
/* Vienas užklausos dialogas visai svetainei. Bet koks [data-quote] jį atidaro;
   data-service="<slug>" iš anksto parenka paslaugą. */
import { site } from '@data/site.js';
import QuoteForm from './QuoteForm.astro';
---
<dialog class="qd" id="quote-dialog" aria-labelledby="qd-title">
  <div class="qd__in cut">
    <div class="qd__head">
      <h2 id="qd-title">Gauti kainą</h2>
      <button type="button" class="qd__x" data-quote-close >Uždaryti</button>
    </div>
    <p class="qd__alt">Greičiausia paskambinti: <a href={site.telefonasHref} data-loc="dialog-call">{site.telefonas}</a></p>
    <QuoteForm id="dialog-form" prefix="d" />
  </div>
</dialog>

<style>
  .qd { width: min(680px, calc(100vw - 20px)); max-height: calc(100dvh - 20px); padding: 0; border: 0; background: transparent; color: var(--ink); overflow: visible; }
  .qd::backdrop { background: rgba(15, 42, 32, .78); }
  .qd__in { background: var(--paper); padding: clamp(20px, 4vw, 36px); display: grid; gap: 14px; max-height: calc(100dvh - 20px); overflow-y: auto; }
  .qd__head { display: flex; justify-content: space-between; gap: 16px; align-items: center; padding-right: 12px; }
  .qd__head h2 { font-size: clamp(1.8rem, 1.5rem + 1.2vw, 2.5rem); color: var(--spruce-900); }
  .qd__x { min-height: 44px; padding: 8px 14px; flex: 0 0 auto; font-weight: 700; border: 2px solid var(--spruce-900); border-radius: var(--radius); }
  .qd__x:hover { background: var(--spruce-900); color: #fff; }
  .qd__alt { color: var(--ink-2); font-size: 1.1rem; }
  .qd__alt a { color: var(--spruce-900); font-stretch: var(--wide); font-weight: 800; font-size: 1.3rem; white-space: nowrap; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 4px; }
</style>
