---
/* „15 metų patirtis“ (patirtisMetai, Paslaugos.lt profilio duomuo). Aiškus, įskaitomas ženklas: auksinis diskas su skaičiumi + žodžiai šalia. */
import { patirtisMetai } from '@data/atsiliepimai.js';
const { class: cls } = Astro.props;
---
<p class:list={['seal', cls]}>
  <span class="sr-only">{patirtisMetai} metų patirtis</span>
  <span class="seal__disc" aria-hidden="true"><span data-count={patirtisMetai}>{patirtisMetai}</span></span>
  <span class="seal__t" aria-hidden="true"><b>metų</b> patirtis</span>
</p>
<style>
  .seal { display: inline-flex; align-items: center; gap: 12px; }
  .seal__disc { width: 62px; height: 62px; border-radius: 50%; display: grid; place-items: center; background: var(--gold); box-shadow: 0 0 0 4px rgba(255,255,255,.9), 0 8px 18px rgba(0,0,0,.25); font-family: var(--display); font-weight: 800; font-size: 1.9rem; line-height: 1; letter-spacing: -.03em; color: var(--spruce-950); }
  .seal__t { display: grid; line-height: 1.1; font-weight: 650; color: var(--on-dark-2); font-size: .95rem; }
  .seal__t b { font-family: var(--display); font-weight: 800; font-size: 1.35rem; color: #fff; }
</style>
