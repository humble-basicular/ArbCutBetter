---
/* Oficialus įvertinimo vienetas: Paslaugos.lt ženklas + auksinės žvaigždės + 5,0 + atsiliepimų skaičius.
   Skaičiai tik iš src/data/atsiliepimai.js. variant: chip | card | dock */
import { site } from '@data/site.js';
import { atsiliepimuKiekis, atsiliepimuVidurkis } from '@data/atsiliepimai.js';
import Mark from '../Mark.astro';
import Stars from './Stars.astro';
const { variant = 'card', dark = false, loc, class: cls } = Astro.props;
const rating = atsiliepimuVidurkis.toFixed(1).replace('.', ',');
---
<a class:list={['ru', `ru--${variant}`, { 'ru--dark': dark }, cls]} href={site.atsiliepimai.profilis} target="_blank" rel="noopener" data-loc={loc}>
  {variant === 'chip' ? (
    <>
      <Stars size={15} />
      <span class="ru__n">{rating}</span>
      <span class="ru__c">{atsiliepimuKiekis} atsiliepimai <span class="ru__src">Paslaugos.lt</span></span>
    </>
  ) : (
    <>
      <span class="ru__mark"><Mark name="paslaugos" height={variant === 'dock' ? 30 : 34} label="Paslaugos.lt" /></span>
      <span class="ru__body">
        <span class="ru__top"><span class="ru__n">{rating}</span><Stars size={variant === 'dock' ? 18 : 20} /></span>
        <span class="ru__c">{atsiliepimuKiekis} atsiliepimai</span>
      </span>
    </>
  )}
  <span class="sr-only"> (atsidaro naujame lange)</span>
</a>
<style>
  .ru { display: inline-flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; }
  .ru__n { font-family: var(--display); font-weight: 800; font-variation-settings: 'opsz' 48, 'wdth' 90; line-height: 1; letter-spacing: -.02em; }
  .ru__c { font-weight: 650; color: var(--ink-2); line-height: 1.2; }
  .ru--chip { gap: 8px; font-size: .92rem; color: #fff; }
  .ru--chip .ru__n { font-size: 1.05rem; }
  .ru--chip .ru__c { color: var(--on-dark-2); font-weight: 600; }
  .ru--chip .ru__src { color: #fff; font-weight: 700; }
  .ru--chip:hover .ru__src { text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 3px; }
  .ru--card, .ru--dock { background: #fff; border-radius: var(--r); padding: 12px 18px 12px 14px; box-shadow: var(--sh-2); transition: transform var(--t), box-shadow var(--t); }
  .ru--card:hover, .ru--dock:hover { transform: translateY(-2px); }
  .ru__mark { display: flex; align-items: center; padding-right: 12px; border-right: 1px solid var(--line); }
  .ru__body { display: grid; gap: 3px; }
  .ru__top { display: flex; align-items: center; gap: 8px; }
  .ru--card .ru__n { font-size: 1.7rem; }
  .ru--dock .ru__n { font-size: 1.4rem; }
  .ru--card .ru__c, .ru--dock .ru__c { font-size: .95rem; }
</style>
