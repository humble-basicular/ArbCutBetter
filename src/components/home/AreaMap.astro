---
/* v5 aptarnavimo zona (14 žingsnių: 13): tikras žemėlapis (MapLibre + OpenFreeMap, nemokamai, be rakto),
   įkeliamas pats priartėjus prie ekrano. Zona nubrėžta aplink realius aptarnaujamus miestus (be išgalvoto spindulio),
   Šiauliai ir Klaipėda pažymėti „per toli“. Statinis firminis paveikslėlis — kol kraunasi ir be JS / WebGL.
   Miestų nuorodos šalia — paprastos <a> (indeksuojamos). */
import { vietoves } from '@data/vietoves.js';
import pts from '@data/map-points.json';
import pos from '@data/map-fallback-pos.json';
const I = '/assets/v5-brand/raster/icons';
const data = {
  lt: '/assets/v5-brand/map/lt.json', zone: '/assets/v5-brand/map/zone.json', mark: '/assets/v5-brand/logo/mark-a-egle-white.svg',
  towns: vietoves.map((v) => ({ name: v.miestas, href: `/${v.slug}`, base: !!v.pagrindinis, ll: pts.towns[v.miestas] })),
  far: Object.entries(pts.far).map(([name, ll]) => ({ name, ll })),
};
---
<section class="area" id="vietoves" aria-labelledby="area-h">
  <div class="wrap area__grid">
    <div class="area__txt">
      <p class="kick">Aptarnavimo zona</p>
      <h2 id="area-h">Kur važiuojame</h2>
      <p class="lead">Bazė Kaune. Dirbame Kaune, Kauno rajone ir miestuose žemiau. Į tolimesnius miestus važiuojame suderinę datą iš anksto, kelių kaimynų darbus galima atlikti per vieną atvykimą.</p>
      <ul role="list" class="area__list">
        {vietoves.map((v, i) => (
          <li class:list={['rv', { 'is-base': v.pagrindinis }]} style={`--i:${i}`}>
            <a href={`/${v.slug}`}>
              <img class="area__pin" src={`${I}/ui-pin-160.png`} alt="" width="30" height="30" loading="lazy" />
              <span><span class="area__city">{v.miestas}</span>
              <span class="area__sub">{v.pagrindinis ? 'Bazė, išvežame medieną' : `Medžių pjovimas ${v.kur}`}</span></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="area__note"><strong>Šakų ir medienos išvežimas fiskaru tik Kaune ir Kauno rajone.</strong> Kitur medį supjauname, o šakas ir medieną sukrauname tvarkingomis krūvomis.</p>
      <p class="area__far"><span class="area__far-dot" aria-hidden="true"></span>Šiauliai, Klaipėda ir panašus atstumas nuo Kauno: per toli, ten nevažiuojame.</p>
    </div>

    <div class="area__map">
      <div class="area__frame" data-area-map>
        <img class="area__static" src="/assets/v5-brand/map/fallback.webp" alt="ArbCut aptarnavimo zonos žemėlapis: Kaunas ir aplinkiniai miestai, Šiauliai ir Klaipėda už zonos ribų" width="1200" height="900" loading="lazy" />
        <div class="area__labels" aria-hidden="true">
          {Object.entries(pos).map(([n, [x, y]]) => <span class:list={['flab', { 'flab--far': n in pts.far, 'flab--base': n === 'Kaunas' }]} style={`left:${x}%;top:${y}%`}>{n}{n in pts.far && <small>per toli</small>}</span>)}
        </div>
        <div class="area__canvas" data-map-canvas></div>
        <script type="application/json" set:html={JSON.stringify(data)} />
      </div>
      <p class="area__legend"><span class="lg lg--zone"></span>Aptarnavimo zona <span class="lg lg--base"></span>Bazė Kaune <span class="lg lg--far"></span>Per toli</p>
    </div>
  </div>
</section>

<script>
  const box = document.querySelector('[data-area-map]');
  if (box) {
    const go = () => import('../../scripts/area-map.js').then((m) => m.mount(box)).catch(() => box.classList.add('map--static'));
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((ents) => { if (ents.some((e) => e.isIntersecting)) { io.disconnect(); go(); } }, { rootMargin: '600px 0px' });
      io.observe(box);
    } else go();
  }
</script>

<style>
  .area { background: var(--paper); padding-block: clamp(72px, 8vw, 128px); }
  .area__grid { display: grid; grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .area__txt { display: grid; gap: 16px; }
  .area h2 { color: var(--spruce-900); }
  .area__list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 14px; margin-top: 8px; }
  .area__list a { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 12px; background: var(--spruce-50); border: 1px solid transparent; transition: border-color var(--t), background var(--t), transform var(--t); }
  .area__list a:hover { border-color: var(--orange); background: #fff; transform: translateX(3px); }
  .area__pin { width: 30px; height: 30px; flex: 0 0 auto; }
  .area__city { display: block; font-family: var(--display); font-weight: 800; font-size: 1.2rem; color: var(--spruce-900); line-height: 1.1; }
  .area__sub { font-size: .9rem; color: var(--ink-2); }
  .is-base { grid-column: 1 / -1; }
  .is-base a { background: var(--spruce-900); }
  .is-base .area__city { color: #fff; font-size: 1.45rem; }
  .is-base .area__sub { color: var(--gold); font-weight: 700; }
  .is-base a:hover { background: var(--spruce-700); }
  .area__note { background: #FFF4EC; border-left: 5px solid var(--orange); padding: 14px 16px; border-radius: 0 10px 10px 0; color: var(--ink-2); }
  .area__note strong { color: var(--spruce-900); }
  .area__far { display: flex; align-items: center; gap: 10px; font-weight: 650; color: var(--ink-2); }
  .area__far-dot { width: 14px; height: 14px; border-radius: 50%; background: #9AA8A1; border: 3px solid #fff; box-shadow: 0 0 0 1px #9AA8A1; }

  .area__map { position: relative; }
  .area__map::before { content: ''; position: absolute; inset: 22px -18px -18px 22px; background: var(--orange); border-radius: var(--r-lg); }
  .area__frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-lg); overflow: hidden; border: 6px solid #fff; box-shadow: var(--sh-3); background: #DCE7E0; }
  .area__static { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .area__labels { position: absolute; inset: 0; }
  .flab { position: absolute; transform: translate(10px, -50%); font-weight: 800; font-size: .82rem; color: var(--spruce-900); white-space: nowrap; text-shadow: 0 0 3px #fff, 0 0 3px #fff; }
  .flab small { display: block; font-weight: 700; color: #6F7E77; font-size: .72rem; }
  .flab--base { font-size: 1rem; transform: translate(14px, -50%); }
  .area__canvas { position: absolute; inset: 0; opacity: 0; transition: opacity .5s ease; }
  :global(.map--live) .area__canvas { opacity: 1; }
  :global(.map--live) .area__labels { display: none; }
  .area__legend { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 6px 16px; margin-top: 28px; font-size: .9rem; color: var(--ink-2); font-weight: 600; }
  .lg { display: inline-block; width: 16px; height: 16px; border-radius: 4px; margin-right: -8px; }
  .lg--zone { background: rgba(226, 97, 27, .2); border: 2px dashed var(--orange); }
  .lg--base { background: var(--spruce-900); border-radius: 50%; }
  .lg--far { background: #9AA8A1; border-radius: 50%; }

  /* MapLibre žymekliai (kuriami JS) */
  :global(.mpin) { text-decoration: none; cursor: pointer; }
  :global(.mpin__in) { position: relative; display: flex; flex-direction: column; align-items: center; gap: 2px; }
  :global(.mpin__dot) { width: 16px; height: 16px; border-radius: 50%; background: var(--orange); border: 3px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.3); transition: transform .16s ease; }
  :global(.mpin:hover .mpin__dot) { transform: scale(1.25); }
  :global(.mpin__l) { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); font: 800 13px/1.1 var(--font); color: var(--spruce-900); white-space: nowrap; text-shadow: 0 0 3px #fff, 0 0 3px #fff, 0 0 3px #fff; pointer-events: none; }
  :global(.mpin__l small) { display: block; font-weight: 700; font-size: 11px; color: #6F7E77; }
  :global(.mpin--base img) { width: 26px; height: auto; background: var(--spruce-900); padding: 6px 5px; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,.3); }
  :global(.mpin--base .mpin__dot) { background: var(--spruce-900); width: 14px; height: 14px; }
  :global(.mpin--base .mpin__l) { top: 4px; transform: none; left: 34px; font-size: 15px; }
  :global(.mpin--base .mpin__l small) { color: var(--orange-ink); }
  :global(.mpin--far .mpin__dot) { background: #9AA8A1; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.mpin__in) { animation: pindrop .4s cubic-bezier(.34, 1.56, .64, 1) both; }
    @keyframes pindrop { from { opacity: 0; transform: translateY(-14px); } to { opacity: 1; transform: none; } }
  }
  @media (max-width: 960px) { .area__grid { grid-template-columns: 1fr; } .area__map::before { inset: 14px -8px -10px 14px; } }
  @media (max-width: 480px) { .area__list { grid-template-columns: 1fr; } }
</style>
