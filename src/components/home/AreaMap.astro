---
/* Aptarnavimo zona: 9 miestai (nuorodos į vietovių puslapius) + schema pagal tikras koordinates.
   Google žemėlapis įkeliamas tik paspaudus (privatumas, jokių užklausų iš anksto). */
import { vietoves } from '@data/vietoves.js';
/* Apytikslės miestų centrų koordinatės (lat, lng) */
const geo = {
  Kaunas: [54.897, 23.886], Vilnius: [54.687, 25.28], 'Panevėžys': [55.734, 24.357], 'Marijampolė': [54.559, 23.354],
  Alytus: [54.396, 24.046], Jonava: [55.083, 24.279], 'Kėdainiai': [55.288, 23.974], 'Kazlų Rūda': [54.749, 23.49], 'Tauragė': [55.252, 22.29],
};
const L0 = 20.9, T0 = 56.5, KX = 64, KY = 111;
const pt = ([lat, lng]) => [Math.round((lng - L0) * KX), Math.round((T0 - lat) * KY)];
const K = pt(geo.Kaunas);
const px = ([x, y]) => `left:${(x / 400 * 100).toFixed(2)}%;top:${(y / 300 * 100).toFixed(2)}%`;
const lab = { Jonava: 'r', 'Kėdainiai': 'r', 'Kazlų Rūda': 'l', 'Marijampolė': 'l', Alytus: 'r', Kaunas: 'l', Vilnius: 'r', 'Panevėžys': 'r', 'Tauragė': 'r' };
const q = encodeURIComponent('Kaunas, Lietuva');
---
<section class="area" id="vietoves" aria-labelledby="area-h">
  <div class="wrap area__grid">
    <div class="area__txt">
      <h2 id="area-h">Kur važiuojame</h2>
      <p class="lead">Bazė Kaune. Dirbame Kaune, Kauno rajone ir iki 200 km aplink. Į tolimesnius miestus važiuojame suderinę datą iš anksto, kelių kaimynų darbus galima atlikti per vieną atvykimą.</p>
      <ul role="list" class="area__list">
        {vietoves.map((v) => (
          <li class:list={{ 'is-base': v.pagrindinis }}>
            <a href={`/${v.slug}`}>
              <span class="area__city">{v.miestas}</span>
              <span class="area__sub">{v.pagrindinis ? 'Bazė, išvežame medieną' : `Medžių pjovimas ${v.kur}`}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="area__note"><strong>Šakų ir medienos išvežimas fiskaru tik Kaune ir Kauno rajone.</strong> Kitur medį supjauname, o šakas ir medieną sukrauname tvarkingomis krūvomis.</p>
    </div>

    <div class="area__map">
      <div class="area__frame cut" data-map>
        <div class="area__plot" aria-hidden="true">
          <span class="ring" style={`${px(K)};--d:100%`}></span>
          <span class="ring ring--in" style={`${px(K)};--d:50%`}></span>
          <span class="ring-l" style={`left:${((K[0] - 58) / 4).toFixed(2)}%;top:${((K[1] - 103) / 3).toFixed(2)}%`}>100 km</span>
          {vietoves.map((v) => {
            const p = pt(geo[v.miestas]);
            const r = lab[v.miestas] === 'r';
            return <span class:list={['town', r ? 'town--r' : 'town--l', { 'town--base': v.pagrindinis }]} style={px(p)}><i></i><b>{v.miestas}</b></span>;
          })}
        </div>
        <div class="area__load">
          <button type="button" class="btn btn--primary btn--sm" data-map-load data-src={`https://www.google.com/maps?q=${q}&z=8&output=embed`}>Rodyti Google žemėlapyje</button>
          <p>Žemėlapis įkeliamas tik paspaudus.</p>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .area { background: var(--paper); padding-block: var(--sec); }
  .area__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .area__txt { display: grid; gap: 22px; }
  .area h2 { color: var(--spruce-900); }
  .area__list { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  .area__list a { display: grid; gap: 0; padding: 12px 0; box-shadow: inset 0 -1px 0 var(--line); min-height: 60px; align-content: center; }
  .area__list .is-base { grid-column: 1 / -1; }
  .area__list .is-base a { background: var(--spruce-100); padding: 16px 18px; box-shadow: none; margin-bottom: 8px; }
  .area__city { font-stretch: var(--wide); font-weight: 800; font-size: 1.3rem; line-height: 1.15; color: var(--spruce-900); text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 4px; transition: text-decoration-color var(--t); }
  .area__list a:hover .area__city { text-decoration-color: var(--orange); }
  .is-base .area__city { font-size: 1.8rem; }
  .area__sub { font-size: .96rem; color: var(--ink-2); }
  .area__note { padding: 2px 0 2px 18px; box-shadow: inset 4px 0 0 var(--spruce-700); color: var(--ink-2); }
  .area__note strong { color: var(--ink); }

  .area__frame { position: relative; aspect-ratio: 4 / 3; background: var(--spruce-100); overflow: hidden; }
  .area__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .area__plot { position: absolute; inset: 0; }
  .area__plot > * { position: absolute; }
  .ring { width: var(--d); aspect-ratio: 1; transform: translate(-50%, -50%); border-radius: 50%; border: 1.5px dashed var(--spruce-700); background: rgba(27, 70, 52, .05); }
  .ring-l { font-size: .8rem; font-weight: 700; color: var(--spruce-700); }
  .town { display: flex; align-items: center; gap: 7px; transform: translate(-5px, -50%); white-space: nowrap; }
  .town i { width: 10px; height: 10px; flex: 0 0 auto; background: var(--spruce-900); border-radius: 50%; }
  .town b { font-size: .86rem; font-weight: 700; color: var(--spruce-900); }
  .town--l { flex-direction: row-reverse; transform: translate(calc(-100% + 5px), -50%); }
  .town--base i { width: 16px; height: 16px; background: var(--paper); border: 4px solid var(--spruce-900); }
  .town--base b { font-stretch: var(--wide); font-weight: 800; font-size: 1.05rem; }
  .town--base { transform: translate(calc(-100% + 8px), -50%); }
  .area__load { position: absolute; left: 16px; bottom: 16px; right: 16px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .area__load p { font-size: .94rem; color: var(--ink-2); }
  @media (max-width: 960px) { .area__grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) {
    .area__list li:not(.is-base) .area__sub { display: none; }
    .area__city { font-size: 1.15rem; }
    .is-base .area__city { font-size: 1.5rem; }
    .area__frame { aspect-ratio: 4 / 5; }
    .area__plot { inset: 0 0 auto 0; aspect-ratio: 1 / 1; overflow: hidden; }
    .area__plot > :global(*) { transform-origin: center; }
    .town b { font-size: .74rem; }
    .area__load { left: 10px; right: 10px; bottom: 10px; }
  }
</style>
