---
/* Nuotraukos → kaina. Manto žodžiai iš Valstietis.lt; kainodara iš Paslaugos.lt profilio. */
import { site } from '@data/site.js';
import { valstietis } from '@data/spauda.js';
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
const subj = encodeURIComponent('Medžio nuotraukos kainai');
---
<section class="snd" id="nuotraukos" aria-labelledby="snd-h">
  <div class="wrap snd__grid">
    <div class="snd__txt">
      <h2 id="snd-h">Atsiųskite nuotraukas. Pasakysime kainą.</h2>
      <figure class="snd__q">
        <blockquote><p>„{valstietis.citatos.kava}“</p></blockquote>
        <figcaption>Mantas Gerulis, <a href={valstietis.url} target="_blank" rel="noopener">Valstietis.lt</a></figcaption>
      </figure>
      <p class="snd__p">Todėl preliminarią kainą pasakome pagal jūsų nuotraukas, o tikslią atvažiavę į vietą. Kainą lemia daugiau nei medžio dydis:</p>
      <blockquote class="snd__q2"><p>„{valstietis.citatos.sudetingumas}“</p></blockquote>

      <div class="snd__what">
        <h3>Ką nufotografuoti</h3>
        <ul class="ticks">
          <li>Visą medį iš toliau, kad matytųsi viršūnė.</li>
          <li>Kas po medžiu ir šalia: namas, tvora, laidai, gatvė.</li>
          <li>Kamieną prie žemės.</li>
          <li>Kelią iki medžio: ar privažiuos autobokštelis.</li>
        </ul>
      </div>

      <div class="snd__act">
        <a class="btn btn--primary snd__big" href={site.smsHref} data-loc="photos-sms"><Icon name="sms" size={24} /> Siųsti SMS {site.telefonas}</a>
        <a class="btn btn--line" href={`mailto:${site.elPastas}?subject=${subj}`} data-loc="photos-mail"><Icon name="mail" size={22} /> El. paštu</a>
      </div>
      <p class="snd__mail">El. paštas: <a href={`mailto:${site.elPastas}?subject=${subj}`}>{site.elPastas}</a></p>
    </div>

    <figure class="snd__ph">
      <div class="ph"><Photo name="mantas-portretas" alt="Arboristas Mantas Gerulis su šalmu, alpinistine įranga ir pjūklu" sizes="(max-width: 860px) 100vw, 38vw" position="50% 28%" /></div>
      <figcaption class="snd__tag">
        <strong>Mantas Gerulis</strong>
        <span>Paslaugos.lt: tapatybė patvirtinta, profilis nuo {site.profilis.nuo} m.</span>
      </figcaption>
    </figure>
  </div>
</section>
<style>
  .snd { background: var(--f2); color: var(--cream); padding-block: var(--sec); }
  .snd :focus-visible { outline-color: var(--amber); }
  .snd__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(36px, 5vw, 88px); align-items: start; }
  .snd__txt { display: grid; gap: 24px; }
  .snd h2 { font-size: clamp(2.6rem, 1.4rem + 4vw, 5.2rem); font-weight: 700; }
  .snd__q { background: var(--f0); padding: 28px 30px 26px; border-top: 8px solid var(--amber); }
  .snd__q blockquote p { font-family: var(--display); font-weight: 700; text-transform: uppercase; font-size: clamp(1.9rem, 1.2rem + 2.2vw, 3.2rem); line-height: 1.12; color: var(--amber); }
  .snd__q figcaption { margin-top: 14px; font-weight: 700; }
  .snd__q figcaption a { text-decoration: underline; text-underline-offset: 4px; }
  .snd__p { font-size: 1.2rem; color: #E3E9E4; }
  .snd__q2 p { font-size: 1.15rem; line-height: 1.5; border-left: 5px solid var(--amber); padding-left: 18px; color: var(--cream); font-style: italic; }
  .snd__what { background: var(--cream); color: var(--text); padding: 24px 26px; }
  .snd__what :focus-visible { outline-color: var(--rust); }
  .snd__what h3 { margin-bottom: 14px; }
  .snd .btn--line { color: var(--cream); }
  .snd .btn--line:hover { background: var(--cream); color: var(--f1); border-color: var(--cream); }
  .snd__act { display: flex; flex-wrap: wrap; gap: 12px; }
  .snd__big { font-size: clamp(1.25rem, 1.1rem + .5vw, 1.5rem); min-height: 64px; padding-inline: 28px; }
  .snd__mail a { font-weight: 700; text-decoration: underline; text-decoration-color: var(--amber); text-underline-offset: 4px; overflow-wrap: anywhere; }
  .snd__ph { position: sticky; top: calc(var(--header-h) + 24px); }
  .snd__ph .ph { aspect-ratio: 4 / 5; box-shadow: var(--shadow); }
  .snd__tag { position: relative; margin: -64px 24px 0 -28px; background: var(--cream); color: var(--text); padding: 18px 22px; display: grid; gap: 2px; border-left: 8px solid var(--rust); box-shadow: var(--shadow); }
  .snd__tag strong { font-family: var(--display); font-size: 1.7rem; text-transform: uppercase; font-weight: 700; line-height: 1.12; }
  .snd__tag span { color: var(--text-2); }
  @media (max-width: 860px) {
    .snd__grid { grid-template-columns: 1fr; }
    .snd__ph { position: static; order: -1; max-width: 520px; }
    .snd__tag { margin: -48px 12px 0 12px; }
    .snd__q { padding: 22px 18px; }
    .snd__what { padding: 20px 16px; }
    .snd__act .btn { width: 100%; }
  }
</style>
