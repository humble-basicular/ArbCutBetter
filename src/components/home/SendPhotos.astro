---
/* v5 eiga (14 žingsnių: 8, 12): oranžinė juosta su rievėmis, penki pavadinti žingsniai ant virvės,
   Manto žodžiai iš Valstietis.lt, ką nufotografuoti, SMS / el. paštas, burbulas su Manto veidu.
   Žingsnių tekstai sudaryti tik iš esamų faktų (nuotraukos → kaina → atvykimas → išvežimas Kaune / krūvos kitur). */
import { Image } from 'astro:assets';
import { site } from '@data/site.js';
import { valstietis } from '@data/spauda.js';
import face from '../../assets/photos/mantas-portretas.jpg';
const subj = encodeURIComponent('Nuotraukos kainai');
const I = '/assets/v5-brand/raster/icons';
const steps = [
  { ic: 'step-foto', n: 'Nufotografuokite', p: 'Visą darbo vietą, kas šalia ir kelią iki jos.' },
  { ic: 'step-siusti', n: 'Atsiųskite', p: 'Pridėkite prie užklausos arba siųskite SMS, Viber ar WhatsApp.' },
  { ic: 'step-kaina', n: 'Pasakome kainą', p: 'Preliminarią pagal nuotraukas, o galutinę sutariame prieš darbą.' },
  { ic: 'step-atvaziuojame', n: 'Atvažiuojame', p: 'Su autobokšteliu arba virvėmis, sutartą dieną.' },
  { ic: 'step-tvarkinga', n: 'Paliekame tvarkingai', p: 'Kaune ir Kauno r. šakas išvežame fiskaru, kitur sukrauname krūvomis.' },
];
---
<section class="snd" id="nuotraukos" aria-labelledby="snd-h">
  <div class="snd__rings" aria-hidden="true"></div>
  <div class="wrap">
    <div class="snd__head">
      <div>
        <p class="kick snd__kick">Nuo nuotraukos iki tvarkingo kiemo</p>
        <h2 id="snd-h">Kaip vyksta darbas</h2>
      </div>
      <div class="snd__bubble rv">
        <Image class="snd__face" src={face} alt="" widths={[96, 192]} sizes="96px" format="webp" quality={80} style="object-position: 50% 18%" />
        <p><span class="hand">Skambinate tiesiai Mantui</span>Jis pats pažiūri nuotraukas ir pasako, ką daryti.</p>
      </div>
    </div>

    <ol class="snd__steps" data-rope>
      {steps.map((s, i) => (
        <li class="snd__step rv lift" style={`--i:${i}`}>
          <span class="snd__num" aria-hidden="true">{i + 1}</span>
          <span class="ico-c snd__ic" style="--cs:84px"><img src={`${I}/${s.ic}-160.png`} alt="" width="62" height="62" loading="lazy" /></span>
          <p class="snd__p">{s.p}</p>
          <p class="snd__name tag">{s.n}</p>
        </li>
      ))}
    </ol>

    <div class="snd__grid">
      <div class="snd__words">
        <figure class="snd__q">
          <blockquote><p>„{valstietis.citatos.kava}“</p></blockquote>
          <figcaption>Mantas Gerulis, <a href={valstietis.url} target="_blank" rel="noopener">Valstietis.lt</a></figcaption>
        </figure>
        <p class="snd__p2">Todėl preliminarią kainą pasakome pagal jūsų nuotraukas. Kainą lemia daugiau nei vien dydis:</p>
        <blockquote class="snd__q2"><p>„{valstietis.citatos.sudetingumas}“</p></blockquote>
      </div>
      <div class="snd__what">
        <h3>Ką nufotografuoti</h3>
        <ul class="ticks">
          <li>Visą darbo vietą iš toliau, kad matytųsi aukštis.</li>
          <li>Kas šalia: namas, tvora, laidai, gatvė.</li>
          <li>Detalę iš arti: kamieną, kelmą, lataką ar iškabą.</li>
          <li>Kelią iki vietos: ar privažiuos autobokštelis.</li>
        </ul>
        <div class="snd__act">
          <button type="button" class="btn btn--primary" data-quote data-loc="photos-quote">Gauti preliminarią kainą</button>
        </div>
        <p class="snd__mail">Arba <a href={site.smsHref} data-loc="photos-sms">SMS žinute {site.telefonas}</a>, Viber, WhatsApp, <a href={`mailto:${site.elPastas}?subject=${subj}`} data-loc="photos-mail">el. paštu</a>.</p>
      </div>
    </div>
  </div>
</section>
<style>
  .snd { position: relative; background: var(--orange); color: #fff; overflow: hidden; isolation: isolate; padding-block: clamp(72px, 8vw, 120px); }
  .snd__rings { position: absolute; inset: 0; background: url('/assets/v5-brand/texture/rings-band.webp') 92% 20% / 2000px auto no-repeat; z-index: -1; }
  .snd__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 28px; margin-bottom: clamp(48px, 5vw, 72px); }
  @media (max-width: 860px) { .snd__head { grid-template-columns: 1fr; } }
  .snd__kick { color: var(--spruce-950); font-weight: 700; }
  .snd h2 { color: #fff; max-width: 14em; margin-top: 8px; }
  .snd__bubble { position: relative; display: flex; align-items: center; gap: 14px; background: #fff; color: var(--ink); border-radius: 999px; padding: 8px 26px 8px 8px; box-shadow: var(--sh-2); max-width: 430px; }
  .snd__bubble::after { content: ''; position: absolute; right: 48px; bottom: -12px; width: 24px; height: 24px; background: #fff; transform: rotate(45deg); border-radius: 0 0 6px 0; }
  .snd__face { width: 78px; height: 78px; border-radius: 50%; object-fit: cover; border: 3px solid var(--gold); flex: 0 0 auto; }
  .snd__bubble p { font-size: .98rem; line-height: 1.35; color: var(--ink-2); }
  .snd__bubble .hand { display: block; color: var(--spruce-900); font-size: 1.75rem; }

  .snd__steps { position: relative; list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 22px); }
  .snd__steps::before { content: ''; position: absolute; left: 6%; right: 6%; top: 52px; height: 10px; border-radius: 99px; background: repeating-linear-gradient(-55deg, var(--spruce-900) 0 6px, #24604A 6px 12px); box-shadow: 0 3px 0 rgba(0,0,0,.15); z-index: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .js .snd__steps::before { transform: scaleX(0); transform-origin: left; transition: transform 1.1s ease-out; }
    .js .snd__steps.is-drawn::before { transform: scaleX(1); }
  }
  .snd__step { position: relative; z-index: 1; background: #fff; color: var(--ink); border-radius: var(--r-lg); padding: 64px 18px 0; margin-top: 10px; display: grid; justify-items: center; text-align: center; align-content: start; gap: 12px; box-shadow: var(--sh-2); }
  .snd__ic { position: absolute; top: -8px; left: 50%; transform: translateX(-50%); border: 4px solid var(--spruce-900); }
  .snd__num { position: absolute; top: 10px; left: 14px; font-family: var(--display); font-weight: 800; font-size: 1.6rem; color: var(--orange); }
  .snd__p { font-size: 1rem; line-height: 1.45; color: var(--ink-2); min-height: 4.4em; margin-top: 30px; }
  .snd__name { margin-bottom: -18px; font-size: 1.02rem; }
  .snd .snd__name { background: var(--spruce-900); color: #fff; transform: none; }

  .snd__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(28px, 4vw, 64px); margin-top: clamp(56px, 6vw, 84px); align-items: start; }
  .snd__q blockquote { font-family: var(--display); font-weight: 700; font-variation-settings: 'opsz' 48, 'wdth' 95; font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2.1rem); line-height: 1.2; letter-spacing: -.01em; }
  .snd__q figcaption { margin-top: 12px; font-weight: 700; color: var(--spruce-950); }
  .snd__q figcaption a { color: var(--spruce-950); text-decoration: underline; text-decoration-color: #fff; text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .snd__mail a { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .snd__p2 { margin-top: 22px; font-size: 1.1rem; color: var(--spruce-950); font-weight: 500; }
  .snd__q2 { margin-top: 14px; border-left: 5px solid var(--spruce-900); padding-left: 18px; font-size: 1.2rem; font-weight: 700; color: var(--spruce-950); }
  .snd__what { background: var(--spruce-900); border-radius: var(--r-lg); padding: clamp(22px, 3vw, 34px); box-shadow: var(--sh-3); display: grid; gap: 16px; }
  .snd__what h3 { color: var(--gold); }
  .snd__what .ticks { color: #fff; }
  .snd__what :global(.ticks li::before) { filter: brightness(0) invert(1); }
  .snd__act { display: flex; flex-wrap: wrap; gap: 12px; }
  .snd__mail { color: var(--on-dark-2); font-size: .98rem; }

  @media (max-width: 1100px) {
    .snd__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 54px; }
    .snd__steps::before { display: none; }
    .snd__step:last-child { grid-column: 1 / -1; }
  }
  @media (max-width: 860px) { .snd__grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) {
    .snd__steps { grid-template-columns: 1fr; row-gap: 46px; }
    .snd__bubble { border-radius: var(--r-lg); }
    .snd__p { min-height: 0; }
    .snd__big { width: 100%; }
  }
</style>
