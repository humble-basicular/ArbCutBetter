---
/* Nuotraukos → kaina. Manto žodžiai iš Valstietis.lt; kainodara iš Paslaugos.lt profilio. */
import { site } from '@data/site.js';
import { valstietis } from '@data/spauda.js';
import Photo from '../Photo.astro';
const subj = encodeURIComponent('Medžio nuotraukos kainai');
---
<section class="snd" id="nuotraukos" aria-labelledby="snd-h">
  <div class="wrap snd__grid">
    <div class="snd__txt">
      <h2 id="snd-h">Atsiųskite nuotraukas. Pasakysime kainą.</h2>
      <figure class="snd__q">
        <blockquote><p>„{valstietis.citatos.kava}“</p></blockquote>
        <figcaption>Mantas Gerulis, <a href={valstietis.url} target="_blank" rel="noopener">Valstietis.lt</a></figcaption>
      </figure>
      <p class="snd__p">Todėl preliminarią kainą pasakome pagal jūsų nuotraukas, o tikslią atvažiavę į vietą. Kainą lemia daugiau nei medžio dydis:</p>
      <blockquote class="snd__q2"><p>„{valstietis.citatos.sudetingumas}“</p></blockquote>

      <div class="snd__what">
        <h3>Ką nufotografuoti</h3>
        <ul class="ticks">
          <li>Visą medį iš toliau, kad matytųsi viršūnė.</li>
          <li>Kas po medžiu ir šalia: namas, tvora, laidai, gatvė.</li>
          <li>Kamieną prie žemės.</li>
          <li>Kelią iki medžio: ar privažiuos autobokštelis.</li>
        </ul>
      </div>

      <div class="snd__act">
        <a class="btn btn--primary snd__big" href={site.smsHref} data-loc="photos-sms">Siųsti SMS <span class="btn__num">{site.telefonas}</span></a>
        <a class="btn btn--line" href={`mailto:${site.elPastas}?subject=${subj}`} data-loc="photos-mail">El. paštu</a>
      </div>
      <p class="snd__mail">El. paštas: <a href={`mailto:${site.elPastas}?subject=${subj}`}>{site.elPastas}</a></p>
    </div>

    <figure class="snd__ph">
      <div class="ph cut"><Photo name="mantas-portretas" alt="Arboristas Mantas Gerulis su šalmu, alpinistine įranga ir pjūklu" sizes="(max-width: 860px) 100vw, 38vw" position="50% 28%" /></div>
      <figcaption class="snd__tag">
        <strong>Mantas Gerulis</strong>
        <span>Paslaugos.lt: tapatybė patvirtinta, profilis nuo {site.profilis.nuo} m.</span>
      </figcaption>
    </figure>
  </div>
</section>
<style>
  .snd { background: var(--stone); padding-block: var(--sec); }
  .snd__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(36px, 5vw, 88px); align-items: start; }
  .snd__txt { display: grid; gap: 24px; }
  .snd h2 { color: var(--spruce-900); max-width: 16ch; }
  .snd__q { background: var(--paper); padding: 26px 28px 24px; }
  .snd__q blockquote p { font-stretch: var(--wide); font-weight: 800; font-size: clamp(1.5rem, 1.1rem + 1.5vw, 2.4rem); line-height: 1.12; letter-spacing: -.01em; color: var(--spruce-900); }
  .snd__q figcaption { margin-top: 14px; font-weight: 700; color: var(--ink-2); }
  .snd__q figcaption a { color: var(--spruce-900); text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 4px; }
  .snd__p { font-size: 1.15rem; color: var(--ink-2); }
  .snd__q2 p { font-size: 1.12rem; line-height: 1.5; padding-left: 18px; box-shadow: inset 4px 0 0 var(--spruce-700); color: var(--ink); }
  .snd__what { background: var(--paper); padding: 24px 26px; }
  .snd__what h3 { margin-bottom: 14px; color: var(--spruce-900); }
  .snd__act { display: flex; flex-wrap: wrap; gap: 12px; }
  .snd__big { min-height: 64px; padding-inline: 26px; }
  .snd__mail a { font-weight: 700; color: var(--spruce-900); text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 4px; overflow-wrap: anywhere; }
  .snd__ph { position: sticky; top: calc(var(--header-h) + 24px); }
  .snd__ph .ph { aspect-ratio: 4 / 5; }
  .snd__tag { margin-top: 14px; display: grid; gap: 2px; }
  .snd__tag strong { font-stretch: var(--wide); font-size: 1.4rem; font-weight: 800; line-height: 1.15; color: var(--spruce-900); }
  .snd__tag span { color: var(--ink-2); }
  @media (max-width: 860px) {
    .snd__grid { grid-template-columns: 1fr; }
    .snd__ph { position: static; order: -1; max-width: 520px; }
    .snd__q { padding: 22px 18px; }
    .snd__what { padding: 20px 16px; }
    .snd__act .btn { width: 100%; }
  }
  @media (max-width: 600px) {
    .snd__ph .ph { aspect-ratio: 4 / 3; }
    .snd__txt { gap: 16px; }
    .snd__q2 { display: none; }
    .snd__what .ticks { gap: 6px; }
  }
</style>
