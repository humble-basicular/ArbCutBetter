---
/* v5 skubi juosta: oranžinė per visą plotį (14 žingsnių: 5), audros nuotrauka balta rėmeliu, pasvirusi.
   Be „24/7“ — dirbame 08:00–18:00. */
import { site } from '@data/site.js';
const I = '/assets/v5-brand/raster/icons';
---
<section class="sos" aria-labelledby="sos-h">
  <div class="sos__rings" aria-hidden="true"></div>
  <div class="wrap sos__grid">
    <figure class="sos__ph rv">
      <img src="/assets/images/paslaugos/audros-isverstu-medziu-salinimas.jpg" alt="Audros išverstas medis užvirtęs ant pastato stogo" width="340" height="340" loading="lazy" decoding="async" />
      <figcaption class="hand">Po audros: medis ant pastato. Nuėmėme dalimis.</figcaption>
    </figure>
    <div class="sos__main">
      <p class="tag tag--white rv-tag sos__tag"><img class="ico" src={`${I}/svc-audra-160.png`} alt="" width="30" height="30" style="--is:30px" />Skubiai</p>
      <h2 id="sos-h">Medis nuvirto ar tuoj virs?</h2>
      <p class="sos__p">Skambinkite iš karto. Pirmiausia nuimame tai, kas gali kristi ant namo, mašinos ar žmonių, paskui tvarkome likusį medį. Jei medis užkrito ant elektros laidų, nelieskite jo ir praneškite elektros tinklų operatoriui.</p>
    </div>
    <div class="sos__act">
      <a class="btn btn--white btn--lg sos__tel" href={site.telefonasHref} data-loc="sos-call"><img class="ico" src={`${I}/ui-phone-160.png`} alt="" width="30" height="30" style="--is:30px" /><span class="btn__num">{site.telefonas}</span></a>
      <p><strong>Kasdien 08:00–18:00</strong>, ir savaitgaliais.<br /><a href="/paslaugos/audros-isverstu-medziu-salinimas">Audros padarinių šalinimas, nuo 50 €</a></p>
    </div>
  </div>
</section>
<style>
  .sos { position: relative; background: var(--orange); color: #fff; overflow: hidden; isolation: isolate; padding-block: clamp(56px, 6vw, 88px); }
  .sos__rings { position: absolute; inset: 0; background: url('/assets/v5-brand/texture/rings-band.webp') 8% 40% / 1800px auto no-repeat; opacity: .9; z-index: -1; }
  .sos__grid { display: grid; grid-template-columns: auto minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(28px, 4vw, 64px); align-items: center; }
  .sos__ph { width: clamp(200px, 20vw, 270px); background: #fff; padding: 10px 10px 14px; border-radius: 6px; box-shadow: var(--sh-3); transform: rotate(-4deg); }
  .sos__ph img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 3px; }
  .sos__ph figcaption { color: var(--spruce-900); font-size: 1.25rem; margin-top: 8px; text-align: center; line-height: 1.05; }
  .sos__main { display: grid; gap: 14px; justify-items: start; }
  .sos__tag { display: inline-flex; align-items: center; gap: 8px; font-size: 1rem; color: var(--orange-ink); }
  .sos h2 { color: #fff; font-size: clamp(2.2rem, 1.4rem + 3vw, 4rem); text-shadow: 0 2px 0 rgba(0,0,0,.08); }
  .sos__p { font-size: 1.15rem; line-height: 1.55; max-width: 36em; color: var(--spruce-950); font-weight: 500; }
  .sos__act { display: grid; gap: 14px; justify-items: start; }
  .sos__tel { color: var(--orange-ink); }
  .sos__tel .btn__num { font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); }
  .sos__act p { font-size: 1.05rem; line-height: 1.5; color: var(--spruce-950); }
  .sos__act a:not(.btn) { color: var(--spruce-950); font-weight: 800; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; text-decoration-color: #fff; }
  @media (max-width: 1000px) { .sos__grid { grid-template-columns: auto 1fr; } .sos__act { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .sos__grid { grid-template-columns: 1fr; } .sos__ph { width: 70%; justify-self: center; } .sos__tel { width: 100%; } }
</style>
