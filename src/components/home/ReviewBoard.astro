---
/* v5 atsiliepimai (patvirtintas variantas 1): tikra darbo nuotrauka fone, trys horizontalios baltos kortelės,
   auksinės žvaigždės, rodyklės ir braukimas. Originalūs tekstai iš atsiliepimai-visi.js, nieko neperrašyta.
   Ne schema.org (žr. jsonld.js). */
import { site } from '@data/site.js';
import { visiAtsiliepimai, saltiniai, bendrasKiekis, bendrasIvertinimas } from '@data/atsiliepimai-visi.js';
import Photo from '../Photo.astro';
import Mark from '../Mark.astro';
import Stars from '../v5/Stars.astro';
const items = visiAtsiliepimai.filter((a) => a.tekstas.trim().length >= 40 && a.zvaigzdes).slice(0, 12);
const r1 = (x) => x.toFixed(1).replace('.', ',');
const ini = (n) => (n || '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join('');
---
<section class="rvb" id="atsiliepimai" aria-labelledby="rvb-h">
  <div class="rvb__bg fill" aria-hidden="true"><Photo name="azuolai-prie-namo" alt="" sizes="100vw" widths={[800, 1280, 1600, 2000]} position="50% 35%" /></div>
  <div class="wrap">
    <div class="rvb__head">
      <div>
        <p class="rvb__tag tag">Atsiliepimai</p>
        <h2 id="rvb-h">Ką rašo klientai</h2>
      </div>
      <a class="rvb__sum" href="/atsiliepimai">
        <span><b>{r1(bendrasIvertinimas)}</b> <Stars size={18} /><small>{bendrasKiekis} atsiliepimai</small></span>
      </a>
    </div>

    <div class="rvc" data-rvc>
      <button type="button" class="rvc__nav rvc__nav--prev" data-rvc-prev aria-label="Ankstesni atsiliepimai"><span aria-hidden="true"></span></button>
      <ul role="list" class="rvc__track" data-rvc-track tabindex="0" aria-label="Klientų atsiliepimai, slinkite į šonus">
        {items.map((a) => (
          <li class="rvc__card">
            <article>
              <div class="rvc__top">
                <p class="rvc__stars"><span class="rvc__n">{a.zvaigzdes}</span><Stars n={a.zvaigzdes} size={20} /></p>
                <Mark name={a.saltinis} height={a.saltinis === 'google' ? 28 : 30} label={`Atsiliepimas iš ${saltiniai[a.saltinis].pavadinimas}`} class="rvc__src" />
              </div>
              <blockquote class="rvc__txt" data-rvc-txt>{a.tekstas.split('\n').filter(Boolean).map((l) => <p>{l}</p>)}</blockquote>
              <button type="button" class="rvc__more" data-rvc-more aria-expanded="false" hidden>Skaityti visą</button>
              <footer class="rvc__by">
                <span class="rvc__av" aria-hidden="true">{ini(a.vardas)}</span>
                <span><strong>{a.vardas}</strong>{a.paslaugaPavadinimas && <small>{a.paslaugaPavadinimas}</small>}</span>
              </footer>
            </article>
          </li>
        ))}
      </ul>
      <button type="button" class="rvc__nav rvc__nav--next" data-rvc-next aria-label="Kiti atsiliepimai"><span aria-hidden="true"></span></button>
    </div>

    <div class="rvb__acts">
      <a class="btn btn--gold" href="/atsiliepimai">Visi atsiliepimai</a>
      <a class="btn btn--white" href={site.atsiliepimai.paliktiUrl} target="_blank" rel="noopener">Parašyti atsiliepimą<span class="sr-only"> (atsidaro naujame lange)</span></a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-rvc]').forEach((box) => {
    const track = box.querySelector('[data-rvc-track]') as HTMLElement;
    const step = () => { const c = track.querySelector('li') as HTMLElement; return c ? c.offsetWidth + 20 : track.clientWidth; };
    const prev = box.querySelector('[data-rvc-prev]') as HTMLButtonElement;
    const next = box.querySelector('[data-rvc-next]') as HTMLButtonElement;
    const upd = () => { prev.disabled = track.scrollLeft < 4; next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4; };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', () => requestAnimationFrame(upd), { passive: true });
    upd();
    box.querySelectorAll<HTMLElement>('[data-rvc-txt]').forEach((t) => {
      const b = t.nextElementSibling as HTMLButtonElement;
      const check = () => { if (!t.classList.contains('is-open')) b.hidden = t.scrollHeight <= t.clientHeight + 2; };
      check();
      if ('ResizeObserver' in window) new ResizeObserver(check).observe(t);
      document.fonts && document.fonts.ready.then(check);
      b.addEventListener('click', () => { const o = t.classList.toggle('is-open'); b.setAttribute('aria-expanded', String(o)); b.textContent = o ? 'Suskleisti' : 'Skaityti visą'; });
    });
  });
</script>

<style>
  .rvb { position: relative; color: #fff; padding-block: clamp(72px, 8vw, 120px); overflow: hidden; isolation: isolate; }
  .rvb__bg { position: absolute; inset: 0; z-index: -2; }
  .rvb::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(11,35,27,.82), rgba(11,35,27,.68) 50%, rgba(11,35,27,.86)); }
  .rvb__head { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(28px, 3vw, 44px); }
  .rvb__tag { font-size: .95rem; }
  .rvb h2 { color: #fff; font-size: clamp(2.6rem, 1.6rem + 3.6vw, 5rem); margin-top: 14px; }
  .rvb__sum { display: inline-flex; align-items: center; gap: 14px; background: #fff; color: var(--ink); border-radius: var(--r); padding: 12px 18px; box-shadow: var(--sh-2); }
  .rvb__sum b { font-family: var(--display); font-size: 1.6rem; margin-right: 6px; }
  .rvb__sum small { display: block; color: var(--ink-2); font-weight: 650; font-size: .92rem; }

  .rvc { position: relative; }
  .rvc__track { display: grid; grid-auto-flow: column; grid-auto-columns: calc((100% - 40px) / 3); gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 4px 2px 18px; overscroll-behavior-x: contain; }
  .rvc__track::-webkit-scrollbar { display: none; }
  .rvc__track:focus-visible { outline: 3px solid var(--gold); outline-offset: 6px; border-radius: var(--r); }
  .rvc__card { scroll-snap-align: start; }
  .rvc__card article { height: 100%; background: #fff; color: var(--ink); border-radius: var(--r-lg); padding: 26px 26px 22px; display: flex; flex-direction: column; gap: 14px; box-shadow: var(--sh-3); }
  .rvc__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .rvc__stars { display: flex; align-items: center; gap: 8px; }
  .rvc__n { font-family: var(--display); font-weight: 800; font-size: 1.4rem; color: var(--gold-600); }
  .rvc__txt { flex: 1; display: grid; gap: 8px; font-size: 1.04rem; line-height: 1.55; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 8; -webkit-box-orient: vertical; overflow: hidden; }
  .rvc__txt.is-open { -webkit-line-clamp: unset; display: grid; overflow: visible; }
  .rvc__more { align-self: start; font-weight: 800; color: var(--spruce-900); text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: 4px; padding-block: 4px; }
  .rvc__by { display: flex; align-items: center; gap: 12px; padding-top: 14px; border-top: 1px solid var(--line); }
  .rvc__by strong { display: block; text-transform: capitalize; }
  .rvc__by small { color: var(--ink-2); font-size: .9rem; }
  .rvc__av { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: var(--spruce-900); color: var(--gold); font-family: var(--display); font-weight: 800; }
  .rvc__nav { position: absolute; top: calc(50% - 30px); z-index: 2; width: 52px; height: 52px; border-radius: 50%; background: var(--gold); box-shadow: var(--sh-2); display: grid; place-items: center; transition: transform var(--t), opacity var(--t); }
  .rvc__nav span { width: 12px; height: 12px; border-right: 3px solid var(--spruce-950); border-bottom: 3px solid var(--spruce-950); }
  .rvc__nav--prev { left: -26px; } .rvc__nav--prev span { transform: translateX(2px) rotate(135deg); }
  .rvc__nav--next { right: -26px; } .rvc__nav--next span { transform: translateX(-2px) rotate(-45deg); }
  .rvc__nav:hover { transform: scale(1.06); }
  .rvc__nav:disabled { opacity: .35; cursor: default; transform: none; }
  .rvb__acts { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 18px; }
  @media (max-width: 1000px) { .rvc__track { grid-auto-columns: calc((100% - 20px) / 2); } .rvc__nav--prev { left: -8px; } .rvc__nav--next { right: -8px; } }
  @media (max-width: 640px) {
    .rvc__track { grid-auto-columns: 86%; }
    .rvc__nav { display: none; }
    .rvb__sum { width: 100%; }
    .rvb__acts .btn { width: 100%; }
  }
</style>
