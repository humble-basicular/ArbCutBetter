---
/* v5 savininko juosta (14 žingsnių: 7), tik patikrinti faktai (.agents/research/v5-client-mantas-gerulis.md):
   LRT.lt 2020 interviu (kelias į arboristiką, pasiruošimas darbui, citata), LARA narių sąrašas.
   Jokio išgalvoto pažado ar parašo: vardas ir pareigos surinkti paprastu šriftu. */
import { site } from '@data/site.js';
import { lrt } from '@data/spauda.js';
import Photo from '../Photo.astro';
---
<section class="prom" aria-labelledby="prom-h" data-parallax-host>
  <div class="prom__rings" data-parallax="0.1" aria-hidden="true"></div>
  <div class="wrap prom__grid">
    <div class="prom__vis">
      <Photo name="mantas-ant-sakos" alt="Mantas Gerulis stovi ant šakos medžio lajoje, prisirišęs virvėmis" sizes="(max-width: 860px) 92vw, 460px" widths={[480, 749, 1000, 1500]} position="50% 35%" />
    </div>
    <div class="prom__txt">
      <p class="tag rv-tag">Kas lips į jūsų medį</p>
      <h2 id="prom-h" class="prom__h">{site.savininkas}</h2>
      <p class="prom__p">Į arboristiką Mantas atėjo iš aukštuminių pastatų remonto darbų. Kitai darbo dienai ruošiasi iš anksto: tikrina įrangą ir virves, tvarko įrankius, galanda pjūklus. Taip jis pasakojo <a href={lrt.url} target="_blank" rel="noopener">LRT.lt interviu<span class="sr-only"> (atsidaro naujame lange)</span></a>.</p>
      <blockquote class="prom__q"><p>„{lrt.citatos.tikslas}.“</p></blockquote>
      <div class="prom__sign">
        <span class="prom__who"><b>{site.savininkas}</b><span>Arboristas aukštalipys, ArbCut</span></span>
        <a class="prom__lara" href="https://www.arboristuasociacija.lt/nariai" target="_blank" rel="noopener">Lietuvos arboristų asociacijos narių sąraše<span class="sr-only"> (atsidaro naujame lange)</span></a>
      </div>
      <div class="btn-row">
        <a class="btn btn--primary" href={site.telefonasHref} data-loc="promise-call"><span class="btn__num">{site.telefonas}</span></a>
        <a class="btn btn--line" href="/apie">Apie Mantą</a>
      </div>
    </div>
  </div>
</section>
<style>
  .prom { position: relative; background: var(--spruce-900); color: #fff; isolation: isolate; overflow: hidden; padding-top: clamp(72px, 8vw, 120px); }
  .prom__rings { position: absolute; inset: -100px -10%; background: url('/assets/v5-brand/texture/rings-hero.webp') 18% 70% / 2200px auto no-repeat; opacity: .35; z-index: -1; }
  .prom__grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: clamp(28px, 4vw, 72px); align-items: center; padding-bottom: clamp(56px, 6vw, 96px); }
  .prom__vis { width: min(100%, 460px); justify-self: center; aspect-ratio: 5 / 6; border-radius: var(--r-lg); overflow: hidden; border: 6px solid #fff; box-shadow: 0 18px 40px rgba(0, 0, 0, .45); }
  .prom__vis :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .prom__txt { display: grid; gap: 18px; justify-items: start; }
  .prom__h { color: #fff; }
  .prom__p { font-size: clamp(1.08rem, 1rem + .3vw, 1.22rem); line-height: 1.6; color: var(--on-dark-2); max-width: 34em; }
  .prom__p a, .prom__lara { color: #fff; font-weight: 700; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .prom__q { font-family: var(--display); font-weight: 700; font-size: clamp(1.4rem, 1.1rem + 1.2vw, 2.1rem); line-height: 1.2; color: var(--gold); max-width: 22em; }
  .prom__sign { display: flex; align-items: center; gap: 18px 28px; flex-wrap: wrap; }
  .prom__who { display: grid; line-height: 1.25; }
  .prom__who b { font-family: var(--display); font-size: 1.3rem; }
  .prom__who span { color: var(--on-dark-2); font-size: .95rem; }
  @media (max-width: 860px) { .prom__grid { grid-template-columns: 1fr; } .prom__vis { order: 2; } }
</style>
