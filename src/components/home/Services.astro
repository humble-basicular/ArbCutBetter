---
/* Paslaugos ir kainos: trys didelės realios nuotraukos + visų 12 paslaugų kainų lenta.
   Kainos „nuo“ — iš Paslaugos.lt profilio (2026-11-04). */
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
const by = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const kaina = { 'gyvatvoriu-karpymas': '2–7 €/m' };
const eil = {
  'avariniu-medziu-pjovimas': 'Prie namų, tvorų, laidų, kapų. Dalimis, su virvėmis.',
  'audros-isverstu-medziu-salinimas': 'Išversti, nulūžę, užkritę ant stogo ar tvoros.',
  'medziu-genejimas': 'Sausos ir pavojingos šakos, lajos formavimas.',
  'medziu-lajos-stabilizavimas': 'Kai medį galima išsaugoti: lajos sutvirtinimas.',
  'kelmu-naikinimas-frezavimas': 'Frezuojame arba išrauname.',
  'saku-isvezimas': 'Fiskaru, talpa nuo 20 m³. Tik Kaune ir Kauno r.',
  'gyvatvoriu-karpymas': 'Kaina pagal aukštį, plotį ir ilgį.',
  'darbai-su-autoboksteliu': 'Nuosavas autobokštelis, kėlimo aukštis iki 20 m.',
  'lietvamzdziu-stogo-valymas': 'Latakai nuo lapų ir sąnašų.',
  'dazymo-darbai-aukstyje': 'Fasadai, stogai ir kitkas aukštyje.',
  'reklaminiu-iskabu-montavimas': 'Montavimas ir nuėmimas.',
  'kiti-aukstuminiai-darbai': 'Jei reikia aukštai, paskambinkite.',
};
const tiles = [
  { slug: 'avariniu-medziu-pjovimas', foto: 'medis-prie-muro', pos: '62% 30%', alt: 'Arboristas pjauna aukštą medį šalia raudonų plytų pastato', h: 'Pavojingi medžiai' },
  { slug: 'medziu-genejimas', foto: 'lajoje-vasara', pos: '50% 30%', alt: 'Arboristas oranžiniais marškinėliais dirba žalioje medžio lajoje', h: 'Genėjimas' },
  { slug: 'darbai-su-autoboksteliu', foto: 'autobokstelis-pusyne', pos: '50% 40%', alt: 'ArbCut autobokštelis su iškeltu krepšiu tarp pušų', h: 'Autobokštelis iki 20 m' },
];
---
<section class="svcs dark" id="paslaugos" aria-labelledby="svcs-h">
  <div class="wrap">
    <div class="svcs__head">
      <h2 id="svcs-h">Ką darome ir kiek kainuoja</h2>
      <p class="lead">Kainos „nuo“, tokios pat kaip mūsų Paslaugos.lt profilyje. Preliminarią sumą pasakome pagal nuotraukas, tikslią atvažiavę pažiūrėti.</p>
    </div>

    <ul role="list" class="tiles">
      {tiles.map((t, i) => (
        <li class:list={['tile', { 'tile--big': i === 0 }]}>
          <a href={`/paslaugos/${t.slug}`}>
            <div class="tile__ph ph"><Photo name={t.foto} alt={t.alt} sizes={i === 0 ? '(max-width: 760px) 100vw, 46vw' : '(max-width: 760px) 100vw, 27vw'} position={t.pos} /></div>
            <div class="tile__txt">
              <h3>{t.h}</h3>
              <p class="tile__price">{kaina[t.slug] || by[t.slug].kaina}</p>
              <p class="tile__p">{eil[t.slug]}</p>
              <span class="tile__go">Plačiau <Icon name="arrow" size={20} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="board">
      {grupes.map((g) => (
        <div class="board__col">
          <h3 class="board__h">{g.pavadinimas}</h3>
          <ul role="list">
            {g.slugs.map((s) => (
              <li>
                <a href={`/paslaugos/${s}`} class="board__row">
                  <span class="board__name">{by[s].pavadinimas}</span>
                  <span class="board__line">{eil[s]}</span>
                  <span class="board__price">{kaina[s] || by[s].kaina}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="board__foot">Valandinis darbas nuo 20 €/h. <a href="/kainos">Kas lemia kainą</a> · <a href="/paslaugos">Visos paslaugos</a></p>
  </div>
</section>

<style>
  .svcs { background: var(--f1); padding-block: var(--sec); }
  .svcs__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 24px 56px; align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
  .svcs__head h2 { font-size: clamp(2.6rem, 1.4rem + 4.4vw, 5.6rem); font-weight: 700; }

  .tiles { display: grid; grid-template-columns: 1.55fr 1fr 1fr; gap: 14px; }
  .tile a { position: relative; display: block; height: clamp(440px, 46vw, 640px); overflow: hidden; background: var(--f0); }
  .tile__ph { position: absolute; inset: 0; }
  .tile__ph :global(img) { transition: transform .5s ease; }
  .tile a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(14, 26, 20, .94) 0%, rgba(14, 26, 20, .55) 32%, rgba(14, 26, 20, 0) 58%); }
  .tile__txt { position: absolute; z-index: 1; left: 0; right: 0; bottom: 0; padding: clamp(20px, 2.4vw, 32px); display: grid; gap: 6px; }
  .tile h3 { font-size: clamp(1.8rem, 1.2rem + 1.6vw, 2.8rem); font-weight: 700; }
  .tile--big h3 { font-size: clamp(2.2rem, 1.3rem + 2.4vw, 3.6rem); }
  .tile__price { font-family: var(--display); font-weight: 600; font-size: clamp(1.5rem, 1.2rem + .8vw, 2rem); color: var(--amber); line-height: 1.12; }
  .tile__p { color: #DDE5DF; max-width: 30em; }
  .tile__go { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-weight: 700; color: var(--cream); text-decoration: underline; text-decoration-color: var(--amber); text-underline-offset: 5px; text-decoration-thickness: 2px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .tile a:hover .tile__ph :global(img) { transform: scale(1.04); } }

  .board { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 14px; }
  .board__col { background: var(--f0); padding: clamp(22px, 3vw, 36px); }
  .board__h { font-size: clamp(1.7rem, 1.3rem + 1vw, 2.3rem); color: var(--amber); margin-bottom: 10px; }
  .board__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 20px; padding: 14px 0; border-top: 1px solid #22402f; }
  .board li:first-child .board__row { border-top: 0; }
  .board__name { font-weight: 700; font-size: 1.15rem; color: var(--cream); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; transition: text-decoration-color var(--t); }
  .board__row:hover .board__name { text-decoration-color: var(--amber); }
  .board__line { grid-column: 1; color: var(--on-dark-2); font-size: 1rem; }
  .board__price { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-family: var(--display); font-weight: 600; font-size: clamp(1.4rem, 1.2rem + .5vw, 1.75rem); color: var(--cream); white-space: nowrap; }
  .board__foot { margin-top: 22px; color: var(--on-dark-2); }
  .board__foot a { color: var(--cream); font-weight: 700; text-decoration: underline; text-decoration-color: var(--amber); text-underline-offset: 4px; }

  @media (max-width: 960px) {
    .svcs__head { grid-template-columns: 1fr; }
    .tiles { grid-template-columns: 1fr 1fr; }
    .tile--big { grid-column: 1 / -1; }
    .board { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .tiles { grid-template-columns: 1fr; }
    .tile a { height: 380px; }
    .tile--big a { height: 470px; }
    .board__col { padding: 20px 16px; }
    .board__price { font-size: 1.3rem; }
  }
</style>
