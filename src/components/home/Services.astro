---
/* Paslaugos ir kainos: trys didelės realios nuotraukos + visų 12 paslaugų kainų lenta.
   Kainos „nuo“ — iš Paslaugos.lt profilio (2026-11-04). */
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import Photo from '../Photo.astro';
const by = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const kaina = { 'gyvatvoriu-karpymas': '2–7 €/m' };
const eil = {
  'avariniu-medziu-pjovimas': 'Prie namų, tvorų, laidų, kapų. Dalimis, su virvėmis.',
  'audros-isverstu-medziu-salinimas': 'Išversti, nulūžę, užkritę ant stogo ar tvoros.',
  'medziu-genejimas': 'Sausos ir pavojingos šakos, lajos formavimas.',
  'medziu-lajos-stabilizavimas': 'Kai medį galima išsaugoti: lajos sutvirtinimas.',
  'kelmu-naikinimas-frezavimas': 'Frezuojame arba išrauname.',
  'saku-isvezimas': 'Fiskaru, talpa nuo 20 m³. Tik Kaune ir Kauno r.',
  'gyvatvoriu-karpymas': 'Kaina pagal aukštį, plotį ir ilgį.',
  'darbai-su-autoboksteliu': 'Nuosavas autobokštelis, kėlimo aukštis iki 20 m.',
  'lietvamzdziu-stogo-valymas': 'Latakai nuo lapų ir sąnašų.',
  'dazymo-darbai-aukstyje': 'Fasadai, stogai ir kitkas aukštyje.',
  'reklaminiu-iskabu-montavimas': 'Montavimas ir nuėmimas.',
  'kiti-aukstuminiai-darbai': 'Jei reikia aukštai, paskambinkite.',
};
const tiles = [
  { slug: 'avariniu-medziu-pjovimas', foto: 'medis-prie-muro', pos: '62% 30%', alt: 'Arboristas pjauna aukštą medį šalia raudonų plytų pastato', h: 'Pavojingi medžiai' },
  { slug: 'medziu-genejimas', foto: 'lajoje-vasara', pos: '50% 30%', alt: 'Arboristas oranžiniais marškinėliais dirba žalioje medžio lajoje', h: 'Genėjimas' },
  { slug: 'darbai-su-autoboksteliu', foto: 'autobokstelis-pusyne-homepage-crop', pos: '50% 40%', alt: 'ArbCut autobokštelis su iškeltu krepšiu tarp pušų', h: 'Autobokštelis iki 20 m' },
];
---
<section class="svcs" id="paslaugos" aria-labelledby="svcs-h">
  <div class="wrap">
    <div class="svcs__head">
      <h2 id="svcs-h">Ką darome ir kiek kainuoja</h2>
      <p class="lead">Kainos „nuo“, tokios pat kaip mūsų Paslaugos.lt profilyje. Preliminarią sumą pasakome pagal nuotraukas, tikslią atvažiavę pažiūrėti.</p>
    </div>

    <ul role="list" class="tiles">
      {tiles.map((t, i) => (
        <li class:list={['tile', { 'tile--big': i === 0 }]}>
          <a href={`/paslaugos/${t.slug}`}>
            <div class="tile__ph ph cut"><Photo name={t.foto} alt={t.alt} sizes={i === 0 ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 760px) 100vw, 22vw'} position={t.pos} /></div>
            <div class="tile__txt">
              <h3>{t.h}</h3>
              <p class="tile__price">{kaina[t.slug] || by[t.slug].kaina}</p>
              <p class="tile__p">{eil[t.slug]}</p>
              <span class="tile__go">Plačiau</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="board">
      {grupes.map((g) => (
        <div class="board__col">
          <h3 class="board__h">{g.pavadinimas}</h3>
          <ul role="list">
            {g.slugs.map((s) => (
              <li>
                <a href={`/paslaugos/${s}`} class="board__row">
                  <span class="board__name">{by[s].pavadinimas}</span>
                  <span class="board__line">{eil[s]}</span>
                  <span class="board__price">{kaina[s] || by[s].kaina}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="board__foot">Valandinis darbas nuo 20 €/h. <a href="/kainos">Kas lemia kainą</a> · <a href="/paslaugos">Visos paslaugos</a></p>
  </div>
</section>

<style>
  .svcs { background: var(--paper); padding-block: var(--sec); }
  .svcs__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 20px 56px; align-items: end; margin-bottom: clamp(32px, 4vw, 56px); }
  .svcs__head h2 { color: var(--spruce-900); max-width: 14ch; }

  .tiles { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) minmax(0, 1fr); gap: clamp(16px, 2vw, 28px); align-items: start; }
  .tile a { display: grid; gap: 16px; }
  .tile__ph { aspect-ratio: 4 / 5; }
  .tile--big .tile__ph { aspect-ratio: 4 / 5; }
  .tile:not(.tile--big) .tile__ph { aspect-ratio: 1 / 1; }
  .tile:not(.tile--big) { margin-top: clamp(40px, 8vw, 120px); }
  .tile__ph :global(img) { transition: transform .5s ease; }
  .tile__txt { display: grid; gap: 6px; }
  .tile h3 { font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); color: var(--spruce-900); }
  .tile--big h3 { font-size: clamp(1.8rem, 1.3rem + 1.8vw, 2.8rem); }
  .tile__price { font-stretch: var(--wide); font-weight: 800; font-size: clamp(1.2rem, 1.1rem + .5vw, 1.55rem); color: var(--ink); line-height: 1.15; }
  .tile__p { color: var(--ink-2); max-width: 30em; }
  .tile__go { justify-self: start; margin-top: 4px; font-weight: 700; color: var(--spruce-900); text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 5px; text-decoration-thickness: 2px; }
  .tile a:hover .tile__go { color: var(--orange-ink); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) { .tile a:hover .tile__ph :global(img) { transform: scale(1.03); } }

  .board { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 28px); margin-top: clamp(48px, 6vw, 88px); }
  .board__col { background: var(--stone); padding: clamp(22px, 3vw, 36px); }
  .board__h { font-size: clamp(1.35rem, 1.15rem + .8vw, 1.8rem); color: var(--spruce-900); margin-bottom: 8px; }
  .board__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 20px; padding: 14px 0; box-shadow: inset 0 1px 0 var(--line); }
  .board li:first-child .board__row { box-shadow: none; }
  .board__name { font-weight: 700; font-size: 1.12rem; color: var(--spruce-900); text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 4px; transition: text-decoration-color var(--t); }
  .board__row:hover .board__name { text-decoration-color: var(--orange); }
  .board__line { grid-column: 1; color: var(--ink-2); font-size: 1rem; }
  .board__price { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-stretch: var(--wide); font-weight: 800; font-size: clamp(1.15rem, 1.05rem + .4vw, 1.4rem); color: var(--ink); white-space: nowrap; }
  .board__foot { margin-top: 22px; color: var(--ink-2); }
  .board__foot a { color: var(--spruce-900); font-weight: 700; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  @media (max-width: 960px) {
    .svcs__head { grid-template-columns: 1fr; }
    .tiles { grid-template-columns: 1fr 1fr; }
    .tile--big { grid-column: 1 / -1; }
    .tile--big a { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; }
    .tile:not(.tile--big) { margin-top: 0; }
    .board { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .tiles { grid-template-columns: 1fr 1fr; gap: 14px; }
    .tile--big a { grid-template-columns: 1fr; }
    .tile--big .tile__ph { aspect-ratio: 4 / 3; }
    .tile:not(.tile--big) .tile__p { display: none; }
    .tile:not(.tile--big) h3 { font-size: 1.2rem; }
    .board__col { padding: 0; background: none; }
    .board__h { margin-bottom: 10px; }
    .board ul { display: grid; gap: 8px; }
    .board__row { box-shadow: none !important; background: var(--stone); padding: 14px 16px; gap: 4px 14px; }
    .board__price { grid-row: 1; align-self: start; font-size: 1.12rem; }
    .board__line { grid-column: 1 / -1; font-size: .96rem; }
  }
</style>
