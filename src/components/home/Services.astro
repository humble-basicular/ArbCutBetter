---
/* v5 paslaugos (14 žingsnių: 9): trys didelės realios nuotraukos su ženkliuku ir pasvirusiu pavadinimu,
   po jomis — kainoraštis su rastrinėmis piktogramomis. Kainos „nuo“ — iš Paslaugos.lt profilio (2026-11-04). */
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import Photo from '../Photo.astro';
const by = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const I = '/assets/v5-brand/raster/icons';
const ico = {
  'avariniu-medziu-pjovimas': 'svc-avarinis', 'audros-isverstu-medziu-salinimas': 'svc-audra', 'medziu-genejimas': 'svc-genejimas',
  'medziu-lajos-stabilizavimas': 'svc-stabilizavimas', 'kelmu-naikinimas-frezavimas': 'svc-kelmai', 'saku-isvezimas': 'svc-isvezimas',
  'gyvatvoriu-karpymas': 'svc-gyvatvores', 'darbai-su-autoboksteliu': 'svc-bokstelis', 'lietvamzdziu-stogo-valymas': 'svc-latakai',
  'dazymo-darbai-aukstyje': 'svc-dazymas', 'reklaminiu-iskabu-montavimas': 'svc-iskabos', 'kiti-aukstuminiai-darbai': 'svc-aukstis',
};
const kaina = { 'gyvatvoriu-karpymas': '2–7 €/m' };
const eil = {
  'avariniu-medziu-pjovimas': 'Prie namų, tvorų, laidų, kapų. Dalimis, su virvėmis.',
  'audros-isverstu-medziu-salinimas': 'Išversti, nulūžę, užkritę ant stogo ar tvoros.',
  'medziu-genejimas': 'Sausos ir pavojingos šakos, lajos formavimas.',
  'medziu-lajos-stabilizavimas': 'Kai medį galima išsaugoti: lajos sutvirtinimas.',
  'kelmu-naikinimas-frezavimas': 'Frezuojame arba išrauname.',
  'saku-isvezimas': 'Fiskaru, talpa nuo 20 m³. Tik Kaune ir Kauno r.',
  'gyvatvoriu-karpymas': 'Kaina pagal aukštį, plotį ir ilgį.',
  'darbai-su-autoboksteliu': 'Nuosavas autobokštelis, kėlimo aukštis iki 20 m.',
  'lietvamzdziu-stogo-valymas': 'Latakai nuo lapų ir sąnašų.',
  'dazymo-darbai-aukstyje': 'Fasadai, stogai ir kitkas aukštyje.',
  'reklaminiu-iskabu-montavimas': 'Montavimas ir nuėmimas.',
  'kiti-aukstuminiai-darbai': 'Jei reikia aukštai, paskambinkite.',
};
const tiles = [
  { slug: 'avariniu-medziu-pjovimas', foto: 'medis-prie-muro', pos: '62% 30%', alt: 'Arboristas pjauna aukštą medį šalia raudonų plytų pastato', h: 'Pavojingi medžiai' },
  { slug: 'medziu-genejimas', foto: 'lajoje-vasara', pos: '50% 30%', alt: 'Arboristas oranžiniais marškinėliais dirba žalioje medžio lajoje', h: 'Genėjimas' },
  { slug: 'darbai-su-autoboksteliu', foto: 'autobokstelis-pusyne-homepage-crop', pos: '50% 40%', alt: 'ArbCut autobokštelis su iškeltu krepšiu tarp pušų', h: 'Autobokštelis iki 20 m' },
];
---
<section class="svcs" id="paslaugos" aria-labelledby="svcs-h">
  <div class="wrap">
    <div class="svcs__head">
      <div>
        <p class="kick">Paslaugos ir kainos</p>
        <h2 id="svcs-h">Ką darome ir <span class="hl">kiek kainuoja</span></h2>
      </div>
      <p class="lead">Kainos „nuo“. Preliminarią sumą pasakome pagal nuotraukas.</p>
    </div>

    <ul role="list" class="tiles5">
      {tiles.map((t, i) => (
        <li class:list={['tile5', 'rv', { 'tile5--big': i === 0 }]} style={`--i:${i}`}>
          <a href={`/paslaugos/${t.slug}`}>
            <div class="tile5__ph fill"><Photo name={t.foto} alt={t.alt} sizes={i === 0 ? '(max-width: 760px) 100vw, 50vw' : '(max-width: 760px) 100vw, 25vw'} position={t.pos} /></div>
            <div class="tile5__txt">
              <span class="ico-c tile5__ic" style="--cs:64px"><img src={`${I}/${ico[t.slug]}-160.png`} alt="" width="46" height="46" loading="lazy" /></span>
              <h3><span class="tag tile5__name">{t.h}</span></h3>
              <p class="tile5__price">{kaina[t.slug] || by[t.slug].kaina}</p>
              <p class="tile5__p">{eil[t.slug]}</p>
              <span class="tile5__go">Plačiau</span>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="board5">
      <div class="board5__top">
        <p class="board5__title">Kainoraštis</p>
      </div>
      <div class="board5__cols">
        {grupes.map((g) => (
          <div class="board5__col">
            <h3 class="board5__h">{g.pavadinimas}</h3>
            <ul role="list">
              {g.slugs.map((s) => (
                <li>
                  <a href={`/paslaugos/${s}`} class="board5__row">
                    <img class="board5__ic" src={`${I}/${ico[s]}-160.png`} alt="" width="40" height="40" loading="lazy" />
                    <span class="board5__name">{by[s].pavadinimas}</span>
                    <span class="board5__line">{eil[s]}</span>
                    <span class="board5__price">{kaina[s] || by[s].kaina}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <p class="board5__foot">Valandinis darbas nuo 20 €/h. <a href="/kainos">Kas lemia kainą</a> · <a href="/paslaugos">Visos paslaugos</a></p>
    </div>
  </div>
</section>

<style>
  .svcs { padding-block: clamp(64px, 7vw, 112px); background: var(--paper); }
  .svcs__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 20px 48px; align-items: end; margin-bottom: clamp(30px, 4vw, 52px); }
  .svcs__head h2 { color: var(--spruce-900); margin-top: 8px; }
  .tiles5 { display: grid; grid-template-columns: 1.25fr 1fr 1fr; gap: clamp(16px, 2vw, 26px); }
  .tile5 a { position: relative; display: block; height: 100%; min-height: clamp(420px, 38vw, 540px); border-radius: var(--r-lg); overflow: hidden; color: #fff; box-shadow: var(--sh-2); isolation: isolate; }
  .tile5__ph { position: absolute; inset: 0; z-index: -2; }
  .tile5__ph :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .tile5 a::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(15,46,35,.05) 25%, rgba(15,46,35,.55) 58%, rgba(11,35,27,.92) 100%); }
  .tile5__txt { position: absolute; left: 0; right: 0; bottom: 0; padding: 22px clamp(18px, 2vw, 28px) 24px; display: grid; gap: 10px; justify-items: start; }
  .tile5__ic { margin-bottom: 4px; }
  .tile5 h3 { margin: 0; }
  .tile5__name { font-size: clamp(1.1rem, 1rem + .5vw, 1.45rem); transition: transform .35s ease; }
  .tile5__price { font-family: var(--display); font-weight: 800; font-size: 1.5rem; color: var(--gold); line-height: 1; }
  .tile5__p { color: #E5EEE9; font-size: 1.02rem; line-height: 1.45; max-width: 26em; }
  .tile5__go { font-weight: 800; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile5 a:hover .tile5__ph :global(img) { transform: scale(1.06); }
    .tile5 a:hover .tile5__name { transform: rotate(-2deg) translateX(4px); }
  }

  .board5 { margin-top: clamp(28px, 3vw, 44px); background: var(--spruce-50); border-radius: var(--r-lg); padding: clamp(22px, 3vw, 40px); border: 1px solid var(--line); }
  .board5__top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .board5__title { font-family: var(--display); font-weight: 800; font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); color: var(--spruce-900); }
  .board5__src { font-size: .92rem; color: var(--ink-2); }
  .board5__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(16px, 2.4vw, 36px); }
  .board5__h { font-family: var(--display); font-size: .95rem; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--orange-ink); padding-bottom: 10px; border-bottom: 2px solid var(--spruce-900); margin-bottom: 4px; }
  .board5__row { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; grid-template-areas: 'ic name price' 'ic line line'; gap: 0 12px; align-items: center; padding: 12px 8px; margin-inline: -8px; border-radius: 10px; border-bottom: 1px dashed var(--line); transition: background var(--t); }
  .board5__row:hover { background: #fff; }
  .board5__ic { grid-area: ic; width: 40px; height: 40px; object-fit: contain; }
  .board5__name { grid-area: name; font-weight: 750; color: var(--spruce-900); line-height: 1.25; }
  .board5__row:hover .board5__name { color: var(--orange-ink); }
  .board5__line { grid-area: line; font-size: .92rem; color: var(--ink-2); line-height: 1.35; }
  .board5__price { grid-area: price; font-family: var(--display); font-weight: 800; color: var(--orange-ink); white-space: nowrap; }
  .board5__foot { margin-top: 18px; color: var(--ink-2); }
  .board5__foot a { color: var(--spruce-900); font-weight: 750; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  @media (max-width: 1000px) { .tiles5 { grid-template-columns: 1fr 1fr; } .tile5--big { grid-column: 1 / -1; } .svcs__head { grid-template-columns: 1fr; } }
  @media (max-width: 760px) { .board5__cols { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .tiles5, .board5__cols { grid-template-columns: 1fr; } .tile5 a { min-height: 400px; } }
</style>
