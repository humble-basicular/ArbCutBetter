---
/* Spauda: LRT.lt interviu (2020-12-19) ir Valstietis.lt. Citatos tiksliai iš straipsnių. */
import { lrt, valstietis } from '@data/spauda.js';
import Photo from '../Photo.astro';
import Mark from '../Mark.astro';
const c = lrt.citatos;
---
<section class="press" aria-labelledby="press-h">
  <div class="press__in">
  <div class="press__phw rv"><div class="press__ph ph">
    <Photo name="maumedis-ziema" alt="Arboristas aukštai nugenėto maumedžio viršūnėje žiemą" sizes="(max-width: 860px) 100vw, 40vw" position="50% 18%" />
  </div></div>
  <div class="press__body">
    <p class="kick">Interviu ir straipsniai</p>
    <p class="press__src"><span class="press__pub"><Mark name="lrt" height={30} /></span> <span>{lrt.dataTekstu} · kalbino {lrt.autorius}</span></p>
    <h2 id="press-h" class="sr-only">Apie Mantą rašė LRT.lt ir Valstietis.lt</h2>
    <blockquote class="press__big">
      <p>„{c.klaidos}“</p>
    </blockquote>
    <p class="press__by">Mantas Gerulis, apie arboristo darbą</p>

    <dl class="press__facts">
      <div>
        <dt><span data-count="56">56</span> m</dt>
        <dd>Aukščiausias Manto darbas. „Tai buvo Vilniuje, plastiko gamyklos pastatas.“</dd>
      </div>
      <div>
        <dt data-count="120">120</dt>
        <dd>medžių rūšių, kurias Mantas turėjo mokėti apibūdinti ir išvardyti lotyniškai ir lietuviškai.</dd>
      </div>
    </dl>

    <div class="press__pair">
      <blockquote><p>„{c.vienam}“</p></blockquote>
      <blockquote><p>„{c.kolega}“</p></blockquote>
    </div>
    <blockquote class="press__rope"><p>„{c.virves}“</p></blockquote>

    <a class="link-arrow" href={lrt.url} target="_blank" rel="noopener">Skaityti visą interviu LRT.lt<span class="sr-only"> (atsidaro naujame lange)</span></a>

    <aside class="press__val" aria-label="Valstietis.lt">
      <p class="press__pub press__pub--sm"><Mark name="valstietis" height={26} /></p>
      <blockquote><p>„{valstietis.citatos.neatsisake}“</p></blockquote>
      <p class="press__val-2">Apie brandžius, sveikus medžius Mantas ten sako: <q>{valstietis.citatos.azuolas}</q></p>
      <a href={valstietis.url} target="_blank" rel="noopener">Skaityti Valstietis.lt<span class="sr-only"> (atsidaro naujame lange)</span></a>
    </aside>
  </div>
  </div>
</section>
<style>
  .press { background: var(--spruce-50); padding-block: clamp(72px, 8vw, 128px); overflow-x: clip; }
  .press__in { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter); display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .press__phw { position: sticky; top: calc(var(--header-h) + 24px); }
  .press__phw::before { content: ''; position: absolute; inset: 24px -18px -18px 24px; background: var(--spruce-900); border-radius: var(--r-lg); }
  .press__ph { position: relative; aspect-ratio: 4 / 5; border-radius: var(--r-lg); border: 8px solid #fff; box-shadow: var(--sh-3); }
  .press__body { display: grid; gap: 22px; justify-items: start; }
  .press__src { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-weight: 650; color: var(--ink-2); }
  .press__pub { display: inline-flex; background: #fff; padding: 10px 14px; border-radius: 10px; box-shadow: var(--sh-1); }
  .press__big { font-family: var(--display); font-weight: 800; font-variation-settings: 'opsz' 72, 'wdth' 94; font-size: clamp(1.7rem, 1.1rem + 2.2vw, 3rem); line-height: 1.08; letter-spacing: -.02em; color: var(--spruce-900); position: relative; padding-left: .1em; }
  .press__by { font-family: var(--hand); font-size: 1.7rem; color: var(--orange-ink); margin-top: -8px; }
  .press__facts { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; width: 100%; }
  .press__facts div { background: #fff; border-radius: var(--r); padding: 20px 22px; box-shadow: var(--sh-1); }
  .press__facts dt { font-family: var(--display); font-weight: 800; font-size: clamp(2.6rem, 2rem + 2vw, 3.8rem); line-height: 1; color: var(--orange); letter-spacing: -.03em; }
  .press__facts dd { margin-top: 8px; color: var(--ink-2); line-height: 1.45; }
  .press__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .press__pair blockquote, .press__rope { font-size: 1.1rem; line-height: 1.5; color: var(--ink); border-left: 4px solid var(--gold); padding-left: 16px; }
  .press__val { width: 100%; background: var(--spruce-900); color: #fff; border-radius: var(--r-lg); padding: clamp(20px, 3vw, 32px); display: grid; gap: 12px; box-shadow: var(--sh-2); }
  .press__pub--sm { background: #fff; justify-self: start; }
  .press__val blockquote { font-family: var(--display); font-weight: 700; font-size: 1.35rem; line-height: 1.25; }
  .press__val-2 { color: var(--on-dark-2); }
  .press__val a, .press .link-arrow { font-weight: 800; }
  .press__val a { color: #fff; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  @media (max-width: 900px) { .press__in { grid-template-columns: 1fr; } .press__phw { position: relative; top: 0; max-width: 420px; margin-right: 14px; } .press__phw::before { inset: 14px -10px -10px 14px; } .press__pair { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .press__facts { grid-template-columns: 1fr; } }
</style>
