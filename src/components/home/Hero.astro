---
/* Pirmas ekranas: tekstas kairėje, aukšta reali nuotrauka nukirsto kampo rėme dešinėje,
   Manto iškarpa per nuotraukos kraštą (prekės ženklo elementas #2), trumpa forma kerta apatinį kraštą. */
import { Image } from 'astro:assets';
import { site } from '@data/site.js';
import { atsiliepimuKiekis, atsiliepimuVidurkis, patirtisMetai } from '@data/atsiliepimai.js';
import { lrt } from '@data/spauda.js';
import Photo from '../Photo.astro';
import Mark from '../Mark.astro';
import QuoteForm from '../QuoteForm.astro';
import cutout from '../../assets/cutout/mantas-cutout.png';
const rating = atsiliepimuVidurkis.toFixed(1).replace('.', ',');
---
<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__txt">
      <p class="hero__who">Arboristas aukštalipys <strong>{site.savininkas}</strong> su komanda</p>
      <h1>Medžių pjovimas ir darbai aukštyje Kaune</h1>
      <p class="hero__lead">Pavojingus medžius prie namų, laidų ir kapų pjauname dalimis ir nuleidžiame virvėmis. Turime savo autobokštelį iki 20&nbsp;m. Važiuojame iki 200&nbsp;km nuo Kauno.</p>
      <div class="hero__call">
        <a class="hero__tel" href={site.telefonasHref} data-loc="hero-call">
          <span class="hero__tel-l">Skambinkite</span><span class="hero__tel-n">{site.telefonas}</span>
        </a>
        <p class="hero__hours"><strong>Kasdien 08:00–18:00</strong> <br />ir savaitgaliais</p>
      </div>
      <ul role="list" class="hero__proof">
        <li><a href={site.atsiliepimai.profilis} target="_blank" rel="noopener"><Mark name="paslaugos" height={38} /> <span><b>{rating}</b> iš 5 · {atsiliepimuKiekis} atsiliepimai<span class="sr-only"> Paslaugos.lt (atsidaro naujame lange)</span></span></a></li>
        <li><span><b>{patirtisMetai} metų</b> patirtis</span></li>
        <li><a href={lrt.url} target="_blank" rel="noopener"><span class="sr-only">Apie Mantą rašė </span><Mark name="lrt" height={30} /><span class="sr-only"> (atsidaro naujame lange)</span></a></li>
      </ul>
    </div>

    <div class="hero__vis">
      <div class="hero__ph ph cut">
        <Photo name="autobokstelis-prie-namo" alt="" sizes="(max-width: 1100px) 100vw, 46vw" widths={[640, 960, 1280, 1667]} loading="eager" fetchpriority="high" position="58% 40%" />
      </div>
      <Image class="hero__man" src={cutout} alt="" widths={[300, 460, 640]} sizes="(max-width: 700px) 46vw, 320px" format="webp" quality={82} loading="eager" />
    </div>
    <aside class="hero__card cut" aria-labelledby="hc-h">
      <div class="hero__card-h"><h2 id="hc-h">Kiek kainuos?</h2>
      <p class="hero__card-p">Palikite numerį. Perskambinsime darbo valandomis.</p></div>
      <QuoteForm variant="short" id="hero-form" prefix="h" />
      <div class="hero__pics">
        <p><strong>Kainą pasakome pagal nuotraukas.</strong> Nufotografuokite medį ir atsiųskite:</p>
        <div class="hero__pics-btns">
          <a class="btn btn--ink btn--sm" href={site.smsHref} data-loc="hero-sms">SMS</a>
          <a class="btn btn--line btn--sm" href={`mailto:${site.elPastas}?subject=${encodeURIComponent('Medžio nuotraukos kainai')}`} data-loc="hero-mail">El. paštu</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero { position: relative; background: var(--paper); z-index: 2; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: clamp(24px, 3vw, 56px); align-items: stretch; padding-top: clamp(24px, 3vw, 48px); }
  .hero__txt { display: grid; gap: 22px; align-content: center; padding-block: clamp(8px, 2vw, 32px) 64px; }
  .hero__who { font-size: clamp(1.08rem, 1rem + .3vw, 1.25rem); color: var(--ink-2); }
  .hero__who strong { color: var(--ink); }
  .hero h1 { font-size: clamp(2.3rem, 1.2rem + 3.4vw, 4.4rem); line-height: 1.03; color: var(--spruce-900); max-width: 15ch; }
  .hero__lead { font-size: clamp(1.12rem, 1.04rem + .35vw, 1.3rem); line-height: 1.5; color: var(--ink-2); max-width: 30em; }

  .hero__call { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 24px; margin-top: 4px; }
  .hero__tel { display: inline-grid; padding: 14px 26px 16px; background: var(--orange); color: #fff; border-radius: var(--radius); line-height: 1.05; transition: background var(--t); }
  .hero__tel:hover { background: var(--orange-ink); }
  .hero__tel-l { font-weight: 700; font-size: 1.2rem; }
  .hero__tel-n { font-stretch: var(--wide); font-weight: 800; font-size: clamp(2rem, 1.3rem + 2.2vw, 3.2rem); letter-spacing: -.015em; white-space: nowrap; }
  .hero__hours { line-height: 1.35; color: var(--ink-2); }
  .hero__hours strong { color: var(--ink); }

  .hero__proof { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 6px; font-size: 1.05rem; color: var(--ink-2); }
  .hero__proof li { display: flex; align-items: center; min-height: 32px; }
  .hero__proof a { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  .hero__proof a:hover { text-decoration-color: var(--orange); }
  .hero__proof b { color: var(--spruce-900); font-stretch: var(--wide); font-weight: 800; }

  .hero__vis { position: relative; min-height: min(78vh, 720px); }
  .hero__ph { position: absolute; top: 0; right: 0; bottom: 0; left: 26%; }
  .hero__ph :global(img) { position: absolute; inset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__ph :global(img) { animation: kb 22s ease-out both; }
    @keyframes kb { from { transform: scale(1.08); } to { transform: scale(1); } }
  }
  .hero__man { position: absolute; left: 0; bottom: 0; width: auto; height: 86%; max-height: 640px; pointer-events: none; }

  .hero__card { grid-column: 1 / -1; position: relative; z-index: 3; margin-bottom: -88px; background: var(--paper); padding: 26px 30px; display: grid; grid-template-columns: minmax(0, .62fr) minmax(0, 2.3fr) minmax(250px, .78fr); gap: 20px 28px; align-items: center; box-shadow: 0 24px 60px -24px rgba(15, 42, 32, .4); }
  .hero__card h2 { font-size: clamp(1.6rem, 1.4rem + .8vw, 2.05rem); color: var(--spruce-900); }
  .hero__card-p { color: var(--ink-2); margin-top: 6px; }
  .hero__card :global(.qf) { grid-template-columns: minmax(0, .9fr) minmax(0, 1.5fr) auto; align-items: end; gap: 12px; }
  .hero__card :global(.qf__err), .hero__card :global(.qf__done) { grid-column: 1 / -1; }
  .hero__card :global(.qf--short textarea) { min-height: 80px; height: 80px; }
  .hero__card :global(.qf__btn) { min-height: 54px; white-space: nowrap; }
  .hero__pics { display: grid; gap: 10px; font-size: 1rem; color: var(--ink-2); padding-left: 28px; box-shadow: inset 1px 0 0 var(--line); }
  .hero__pics strong { color: var(--ink); }
  .hero__pics-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .hero__pics-btns .btn { padding-inline: 10px; white-space: nowrap; }

  /* Nešiojamuose ekranuose skambinimo mygtukas turi tilpti pirmame ekrane */
  @media (min-width: 1101px) and (max-height: 900px) {
    .hero__txt { gap: 16px; padding-top: 0; }
    .hero h1 { font-size: clamp(2.6rem, 7.2vh, 4rem); }
    .hero__tel-n { font-size: 2.6rem; }
  }
  @media (max-width: 1240px) and (min-width: 1101px) {
    .hero__card { grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); }
    .hero__pics { grid-column: 1 / -1; padding-left: 0; box-shadow: none; grid-template-columns: auto 1fr; align-items: center; }
  }

  @media (max-width: 1100px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__txt { padding-bottom: 28px; }
    .hero h1 { max-width: 16ch; }
    .hero__vis { min-height: 0; aspect-ratio: 6 / 5; }
    .hero__ph { left: 22%; }
    .hero__man { height: 92%; }
    .hero__card { grid-template-columns: 1fr; margin-top: -64px; margin-left: auto; width: min(100%, 600px); margin-bottom: -56px; }
    .hero__card :global(.qf) { grid-template-columns: 1fr; }
    .hero__card :global(.qf--short textarea) { height: auto; min-height: 76px; }
    .hero__pics { padding-left: 0; padding-top: 14px; box-shadow: inset 0 1px 0 var(--line); }
  }
  @media (max-width: 700px) {
    .hero__txt { gap: 16px; }
    .hero__lead { font-size: 1.1rem; }
    .hero__call { gap: 8px; }
    .hero__tel { width: 100%; justify-items: center; padding: 12px 16px 14px; }
    .hero__tel-n { font-size: clamp(1.85rem, .9rem + 5.6vw, 2.4rem); }
    .hero__hours { width: 100%; text-align: center; }
    .hero__hours br { display: none; }
    .hero__proof { gap: 8px 20px; font-size: 1rem; }
    .hero__vis { aspect-ratio: 1 / 1.08; margin-inline: calc(var(--gutter) * -1) 0; }
    .hero__ph { left: 30%; }
    .hero__man { height: 88%; }
    .hero__card { padding: 22px 18px; margin-top: -48px; width: calc(100% - 10px); }
  }
  @media (max-width: 600px) { .hero__pics { display: none; } }
</style>
