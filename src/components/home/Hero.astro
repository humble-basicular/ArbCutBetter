---
/* Pirmas ekranas: visa plotį užimanti reali nuotrauka (autobokštelis prie namo),
   didelė antraštė, milžiniškas telefonas, trumpa forma kortelėje. */
import { site } from '@data/site.js';
import { atsiliepimuKiekis, atsiliepimuVidurkis, patirtisMetai } from '@data/atsiliepimai.js';
import { lrt } from '@data/spauda.js';
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
import QuoteForm from '../QuoteForm.astro';
const rating = atsiliepimuVidurkis.toFixed(1).replace('.', ',');
---
<section class="hero">
  <div class="hero__bg" aria-hidden="true">
    <Photo name="autobokstelis-prie-namo" alt="" sizes="100vw" widths={[640, 960, 1280, 1667]} loading="eager" fetchpriority="high" position="60% 52%" />
  </div>
  <div class="wrap hero__grid">
    <div class="hero__txt">
      <p class="hero__who">Arboristas aukštalipys <strong>{site.savininkas}</strong> su komanda</p>
      <h1>Medžių pjovimas ir darbai aukštyje Kaune</h1>
      <p class="hero__lead">Pavojingus medžius prie namų, laidų ir kapų pjauname dalimis ir nuleidžiame virvėmis. Turime savo autobokštelį iki 20&nbsp;m. Važiuojame iki 200&nbsp;km nuo Kauno.</p>
      <div class="hero__call">
        <a class="hero__tel" href={site.telefonasHref} data-loc="hero-call">
          <Icon name="phone" size={40} />
          <span class="hero__tel-t"><span class="hero__tel-l">Skambinkite</span><span class="hero__tel-n">{site.telefonas}</span></span>
        </a>
        <p class="hero__hours"><strong>Kasdien 08:00–18:00</strong> <br />ir savaitgaliais</p>
      </div>
      <ul role="list" class="hero__proof">
        <li><a href={site.atsiliepimai.profilis} target="_blank" rel="noopener"><span class="hero__stars" aria-hidden="true">★★★★★</span> <b>{rating}</b> iš 5 · {atsiliepimuKiekis} atsiliepimai Paslaugos.lt</a></li>
        <li><b>{patirtisMetai} metų</b> patirtis</li>
        <li>Apie Mantą rašė <a href={lrt.url} target="_blank" rel="noopener"><b>LRT.lt</b></a></li>
      </ul>
    </div>

    <aside class="hero__card" aria-labelledby="hc-h">
      <h2 id="hc-h">Kiek kainuos?</h2>
      <p class="hero__card-p">Palikite numerį. Perskambinsime darbo valandomis.</p>
      <QuoteForm variant="short" id="hero-form" prefix="h" />
      <div class="hero__pics">
        <p><strong>Kainą pasakome pagal nuotraukas.</strong> Nufotografuokite medį ir atsiųskite:</p>
        <div class="hero__pics-btns">
          <a class="btn btn--ink btn--sm" href={site.smsHref} data-loc="hero-sms"><Icon name="sms" size={20} /> SMS</a>
          <a class="btn btn--line btn--sm" href={`mailto:${site.elPastas}?subject=${encodeURIComponent('Medžio nuotraukos kainai')}`} data-loc="hero-mail"><Icon name="mail" size={20} /> El. paštu</a>
        </div>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; background: var(--f0); color: var(--cream); }
  .hero__bg { position: absolute; inset: 0; z-index: -1; overflow: hidden; }
  .hero__bg :global(img), .hero__bg :global(picture) { width: 100%; height: 100%; object-fit: cover; filter: brightness(1.12) contrast(1.05); }
  .hero__bg::after {
    content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 26, 20, .95) 0%, rgba(14, 26, 20, .9) 36%, rgba(14, 26, 20, .55) 49%, rgba(14, 26, 20, .12) 64%, rgba(14, 26, 20, .08) 100%),
      linear-gradient(0deg, rgba(14, 26, 20, .6) 0%, rgba(14, 26, 20, 0) 26%);
  }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: clamp(32px, 5vw, 80px); align-items: start; padding-block: clamp(40px, 5vw, 72px) 0; min-height: calc(100svh - var(--header-h) - 40px); }
  .hero__txt { display: grid; gap: 22px; align-content: start; padding-bottom: clamp(40px, 5vw, 64px); }
  .hero__who { font-size: clamp(1.1rem, 1rem + .4vw, 1.35rem); color: var(--on-dark-2); }
  .hero__who strong { color: var(--cream); }
  .hero h1 { font-size: clamp(2.9rem, 1.2rem + 5.4vw, 6.4rem); line-height: 1.12; max-width: 11.5ch; font-weight: 700; }
  .hero__lead { font-size: clamp(1.15rem, 1.04rem + .45vw, 1.4rem); line-height: 1.45; color: #E3E9E4; max-width: 27em; }

  .hero__call { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; margin-top: 6px; }
  .hero__tel { display: inline-flex; align-items: center; gap: 18px; padding: 16px 28px 16px 22px; background: var(--rust); color: var(--f0); border-radius: var(--radius); box-shadow: 0 18px 40px -16px rgba(0,0,0,.6); transition: background var(--t); }
  .hero__tel:hover { background: var(--rust-h); }
  .hero__tel-t { display: grid; line-height: 1.12; }
  .hero__tel-l { font-family: var(--display); font-weight: 600; text-transform: uppercase; font-size: 1.15rem; letter-spacing: .02em; }
  .hero__tel-n { font-family: var(--display); font-weight: 700; font-size: clamp(2.2rem, 1.2rem + 2.8vw, 3.6rem); letter-spacing: -.005em; white-space: nowrap; }
  .hero__hours { line-height: 1.3; color: var(--on-dark-2); }
  .hero__hours strong { color: var(--cream); }

  .hero__proof { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 8px; font-size: 1.05rem; color: var(--on-dark-2); }
  .hero__proof b { color: var(--cream); }
  .hero__proof a { text-decoration: underline; text-decoration-color: rgba(240, 169, 74, .6); text-underline-offset: 4px; }
  .hero__proof a:hover { color: var(--cream); }
  .hero__stars { color: var(--amber); letter-spacing: .05em; }

  .hero__card { position: relative; z-index: 2; margin-bottom: clamp(32px, 4vw, 56px); background: var(--cream); color: var(--text); padding: 30px 30px 28px; border-top: 8px solid var(--rust); box-shadow: var(--shadow); display: grid; gap: 14px; }
  .hero__card :focus-visible { outline-color: var(--rust); }
  .hero__card h2 { font-size: clamp(2.2rem, 1.8rem + 1.2vw, 3rem); }
  .hero__card-p { color: var(--text-2); margin-top: -4px; }
  .hero__pics { border-top: 2px solid var(--line); padding-top: 16px; display: grid; gap: 12px; font-size: 1.02rem; color: var(--text-2); }
  .hero__pics strong { color: var(--text); }
  .hero__pics-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  @media (max-width: 1100px) {
    .hero__grid { grid-template-columns: 1fr; min-height: 0; }
    .hero__card { margin-bottom: 40px; max-width: 560px; margin-top: -8px; }
    .hero { padding-bottom: 0; }
    .hero__bg::after { background: linear-gradient(90deg, rgba(14, 26, 20, .95) 0%, rgba(14, 26, 20, .75) 60%, rgba(14, 26, 20, .4) 100%), linear-gradient(0deg, var(--f0) 0%, rgba(14, 26, 20, 0) 40%); }
  }

  @media (min-width: 701px) and (max-width: 1100px) {
    .hero h1 { max-width: 18ch; }
  }

  @media (max-width: 600px) { .hero__pics { display: none; } }
  @media (max-width: 700px) {
    .hero__bg { bottom: auto; height: 380px; }
    .hero__bg :global(img) { object-position: 62% 50% !important; }
    .hero__bg::after { background: linear-gradient(180deg, rgba(14, 26, 20, .35) 0%, rgba(14, 26, 20, .55) 45%, var(--f0) 100%); }
    .hero__grid { padding-top: 120px; gap: 0; }
    .hero__txt { gap: 16px; padding-bottom: 28px; }
    .hero__who { font-size: 1.05rem; color: #E3E9E4; }
    .hero h1 { font-size: clamp(2.5rem, 1.2rem + 7.2vw, 3.4rem); text-shadow: 0 2px 18px rgba(0,0,0,.35); }
    .hero__lead { font-size: 1.12rem; }
    .hero__call { gap: 8px; }
    .hero__tel { width: 100%; justify-content: center; padding: 14px 16px; gap: 12px; }
    .hero__tel :global(svg) { width: 30px; height: 30px; }
    .hero__tel-n { font-size: clamp(2rem, 1rem + 5.4vw, 2.5rem); }
    .hero__tel-l { font-size: 1rem; }
    .hero__hours { width: 100%; text-align: center; }
    .hero__hours br { display: none; }
    .hero__proof { gap: 6px 18px; font-size: 1rem; }
    .hero__card { padding: 22px 18px; margin-inline: calc(var(--gutter) * -1 + 8px); }
  }
</style>
