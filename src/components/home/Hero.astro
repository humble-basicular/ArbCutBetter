---
/* v5 pirmas ekranas (14 žingsnių: 1, 2, 3, 6).
   Eglės juosta su medžio rievėmis, pasvirusi auksinė etiketė, didelis H1, skambutis ir kaina,
   oficialūs įrodymai. Dešinėje — autobokštelis prie namo ant oranžinio poslinkio bloko,
   aukščio liniuotė 0–20 m ir didelė švari Manto iškarpa. Apačia — lankas su virve.
   Trumpa forma (Kiek kainuos?) kerta lanką ir pereina į kitą juostą. */
import { Image } from 'astro:assets';
import { site } from '@data/site.js';
import { lrt, valstietis } from '@data/spauda.js';
import Photo from '../Photo.astro';
import Mark from '../Mark.astro';
import QuoteForm from '../QuoteForm.astro';
import RatingUnit from '../v5/RatingUnit.astro';
import Seal from '../v5/Seal.astro';
import Stars from '../v5/Stars.astro';
import cutout from '../../assets/cutout/mantas-v5.png';
import { PREVIEW } from '@data/site.js';
const I = '/assets/v5-brand/raster/icons';
---
<section class="hero" data-parallax-host>
  <div class="hero__rings" data-parallax="0.12" aria-hidden="true"></div>
  <div class="wrap hero__grid">
    <div class="hero__txt">
      <p class="hero__who tag rv-tag">Arboristas aukštalipys <strong>{site.savininkas}</strong> su komanda</p>
      <h1>Medžių pjovimas ir darbai <span class="hero__h-hl">aukštyje</span> Kaune</h1>
      <p class="hero__lead">Pavojingus medžius prie namų, laidų ir kapų pjauname dalimis ir nuleidžiame virvėmis. Turime savo autobokštelį iki 20&nbsp;m. Važiuojame iki {site.zona.km}&nbsp;km nuo Kauno.</p>
      <div class="hero__acts">
        <a class="btn btn--primary btn--lg hero__tel" href={site.telefonasHref} data-loc="hero-call">
          <span class="ico-c" style="--cs:42px"><img src={`${I}/ui-phone-160.png`} alt="" width="30" height="30" /></span>
          <span class="hero__tel-t"><small>Skambinkite kasdien 08–18, ir savaitgaliais</small><span class="btn__num">{site.telefonas}</span></span>
        </a>
        <button type="button" class="btn btn--white btn--lg" data-quote>Gauti kainą</button>
      </div>
      <ul role="list" class="hero__proof">
        <li><RatingUnit variant="card" loc="hero-rating" /></li>
        <li class="hero__seal"><Seal /></li>
      </ul>
    </div>

    <div class="hero__vis" aria-hidden="true">
      <div class="hero__block"></div>
      <div class="hero__photo fill">
        <Photo name="autobokstelis-prie-namo" alt="" sizes="(max-width: 960px) 92vw, 40vw" widths={[640, 960, 1280, 1667]} loading="eager" position="62% 58%" />
      </div>
      <p class="hero__lift">
        <span class="ico-c" style="--cs:58px"><img src={`${I}/svc-bokstelis-160.png`} alt="" width="44" height="44" /></span>
        <span><b>Nuosavas autobokštelis</b><span class="hero__lift-n">iki <span data-count="20">20</span>&nbsp;m</span></span>
      </p>
      <div class="hero__scale"><span>20 m</span><span>15</span><span>10</span><span>5</span><span>0</span></div>
      <Image class="hero__man" src={cutout} alt="" widths={[360, 540, 720, 960]} sizes="(max-width: 960px) 62vw, 400px" format="webp" quality={84} loading="eager" fetchpriority="high" data-parallax="-0.04" />
    </div>
  </div>
  <div class="hero__arc" data-rope aria-hidden="true"></div>
</section>

<section class="dock" aria-labelledby="hc-h">
  <div class="wrap">
    <div class="dock__card">
      <h2 id="hc-h" class="dock__tab tag tag--orange">Kiek kainuos?</h2>
      <div class="dock__grid">
        <p class="dock__p">Aprašykite darbą. Susisieksime ir pasakysime preliminarią kainą.</p>
        <QuoteForm variant="short" id="hero-form" prefix="h" />
        <div class="dock__pics">
          <p><strong>Patogiau žinute?</strong> Nuotraukas galite atsiųsti ir taip:</p>
          <div class="dock__btns">
            <a class="btn btn--ink btn--sm" href={site.smsHref} data-loc="hero-sms"><img class="ico" src={`${I}/ui-sms-160.png`} alt="" width="24" height="24" style="--is:24px;filter:brightness(0) invert(1)" />SMS</a>
            <a class="btn btn--line btn--sm" href={`mailto:${site.elPastas}?subject=${encodeURIComponent('Nuotraukos kainai')}`} data-loc="hero-mail"><img class="ico" src={`${I}/ui-mail-160.png`} alt="" width="24" height="24" style="--is:24px" />El. paštu</a>
          </div>
        </div>
      </div>
    </div>

    <div class="press-strip">
      <p class="press-strip__h">Apie Mantą ir jo darbą</p>
      <ul role="list" class="press-strip__list">
        <li><a href={lrt.url} target="_blank" rel="noopener"><Mark name="lrt" height={30} /><span>Interviu, {lrt.dataTekstu}</span><span class="sr-only"> (atsidaro naujame lange)</span></a></li>
        <li><a href={valstietis.url} target="_blank" rel="noopener"><Mark name="valstietis" height={26} /><span>Straipsnis su Manto patarimais</span><span class="sr-only"> (atsidaro naujame lange)</span></a></li>
        {PREVIEW && <li class="press-strip__ph"><span>Įrangos gamintojų logotipai</span><small>Peržiūra: laukiame, kokią įrangą naudoja Mantas</small></li>}
      </ul>
    </div>
  </div>
</section>

<script>
  /* Žiedų tekstūra: tik kai puslapis įkeltas ir pats vaizdas parsiųstas (kitaip trumpam matytųsi baltas plotas) */
  const rings = document.querySelector('.hero__rings');
  const on = () => {
    const img = new Image();
    img.onload = () => rings && rings.classList.add('is-on');
    img.src = '/assets/v5-brand/texture/rings-hero.webp';
  };
  if (rings) document.readyState === 'complete' ? on() : window.addEventListener('load', on, { once: true });
</script>

<style>
  .hero { position: relative; background: var(--spruce-900); color: #fff; overflow: hidden; isolation: isolate; padding-top: clamp(28px, 3vw, 44px); padding-bottom: clamp(120px, 10vw, 150px); }
  /* Dekoratyvi tekstūra (balta + alfa) piešiama kaip kaukė ir įjungiama tik po puslapio įkėlimo (žr. skriptą žemiau),
     kad nekonkuruotų su pirmo ekrano nuotraukomis ir nebūtų LCP elementas. Be JS jos tiesiog nėra. */
  .hero__rings { position: absolute; inset: -120px -10% -120px -10%; background: #fff; -webkit-mask: none 72% 58% / 2400px auto no-repeat; mask: none 72% 58% / 2400px auto no-repeat; opacity: 0; transition: opacity .9s ease; z-index: -1; pointer-events: none; }
  .hero__rings.is-on { -webkit-mask-image: url('/assets/v5-brand/texture/rings-hero.webp'); mask-image: url('/assets/v5-brand/texture/rings-hero.webp'); opacity: .3; }
  @media (prefers-reduced-motion: reduce) { .hero__rings { transition: none; } }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); gap: clamp(24px, 3vw, 48px); align-items: center; }
  .hero__txt { position: relative; z-index: 2; display: grid; justify-items: start; gap: 18px; }
  .hero__who { font-size: clamp(.9rem, .82rem + .3vw, 1.08rem); }
  .hero__who strong { font-weight: 800; }
  .hero h1 { color: #fff; max-width: 12em; font-size: clamp(2.5rem, 1.4rem + 3.4vw, 4.6rem); }
  .hero__h-hl { color: var(--gold); position: relative; white-space: nowrap; }
  .hero__h-hl::after { content: ''; position: absolute; left: 2%; right: -2%; bottom: -.08em; height: .14em; border-radius: 99px; background: var(--orange); transform: rotate(-1.2deg); }
  .hero__lead { font-size: clamp(1.08rem, 1rem + .3vw, 1.22rem); line-height: 1.5; color: var(--on-dark-2); max-width: 34em; }
  .hero__acts { display: flex; flex-wrap: wrap; gap: 14px; }
  .hero__tel { padding: 10px 26px 10px 12px; gap: 14px; }
  .hero__tel .ico-c { box-shadow: none; }
  .hero__tel-t { display: grid; text-align: left; line-height: 1.05; }
  .hero__tel-t small { font-family: var(--font); font-size: .8rem; font-weight: 700; opacity: .95; }
  .hero__tel .btn__num { font-size: 1.55rem; }
  .hero__proof { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; margin-top: 2px; }
  .hero__lift { position: absolute; right: -1%; bottom: 3%; z-index: 4; display: flex; align-items: center; gap: 12px; line-height: 1.1; background: #fff; color: var(--spruce-900); padding: 10px 18px 10px 10px; border-radius: 999px; box-shadow: var(--sh-2); transform: rotate(-2deg); }
  .hero__lift .ico-c { box-shadow: none; background: var(--spruce-50); }
  .hero__lift b { display: block; font-size: .88rem; color: var(--ink-2); font-weight: 700; }
  .hero__lift-n { font-family: var(--display); font-weight: 800; font-size: 1.7rem; color: var(--orange-ink); letter-spacing: -.02em; }

  .hero__vis { position: relative; height: clamp(500px, 41vw, 590px); }
  .hero__block { position: absolute; right: -2%; top: 8%; width: 78%; height: 86%; background: var(--orange); border-radius: var(--r-lg); transform: rotate(3deg); }
  .hero__photo { position: absolute; right: 2%; top: 3%; width: 76%; height: 86%; border-radius: var(--r-lg); overflow: hidden; box-shadow: var(--sh-3); border: 6px solid #fff; }
  .hero__photo :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__photo::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,46,35,0) 55%, rgba(15,46,35,.35)); }
  .hero__scale { position: absolute; right: calc(2% + 18px); top: calc(3% + 22px); height: 62%; width: 46px; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-end; padding-right: 14px; font-family: var(--display); font-weight: 800; font-size: .8rem; color: #fff; text-shadow: 0 1px 3px rgba(0,0,0,.6); background: repeating-linear-gradient(180deg, rgba(255,255,255,.85) 0 2px, transparent 2px 12.5%) right / 8px 100% no-repeat, linear-gradient(rgba(255,255,255,.85), rgba(255,255,255,.85)) right / 2px 100% no-repeat; }
  .hero__scale span:first-child { color: var(--gold); font-size: 1rem; }
  .hero__man { position: absolute; left: -6%; bottom: -150px; height: calc(100% + 120px); width: auto; z-index: 3; filter: drop-shadow(0 18px 30px rgba(0,0,0,.35)); }

  .hero__arc { position: absolute; left: -10%; right: -10%; bottom: -150px; height: 260px; background: var(--paper); border-radius: 50% 50% 0 0 / 100% 100% 0 0; border-top: 12px solid var(--orange); z-index: 5; }
  .hero__arc::before { content: ''; position: absolute; inset: -9px 0 0; border-radius: inherit; border-top: 3px dashed rgba(255, 255, 255, .55); }
  @media (prefers-reduced-motion: no-preference) {
    .js .hero__arc { clip-path: inset(0 100% 0 0); transition: clip-path 1.1s ease-out .2s; }
    .js .hero__arc.is-drawn { clip-path: inset(0 0 0 0); }
  }

  /* Forma kerta lanką */
  .dock { position: relative; z-index: 6; margin-top: -112px; padding-bottom: clamp(48px, 5vw, 72px); background: transparent; }
  .dock__card { position: relative; background: #fff; border-radius: var(--r-lg); box-shadow: var(--sh-3); padding: 34px clamp(20px, 3vw, 40px) 26px; }
  .dock__tab { position: absolute; left: clamp(16px, 3vw, 36px); top: -26px; font-size: clamp(1.15rem, 1rem + .6vw, 1.6rem); margin: 0; }
  .dock__grid { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 2.2fr) minmax(0, 1.05fr); gap: clamp(18px, 2.4vw, 36px); align-items: end; }
  .dock__p { font-size: 1.05rem; color: var(--ink-2); align-self: center; }
  .dock__grid :global(.qf--short) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; align-items: start; }
  .dock__grid :global(.qf--short .qf__row) { grid-column: 1 / -1; gap: 12px; }
  .dock__grid :global(.qf--short .qf__foot), .dock__grid :global(.qf--short .qf__files), .dock__grid :global(.qf--short .qf__ts), .dock__grid :global(.qf--short .qf__err), .dock__grid :global(.qf--short .qf__done) { grid-column: 1 / -1; }
  .dock__grid :global(.qf--short textarea) { min-height: 84px; height: 84px; resize: vertical; }
  .dock__pics { border-left: 1px solid var(--line); padding-left: clamp(16px, 2vw, 28px); display: grid; gap: 10px; font-size: .98rem; color: var(--ink-2); }
  .dock__pics strong { color: var(--spruce-900); }
  @media (pointer: coarse) { .dock__btns .btn--ink { display: none; } }
  .dock__btns { display: flex; gap: 10px; flex-wrap: wrap; }

  .press-strip { display: flex; align-items: center; gap: clamp(16px, 3vw, 44px); margin-top: clamp(30px, 3vw, 44px); padding-inline: 6px; flex-wrap: wrap; }
  .press-strip__h { font-family: var(--display); font-weight: 500; text-transform: uppercase; letter-spacing: .16em; font-size: .85rem; color: var(--ink-2); }
  .press-strip__list { display: flex; align-items: center; gap: clamp(18px, 3vw, 48px); flex-wrap: wrap; }
  .press-strip__list a { display: flex; align-items: center; gap: 12px; font-weight: 650; color: var(--ink-2); font-size: .95rem; filter: grayscale(1); opacity: .85; transition: filter var(--t), opacity var(--t); }
  .press-strip__list a:hover { filter: none; opacity: 1; color: var(--spruce-900); }
  .press-strip__ph { display: grid; gap: 2px; padding: 10px 16px; border: 2px dashed #E9A27A; border-radius: 10px; color: var(--orange-ink); font-weight: 700; font-size: .9rem; }
  .press-strip__ph small { font-weight: 600; color: var(--ink-2); }

  @media (max-width: 1180px) {
    .dock__grid { grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr); }
    .dock__p { grid-column: 1 / -1; }
  }
  @media (max-width: 960px) {
    .hero { padding-bottom: 150px; }
    .hero__grid { grid-template-columns: 1fr; }
    .hero__vis { height: 440px; margin-top: 8px; }
    .hero__photo { width: 70%; right: 0; }
    .hero__block { width: 72%; right: -3%; }
    .hero__man { left: 2%; height: calc(100% + 80px); bottom: -110px; }
    .hero__rings { -webkit-mask-position: 60% 80%; mask-position: 60% 80%; }
    .dock__grid { grid-template-columns: 1fr; }
    .dock__pics { border-left: 0; padding-left: 0; border-top: 1px solid var(--line); padding-top: 16px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 26px; }
    .hero__txt { gap: 16px; }
    .hero h1 { font-size: clamp(2.1rem, 1.2rem + 5.4vw, 2.8rem); }
    .hero__acts { width: 100%; display: grid; }
    .hero__acts .btn { width: 100%; }
    .hero__proof { gap: 14px; }
    .hero__seal { order: 3; }
    .hero__vis { height: 380px; }
    .hero__scale { display: none; }
    .hero__lift { right: 0; bottom: -4%; padding: 8px 14px 8px 8px; }
    .hero__lift-n { font-size: 1.4rem; }
    .dock { margin-top: -110px; }
    .dock__grid :global(.qf--short) { grid-template-columns: 1fr; }
    .dock__grid :global(.qf--short .qf__btn) { width: 100%; }
    .dock__card { padding-top: 40px; }
  }
</style>
