---
/* Darbo akimirkos: didelės realios nuotraukos per visą plotį. Parašai — tik tai, kas matyti. */
import Photo from '../Photo.astro';
const m = [
  { foto: 'pjovimas-prie-laidu-homepage-crop', pos: '50% 22%', cap: 'Pušis tarp elektros laidų. Pjaunama nuo viršūnės, dalimis.', cls: 'm--a', sizes: '(max-width: 700px) 100vw, 38vw' },
  { foto: 'du-arboristai-lajoje', pos: '50% 40%', cap: 'Du arboristai didelio medžio lajoje.', cls: 'm--b', sizes: '(max-width: 700px) 70vw, 20vw' },
  { foto: 'pusis-alpinistas', pos: '50% 30%', cap: 'Aukšta pušis virš namų stogų. Darbas su virvėmis.', cls: 'm--c', sizes: '(max-width: 700px) 70vw, 20vw' },
  { foto: 'egle-prie-namo-homepage-crop', pos: '50% 35%', cap: 'Išdžiūvusi eglė prie medinio namo, prieš darbus.', cls: 'm--d', sizes: '(max-width: 700px) 70vw, 20vw' },
];
---
<section class="mom" aria-labelledby="mom-h">
  <div class="wrap mom__head">
    <h2 id="mom-h">Taip atrodo darbas</h2>
    <p class="lead">Nuotraukos iš mūsų objektų, nefotografuotos reklamai. Telefonu, tarp darbų.</p>
    <a class="link-arrow" href="/galerija">Daugiau darbų nuotraukų</a>
  </div>
  <ul role="list" class="mom__grid">
    {m.map((x) => (
      <li class:list={['mom__it', x.cls]}>
        <figure>
          <div class="ph mom__ph cut"><Photo name={x.foto} alt={x.cap} sizes={x.sizes} position={x.pos} /></div>
          <figcaption>{x.cap}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>
<style>
  .mom { background: var(--spruce-100); padding-block: var(--sec); }
  .mom__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 48px; align-items: end; margin-bottom: clamp(28px, 3vw, 48px); }
  .mom__head h2 { color: var(--spruce-900); }
  .mom__head .lead { grid-column: 1; max-width: 30em; }
  .mom__head .link-arrow { grid-column: 2; grid-row: 1 / span 2; white-space: nowrap; }
  .mom__grid { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter); display: grid; grid-template-columns: 1.7fr 1fr 1fr 1fr; gap: clamp(14px, 1.6vw, 24px); align-items: end; }
  .mom__ph { aspect-ratio: 3 / 4; }
  .m--a .mom__ph { aspect-ratio: 4 / 5; }
  .mom figcaption { margin-top: 12px; font-size: .98rem; line-height: 1.4; color: var(--ink-2); }
  .m--a figcaption { font-size: 1.05rem; color: var(--ink); font-weight: 600; }
  @media (max-width: 960px) {
    .mom__head { grid-template-columns: 1fr; }
    .mom__head .link-arrow { grid-column: 1; grid-row: auto; }
    .mom__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .m--a { grid-column: 1 / -1; }
    .m--a .mom__ph { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 600px) {
    .mom__grid { grid-template-columns: none; grid-auto-flow: column; grid-auto-columns: 62%; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; scroll-padding-inline: var(--gutter); align-items: start; }
    .mom__it { scroll-snap-align: start; }
    .m--a { grid-column: auto; }
    .m--a .mom__ph { aspect-ratio: 3 / 4; }
    .mom figcaption { font-size: .94rem; }
  }
</style>
