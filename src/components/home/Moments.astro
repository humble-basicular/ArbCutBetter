---
/* Darbo akimirkos: didelės realios nuotraukos per visą plotį. Parašai — tik tai, kas matyti. */
import Photo from '../Photo.astro';
import Icon from '../Icon.astro';
const m = [
  { foto: 'pjovimas-prie-laidu', pos: '50% 22%', cap: 'Pušis tarp elektros laidų. Pjaunama nuo viršūnės, dalimis.', cls: 'm--a', sizes: '(max-width: 700px) 100vw, 40vw' },
  { foto: 'du-arboristai-lajoje', pos: '50% 40%', cap: 'Du arboristai didelio medžio lajoje.', cls: 'm--b', sizes: '(max-width: 700px) 100vw, 26vw' },
  { foto: 'pusis-alpinistas', pos: '50% 30%', cap: 'Aukšta pušis virš namų stogų. Darbas su virvėmis.', cls: 'm--c', sizes: '(max-width: 700px) 100vw, 34vw' },
  { foto: 'egle-prie-namo', pos: '50% 35%', cap: 'Išdžiūvusi eglė prie medinio namo, prieš darbus.', cls: 'm--d', sizes: '(max-width: 700px) 100vw, 34vw' },
];
---
<section class="mom" aria-labelledby="mom-h">
  <div class="wrap mom__head">
    <h2 id="mom-h">Taip atrodo darbas</h2>
    <p class="lead">Nuotraukos iš mūsų objektų, nefotografuotos reklamai. Telefonu, tarp darbų.</p>
    <a class="link-arrow" href="/galerija">Daugiau darbų nuotraukų <Icon name="arrow" size={20} /></a>
  </div>
  <ul role="list" class="mom__grid">
    {m.map((x) => (
      <li class:list={['mom__it', x.cls]}>
        <figure class="ph">
          <Photo name={x.foto} alt={x.cap} sizes={x.sizes} position={x.pos} />
          <figcaption>{x.cap}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</section>
<style>
  .mom { background: var(--f0); color: var(--cream); padding-top: var(--sec); }
  .mom :focus-visible { outline-color: var(--amber); }
  .mom__head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 14px 48px; align-items: end; margin-bottom: clamp(28px, 3vw, 44px); }
  .mom__head h2 { font-size: clamp(2.6rem, 1.4rem + 4.4vw, 5.6rem); font-weight: 700; }
  .mom__head .lead { max-width: 26em; color: var(--on-dark-2); }
  .mom__head .lead { grid-column: 1; }
  .mom__head .link-arrow { grid-column: 2; grid-row: 1 / span 2; white-space: nowrap; color: var(--cream); text-decoration-color: var(--amber); }
  .mom__grid { display: grid; grid-template-columns: 5fr 3fr 4fr; grid-template-rows: repeat(2, clamp(280px, 26vw, 400px)); gap: 6px; }
  .mom__it figure { position: relative; height: 100%; }
  .m--a { grid-row: 1 / span 2; }
  .m--b { grid-row: 1 / span 2; }
  .mom figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 20px 16px; font-weight: 600; font-size: 1.05rem; line-height: 1.35; color: var(--cream); background: linear-gradient(0deg, rgba(14, 26, 20, .9), rgba(14, 26, 20, 0)); }
  @media (max-width: 960px) {
    .mom__head { grid-template-columns: 1fr; }
    .mom__head .link-arrow { grid-column: 1; grid-row: auto; }
    .mom__grid { grid-template-columns: 1fr 1fr; grid-template-rows: 520px 300px 300px; }
    .m--a { grid-row: 1; } .m--b { grid-row: 1; }
  }
  @media (max-width: 600px) {
    .mom__grid { grid-template-columns: 1fr 1fr; grid-template-rows: 460px 260px; }
    .m--a { grid-column: 1 / -1; }
    .m--b { display: none; }
    .mom figcaption { font-size: .95rem; padding: 32px 12px 12px; }
  }
</style>
