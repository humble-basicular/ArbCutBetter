---
/* v5 komanda ir darbas (14 žingsnių: 10): didelės realios nuotraukos persidengiančiu koliažu su rankraštiniais parašais,
   po jomis — įranga, kuria dirbame (faktai iš /apie). Parašai — tik tai, kas matyti. */
import Photo from '../Photo.astro';
const I = '/assets/v5-brand/raster/icons';
const m = [
  { foto: 'pjovimas-prie-laidu-homepage-crop', pos: '50% 22%', cap: 'Pušis tarp elektros laidų. Pjaunama nuo viršūnės, dalimis.', cls: 'm--a', sizes: '(max-width: 700px) 100vw, 40vw' },
  { foto: 'du-arboristai-lajoje', pos: '50% 40%', cap: 'Du arboristai didelio medžio lajoje.', cls: 'm--b', sizes: '(max-width: 700px) 70vw, 24vw' },
  { foto: 'pusis-alpinistas', pos: '50% 30%', cap: 'Aukšta pušis virš namų stogų. Darbas su virvėmis.', cls: 'm--c', sizes: '(max-width: 700px) 70vw, 22vw' },
  { foto: 'egle-prie-namo-homepage-crop', pos: '50% 35%', cap: 'Išdžiūvusi eglė prie medinio namo, prieš darbus.', cls: 'm--d', sizes: '(max-width: 700px) 70vw, 22vw' },
];
const kit = [
  { ic: 'svc-bokstelis', b: 'Nuosavas autobokštelis', s: 'kėlimo aukštis iki 20 m' },
  { ic: 'svc-aukstis', b: 'Alpinistinė įranga ir virvės', s: 'kai bokštelis neprivažiuoja' },
  { ic: 'svc-isvezimas', b: 'Fiskaras išvežimui', s: 'Kaune ir Kauno rajone' },
  { ic: 'svc-kelmai', b: 'Kelmų freza', s: 'kelmai frezuojami arba išraunami' },
];
---
<section class="mom" aria-labelledby="mom-h">
  <div class="wrap mom__head">
    <div>
      <p class="kick">Komanda darbe</p>
      <h2 id="mom-h">Taip atrodo darbas</h2>
    </div>
    <div class="mom__lead">
      <p class="lead">ArbCut darbų nuotraukos.</p>
      <a class="link-arrow" href="/galerija">Daugiau darbų nuotraukų</a>
    </div>
  </div>
  <div class="wrap">
    <ul role="list" class="mom__grid">
      {m.map((x, i) => (
        <li class:list={['mom__it', 'rv', x.cls]} style={`--i:${i}`}>
          <figure>
            <div class="mom__ph fill"><Photo name={x.foto} alt={x.cap} sizes={x.sizes} position={x.pos} /></div>
            <figcaption class="hand">{x.cap}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <ul role="list" class="kit">
      {kit.map((k, i) => (
        <li class="rv" style={`--i:${i}`}><span class="ico-c" style="--cs:64px"><img src={`${I}/${k.ic}-160.png`} alt="" width="46" height="46" loading="lazy" /></span><span><b>{k.b}</b><small>{k.s}</small></span></li>
      ))}
    </ul>
  </div>
</section>
<style>
  .mom { padding-block: clamp(72px, 8vw, 128px); background: var(--paper); overflow: hidden; }
  .mom__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px 48px; align-items: end; margin-bottom: clamp(36px, 4vw, 60px); }
  .mom__head h2 { color: var(--spruce-900); margin-top: 8px; }
  .mom__lead { display: grid; gap: 12px; justify-items: start; }
  .mom__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(16px, 2vw, 26px); align-items: start; }
  .mom__it figure { background: #fff; border-radius: var(--r); padding: 10px 10px 16px; box-shadow: var(--sh-2); display: grid; gap: 12px; }
  .mom__ph { position: relative; border-radius: 10px; overflow: hidden; aspect-ratio: 3 / 4; background: var(--spruce-100); }
  .mom__it:nth-child(odd) figure { transform: rotate(-1.2deg); }
  .mom__it:nth-child(even) figure { transform: rotate(1.2deg); margin-top: 28px; }
  .mom__it figcaption { font-size: 1.35rem; color: var(--spruce-900); line-height: 1.1; padding-inline: 6px; min-height: 2.3em; }
  .kit { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: clamp(40px, 5vw, 72px); background: var(--spruce-900); color: #fff; border-radius: var(--r-lg); padding: clamp(18px, 2.4vw, 28px); }
  .kit li { display: flex; align-items: center; gap: 14px; }
  .kit b { display: block; font-size: 1.05rem; }
  .kit small { color: var(--on-dark-2); font-size: .92rem; }
  @media (max-width: 900px) {
    .mom__head { grid-template-columns: 1fr; }
    .mom__grid { grid-template-columns: 1fr 1fr; }
    .mom__it:nth-child(even) figure { margin-top: 0; }
    .kit { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) { .kit { grid-template-columns: 1fr; } .mom__it figcaption { font-size: 1.3rem; } }
</style>
