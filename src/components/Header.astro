---
/* v5 antraštė: tamsi paslaugų juosta (darbo laikas, oficialus įvertinimas, nuotraukos el. paštu) + balta antraštė su dideliu logotipu.
   Telefonas visada matomas. Kabliukai site.js: .hdr, .hdr__dropbtn, #svc-menu, .hdr__burger, #mnav, [data-quote]. */
import { site } from '@data/site.js';
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import Logo from './Logo.astro';
import RatingUnit from './v5/RatingUnit.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/galerija', label: 'Darbai' },
  { href: '/kainos', label: 'Kainos' },
  { href: '/atsiliepimai', label: 'Atsiliepimai' },
  { href: '/apie', label: 'Apie' },
  { href: '/kontaktai', label: 'Kontaktai' },
];
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const isActive = (href) => path === href || path.startsWith(href + '/');
const servicesActive = path.startsWith('/paslaugos');
---
<div class="util" aria-label="Darbo laikas ir įvertinimas">
  <div class="util__in">
    <p class="util__hrs"><img class="ico" src="/assets/v5-brand/raster/icons/ui-clock-160.png" alt="" width="18" height="18" style="--is:18px" />Kasdien 08:00–18:00, ir savaitgaliais</p>
    <RatingUnit variant="chip" source loc="util-rating" />
    <a class="util__sms" href={site.mailFotoHref} data-loc="util-mail"><img class="ico" src="/assets/v5-brand/raster/icons/ui-camera-160.png" alt="" width="24" height="24" style="--is:24px;filter:none" />Kainą pasakome pagal nuotrauką</a>
  </div>
</div>
<header class="hdr" id="top">
  <div class="hdr__in">
    <a href="/" class="hdr__logo" aria-label="ArbCut, į pradžią">
      <Logo tone="dark" height={64} class="hdr__logo-full" />
      <Logo mark tone="dark" height={50} class="hdr__logo-mark" />
    </a>

    <nav class="hdr__nav" aria-label="Pagrindinis meniu">
      <ul role="list" class="hdr__list">
        <li class="hdr__drop">
          <button type="button" class:list={['hdr__link', 'hdr__dropbtn', { 'is-active': servicesActive }]} aria-expanded="false" aria-controls="svc-menu">
            Paslaugos <span class="hdr__caret" aria-hidden="true"></span>
          </button>
          <div class="svc" id="svc-menu" hidden>
            <div class="svc__in">
              {grupes.map((g) => (
                <div class="svc__col">
                  <p class="svc__head">{g.pavadinimas}</p>
                  <ul role="list">
                    {g.slugs.map((s) => (
                      <li><a href={`/paslaugos/${s}`} class="svc__a" aria-current={path === `/paslaugos/${s}` ? 'page' : undefined}>
                        <span>{detales[s]?.trumpas || byslug[s].pavadinimas}</span>
                        <small>{byslug[s].kaina}</small>
                      </a></li>
                    ))}
                  </ul>
                </div>
              ))}
              <div class="svc__col svc__col--cta">
                <p class="svc__head">Nežinote, kaip vadinasi darbas?</p>
                <p>Aprašykite, ko reikia. Pasakysime, ką daryti ir kiek kainuos.</p>
                <button type="button" class="btn btn--primary btn--sm" data-quote data-loc="nav-quote">Gauti kainą</button>
                <a class="link-arrow" href="/paslaugos">Visos paslaugos</a>
              </div>
            </div>
          </div>
        </li>
        {nav.map((n) => (
          <li><a href={n.href} class:list={['hdr__link', { 'is-active': isActive(n.href) }]} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a class="hdr__tel" href={site.telefonasHref} data-loc="header-call">
        <span class="ico-c hdr__tel-ic" style="--cs:46px"><img src="/assets/v5-brand/raster/icons/ui-phone-160.png" alt="" width="34" height="34" /></span>
        <span class="hdr__tel-t"><span class="hdr__tel-l">Skambinkite kasdien 08–18</span><span class="hdr__tel-n">{site.telefonas}</span></span>
      </a>
      <button type="button" class="btn btn--primary hdr__quote" data-quote>Gauti kainą</button>
      <a class="hdr__mcall" href={site.telefonasHref} data-loc="header-call-m" aria-label={`Skambinti ${site.telefonas}`}><img src="/assets/v5-brand/raster/icons/ui-phone-160.png" alt="" width="26" height="26" /><span>Skambinti</span></a>
      <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="mnav" aria-label="Atidaryti meniu"><span class="hdr__bars" aria-hidden="true"></span><span class="hdr__burger-t">Meniu</span></button>
    </div>
  </div>
</header>

<div class="mnav" id="mnav" hidden>
  <div class="mnav__top">
    <a href="/" aria-label="ArbCut, į pradžią"><Logo tone="dark" height={46} /></a>
    <button type="button" class="mnav__close" aria-label="Uždaryti meniu">Uždaryti</button>
  </div>
  <div class="mnav__call">
    <a class="mnav__tel" href={site.telefonasHref} data-loc="mnav-call">{site.telefonas}</a>
    <p>Kasdien 08:00–18:00</p>
  </div>
  <nav class="mnav__body" aria-label="Mobilusis meniu">
    <ul role="list" class="mnav__main">
      <li><a href="/paslaugos">Paslaugos</a></li>
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
    {grupes.map((g) => (
      <div class="mnav__grp">
        <p class="mnav__head">{g.pavadinimas}</p>
        <ul role="list">
          {g.slugs.map((s) => <li><a href={`/paslaugos/${s}`}>{detales[s]?.trumpas || byslug[s].pavadinimas}</a></li>)}
        </ul>
      </div>
    ))}
  </nav>
  <div class="mnav__foot">
    <a class="btn btn--line" href={site.mailFotoHref} data-loc="mnav-mail">Siųsti nuotraukas el. paštu</a>
    <button type="button" class="btn btn--primary" data-quote>Gauti kainą</button>
  </div>
</div>

<style>
  /* Paslaugų juosta */
  .util { background: var(--spruce-950); color: #fff; font-size: .92rem; }
  .util__in { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter); min-height: var(--util-h); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .util__hrs, .util__sms { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; color: var(--on-dark-2); }
  .util__sms { color: #fff; }
  .util__sms:hover { color: var(--gold); }
  .util .ico { filter: brightness(0) invert(1); opacity: .85; }

  /* Antraštė */
  .hdr { position: sticky; top: 0; z-index: 900; background: #fff; box-shadow: 0 1px 0 var(--line); transition: box-shadow var(--t); }
  .hdr.is-stuck { box-shadow: 0 1px 0 var(--line), 0 10px 30px rgba(11, 35, 27, .1); }
  .hdr__in { max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter); height: var(--header-h); display: flex; align-items: center; gap: clamp(16px, 2.4vw, 40px); }
  .hdr__logo { display: flex; align-items: center; flex: 0 0 auto; }
  .hdr__logo :global(.hdr__logo-mark) { display: none; }
  .hdr__nav { flex: 1 1 auto; display: flex; justify-content: center; }
  .hdr__list { display: flex; align-items: center; gap: clamp(2px, .6vw, 10px); }
  .hdr__link { display: inline-flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 8px; font-weight: 700; font-size: 1.06rem; color: var(--spruce-900); transition: background var(--t), color var(--t); }
  .hdr__link:hover { background: var(--spruce-50); color: var(--orange-ink); }
  .hdr__link.is-active { color: var(--orange-ink); box-shadow: inset 0 -3px 0 var(--orange); border-radius: 8px 8px 0 0; }
  .hdr__caret { width: 9px; height: 9px; border-right: 2.5px solid currentColor; border-bottom: 2.5px solid currentColor; transform: translateY(-3px) rotate(45deg); transition: transform var(--t); }
  .hdr__dropbtn[aria-expanded='true'] .hdr__caret { transform: translateY(2px) rotate(225deg); }
  .hdr__drop { position: relative; }
  .svc { position: absolute; left: 50%; top: calc(100% + 18px); transform: translateX(-36%); width: min(980px, 92vw); background: #fff; border-radius: var(--r-lg); box-shadow: var(--sh-3); padding: 28px; z-index: 950; }
  .svc__in { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(0, 1.05fr); gap: 26px; }
  .svc__head { font-family: var(--display); font-weight: 800; font-size: 1.05rem; color: var(--spruce-900); margin-bottom: 10px; }
  .svc__a { display: flex; justify-content: space-between; gap: 12px; padding: 8px 10px; margin-inline: -10px; border-radius: 8px; font-weight: 600; line-height: 1.25; }
  .svc__a:hover { background: var(--spruce-50); color: var(--orange-ink); }
  .svc__a small { color: var(--orange-ink); font-weight: 800; white-space: nowrap; font-size: .9rem; }
  .svc__col--cta { background: var(--spruce-900); color: #fff; border-radius: var(--r); padding: 20px; display: grid; gap: 12px; align-content: start; }
  .svc__col--cta .svc__head { color: var(--gold); }
  .svc__col--cta p { color: var(--on-dark-2); font-size: 1rem; }
  .svc__col--cta .link-arrow { color: #fff; }

  .hdr__actions { display: flex; align-items: center; gap: 16px; flex: 0 0 auto; }
  .hdr__tel { display: flex; align-items: center; gap: 12px; color: var(--spruce-900); }
  .hdr__tel-ic { transition: transform var(--t); }
  .hdr__tel:hover .hdr__tel-ic { transform: rotate(-12deg) scale(1.05); }
  .hdr__tel-t { display: grid; line-height: 1.1; }
  .hdr__tel-l { font-size: .85rem; font-weight: 600; color: var(--ink-2); }
  .hdr__tel-n { font-family: var(--display); font-weight: 800; font-variation-settings: 'opsz' 48, 'wdth' 90; font-size: 1.5rem; letter-spacing: -.01em; white-space: nowrap; }
  .hdr__tel:hover .hdr__tel-n { color: var(--orange-ink); }
  .hdr__mcall, .hdr__burger { display: none; }

  /* Mobilusis meniu */
  .mnav { position: fixed; inset: 0; z-index: 1000; background: #fff; overflow-y: auto; padding: 0 var(--gutter) 32px; }
  .mnav__top { display: flex; align-items: center; justify-content: space-between; height: var(--header-h); }
  .mnav__close { font-weight: 800; padding: 12px 16px; border-radius: 10px; background: var(--spruce-50); color: var(--spruce-900); }
  .mnav__call { background: var(--spruce-900); color: #fff; border-radius: var(--r); padding: 18px 20px; margin-bottom: 20px; }
  .mnav__tel { font-family: var(--display); font-weight: 800; font-size: 1.9rem; color: #fff; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 6px; }
  .mnav__call p { color: var(--on-dark-2); margin-top: 6px; }
  .mnav__main { display: grid; gap: 2px; margin-bottom: 22px; }
  .mnav__main a { display: block; padding: 12px 0; font-family: var(--display); font-weight: 800; font-size: 1.6rem; color: var(--spruce-900); border-bottom: 1px solid var(--line); }
  .mnav__grp { margin-bottom: 18px; }
  .mnav__head { font-weight: 800; color: var(--orange-ink); margin-bottom: 6px; text-transform: uppercase; letter-spacing: .1em; font-size: .85rem; }
  .mnav__grp a { display: block; padding: 8px 0; font-weight: 600; }
  .mnav__foot { display: grid; gap: 12px; margin-top: 18px; }

  @media (max-width: 1240px) {
    .hdr__tel-l { display: none; }
    .hdr__tel-n { font-size: 1.3rem; }
    .hdr__link { padding: 10px 8px; font-size: 1rem; }
  }
  @media (max-width: 1100px) { .util__sms { display: none; } .hdr__tel-ic { display: none; } .hdr__quote { display: none; } .hdr__logo :global(.hdr__logo-full) { height: 54px; width: auto; } }
  @media (max-width: 960px) {
    .util { display: none; }
    .hdr__nav, .hdr__tel, .hdr__quote { display: none; }
    .hdr__in { justify-content: space-between; }
    .hdr__logo :global(.hdr__logo-full) { height: 50px; width: auto; }
    .hdr__mcall { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 8px 14px; border-radius: 10px; background: var(--orange); color: #fff; font-weight: 800; font-size: 1.05rem; box-shadow: 0 3px 0 var(--orange-ink); }
    .hdr__mcall img { width: 22px; height: 22px; filter: brightness(0) invert(1); }
    .hdr__burger { display: inline-flex; align-items: center; gap: 8px; min-height: 48px; padding: 8px 12px; border-radius: 10px; background: var(--spruce-900); color: #fff; font-weight: 800; }
    .hdr__bars { width: 18px; height: 12px; background: linear-gradient(#fff, #fff) top / 100% 2.5px no-repeat, linear-gradient(#fff, #fff) center / 100% 2.5px no-repeat, linear-gradient(#fff, #fff) bottom / 100% 2.5px no-repeat; }
  }
  @media (max-width: 420px) {
    .hdr__logo :global(.hdr__logo-full) { height: 44px; width: auto; }
    .hdr__burger-t { display: none; }
    .hdr__mcall span { display: none; }
    .hdr__mcall { padding: 8px 12px; }
  }
  @media (max-width: 340px) { .hdr__logo :global(.hdr__logo-full) { display: none; } .hdr__logo :global(.hdr__logo-mark) { display: block; height: 46px; width: auto; } }
</style>
