---
import { site } from '@data/site.js';
const { title = 'Turite medį, kuris kelia nerimą?', text = 'Atsiųskite nuotrauką arba paskambinkite — pasakysime, kaip saugiai jį sutvarkyti ir kiek tai kainuotų.', service = '' } = Astro.props;
---
<section class="cta">
  <div class="wrap">
    <div class="cta__in cut on-dark">
      <div>
        <h2>{title}</h2>
        <p class="lead">{text}</p>
      </div>
      <div class="cta__act">
        <a class="btn btn--primary" href={site.telefonasHref} data-loc="cta-band-call"><span class="btn__num">{site.telefonas}</span></a>
        <button type="button" class="btn btn--line" data-quote data-service={service}>Gauti kainą</button>
        <p class="cta__h">Kasdien 08:00–18:00</p>
      </div>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--paper); padding-block: clamp(48px, 6vw, 88px); }
  .cta__in { background: var(--spruce-700); color: #fff; display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 36px; align-items: center; padding: clamp(32px, 5vw, 64px); }
  .cta h2 { margin-bottom: 12px; max-width: 20ch; }
  .cta__in :focus-visible { outline-color: #fff; }
  .cta__act { display: grid; gap: 12px; justify-items: stretch; max-width: 360px; margin-left: auto; width: 100%; }
  .cta__h { font-size: .95rem; color: var(--on-dark-2); text-align: center; }
  @media (max-width: 860px) { .cta__in { grid-template-columns: 1fr; } .cta__act { margin-left: 0; max-width: none; } }
  @media (max-width: 600px) { .cta .wrap { padding-inline: 10px; } .cta__in { padding: 32px 20px; } }
</style>
