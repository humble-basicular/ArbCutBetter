---
import { site } from '@data/site.js';
import Icon from './Icon.astro';
const { title = 'Turite medį, kuris kelia nerimą?', text = 'Atsiųskite nuotrauką arba paskambinkite — pasakysime, kaip saugiai jį sutvarkyti ir kiek tai kainuotų.', service = '' } = Astro.props;
---
<section class="cta on-dark">
  <div class="wrap cta__in">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta__act">
      <a class="btn btn--primary" href={site.telefonasHref} data-loc="cta-band-call"><Icon name="phone" size={18} /> {site.telefonas}</a>
      <button type="button" class="btn btn--line" data-quote data-service={service}>Gauti kainą</button>
      <p class="cta__h">Kasdien 08:00–18:00</p>
    </div>
  </div>
</section>
<style>
  .cta { background: var(--ink); color: var(--paper); border-top: 6px solid var(--timber); }
  .cta__in { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 40px; align-items: center; padding-block: clamp(48px, 6vw, 80px); }
  .cta h2 { margin-bottom: 12px; }
  .cta__act { display: grid; gap: 12px; justify-items: stretch; max-width: 360px; margin-left: auto; width: 100%; }
  .cta__h { font-size: .9rem; color: var(--mute-light); text-align: center; }
  @media (max-width: 860px) { .cta__in { grid-template-columns: 1fr; } .cta__act { margin-left: 0; } }
</style>
