---
import { site } from '@data/site.js';
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import { vietoves } from '@data/vietoves.js';
import { atsiliepimuKiekis, atsiliepimuVidurkis } from '@data/atsiliepimai.js';
import { lrt, valstietis } from '@data/spauda.js';
import Logo from './Logo.astro';
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const year = new Date().getFullYear();
const rating = atsiliepimuVidurkis.toFixed(1).replace('.', ',');
---
<footer class="ftr">
  <div class="wrap ftr__call">
    <p class="ftr__call-h">Medis kelia nerimą? Skambinkite.</p>
    <a class="ftr__tel" href={site.telefonasHref} data-loc="footer-call-big">{site.telefonas}</a>
    <p class="ftr__call-s">Kasdien 08:00–18:00 · nuotraukas SMS žinute tuo pačiu numeriu arba <a href={`mailto:${site.elPastas}`}>{site.elPastas}</a></p>
  </div>
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <Logo tone="light" height={52} />
      <p><strong>ArbCut</strong>, arboristas aukštalipys {site.savininkas} su komanda. Bazė Kaune, dirbame iki 200 km aplink.</p>
      <a class="ftr__rep" href={site.atsiliepimai.profilis} target="_blank" rel="noopener">
        <span>{rating} iš 5 · {atsiliepimuKiekis} atsiliepimai Paslaugos.lt</span><span class="sr-only"> (atsidaro naujame lange)</span>
      </a>
      <p class="ftr__press">Apie mus rašė <a href={lrt.url} target="_blank" rel="noopener">LRT.lt</a> ir <a href={valstietis.url} target="_blank" rel="noopener">Valstietis.lt</a></p>
    </div>
    {grupes.map((g) => (
      <div class="ftr__col">
        <p class="ftr__h">{g.pavadinimas}</p>
        <ul role="list">{g.slugs.map((s) => <li><a href={`/paslaugos/${s}`}>{detales[s]?.trumpas || byslug[s].pavadinimas}</a></li>)}</ul>
      </div>
    ))}
    <div class="ftr__col">
      <p class="ftr__h">Miestai</p>
      <ul role="list">{vietoves.map((v) => <li><a href={`/${v.slug}`}>Medžių pjovimas {v.kur}</a></li>)}</ul>
    </div>
    <div class="ftr__col">
      <p class="ftr__h">Kontaktai</p>
      <ul role="list" class="ftr__contact">
        <li><a href={site.telefonasHref} data-loc="footer-call">{site.telefonas}</a></li>
        <li><a href={site.smsHref}>SMS su nuotraukomis</a></li>
        <li><a href={`mailto:${site.elPastas}`} set:html={site.elPastas.replace('@', '<wbr>@')} /></li>
        <li>Kasdien 08:00–18:00</li>
        <li>Kaunas, +200 km aplink</li>
      </ul>
      <ul role="list" class="ftr__more">
        <li><a href="/galerija">Darbų nuotraukos</a></li>
        <li><a href="/kainos">Kainos</a></li>
        <li><a href="/atsiliepimai">Atsiliepimai</a></li>
        <li><a href="/apie">Apie Mantą</a></li>
        <li><a href="/tinklarastis">Patarimai</a></li>
        <li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr__base">
    <span>© {year} ArbCut · {site.savininkas}</span>
    <span><a href="/privatumo-politika">Privatumo politika</a> · <a href="/taisykles">Taisyklės</a></span>
  </div>
</footer>
<style>
  .ftr { background: var(--spruce-900); color: var(--on-dark-2); font-size: 1.02rem; }
  .ftr :focus-visible { outline-color: #fff; }
  .ftr a { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 4px; text-decoration-thickness: 2px; transition: text-decoration-color var(--t), color var(--t); }
  .ftr a:hover { color: #fff; text-decoration-color: var(--orange); }
  .ftr__call { padding-block: clamp(56px, 7vw, 96px) clamp(36px, 5vw, 56px); display: grid; gap: 10px; }
  .ftr__call-h { font-stretch: var(--wide); font-size: clamp(1.35rem, 1.1rem + 1vw, 2rem); font-weight: 800; color: #fff; line-height: 1.15; }
  .ftr__tel { font-stretch: var(--wide); font-weight: 800; font-size: clamp(2.3rem, .9rem + 6.4vw, 7.2rem); line-height: 1.05; color: #fff; letter-spacing: -.02em; justify-self: start; white-space: nowrap; text-decoration-color: var(--orange) !important; }
  .ftr__tel:hover { color: #fff; }
  .ftr__call-s a { color: #fff; text-decoration-color: var(--orange); overflow-wrap: anywhere; }
  .ftr__grid { display: grid; grid-template-columns: 1.2fr .9fr .9fr 1.1fr 1.45fr; gap: 36px; padding-block: 48px 52px; }
  .ftr__brand { display: grid; gap: 16px; align-content: start; }
  .ftr__brand :global(img.logo) { height: 52px; width: auto; }
  .ftr__brand p { max-width: 32ch; }
  .ftr__brand strong { color: #fff; }
  .ftr__rep { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 10px; color: #fff; font-weight: 700; }
  .ftr__press a { color: #fff; font-weight: 700; text-decoration-color: rgba(255,255,255,.4); }
  .ftr__h { font-stretch: var(--wide); font-size: 1.1rem; font-weight: 800; color: #fff; margin-bottom: 12px; }
  .ftr li + li { margin-top: 8px; }
  .ftr__contact a { color: #fff; overflow-wrap: anywhere; }
  .ftr__more { margin-top: 22px; }
  .ftr__base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-block: 22px 26px; font-size: .95rem; box-shadow: inset 0 1px 0 rgba(255,255,255,.12); }
  @media (max-width: 1180px) { .ftr__grid { grid-template-columns: 1fr 1fr 1fr; } .ftr__brand { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .ftr__grid { grid-template-columns: 1fr 1fr; gap: 32px 20px; } }
  @media (max-width: 600px) {
    .ftr__call { padding-block: 44px 24px; }
    .ftr__grid { padding-block: 28px 36px; gap: 28px 16px; }
    .ftr__grid > .ftr__col:last-child { grid-column: 1 / -1; }
    .ftr__contact, .ftr__more { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; }
    .ftr li + li { margin-top: 6px; }
    .ftr__contact li:nth-child(3) { grid-column: 1 / -1; }
    .ftr li a { display: inline-block; padding-block: 3px; }
  }
  @media (max-width: 340px) { .ftr__grid { grid-template-columns: 1fr; } }
</style>
