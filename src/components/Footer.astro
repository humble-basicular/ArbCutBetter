---
import { site } from '@data/site.js';
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import { vietoves } from '@data/vietoves.js';
import { bendrasKiekis, bendrasIvertinimas } from '@data/atsiliepimai-visi.js';
import { lrt, valstietis } from '@data/spauda.js';
import Logo from './Logo.astro';
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const year = new Date().getFullYear();
const rating = bendrasIvertinimas.toFixed(1).replace('.', ',');
const aukstyje = /^\/(paslaugos\/(darbai-su|dazymo|reklamin|lietvamzd|kiti)|darbai-su-autoboksteliu|lietvamzdziu)/.test(Astro.url.pathname);
---
<footer class="ftr">
  <div class="ftr__top">
    <div class="wrap ftr__call">
      <div class="ftr__sym"><img src="/assets/v5-brand/map/lt-symbol.webp" alt="" width="1200" height="1013" loading="lazy" decoding="async" /></div>
      <div class="ftr__call-t">
        <p class="tag ftr__tag">Bazė Kaune</p>
        <p class="ftr__call-h">{aukstyje ? 'Reikia darbų aukštyje?' : 'Medis kelia nerimą?'} <span>Skambinkite.</span></p>
        <a class="ftr__tel" href={site.telefonasHref} data-loc="footer-call-big"><span class="ico-c" style="--cs:52px"><img src="/assets/v5-brand/raster/icons/ui-phone-160.png" alt="" width="36" height="36" /></span>{site.telefonas}</a>
        <p class="ftr__call-s">Kasdien 08:00–18:00 · nuotraukas SMS, Viber ar WhatsApp tuo pačiu numeriu arba <a href={`mailto:${site.elPastas}`}>{site.elPastas}</a></p>
      </div>
    </div>
    <div class="ftr__trees" aria-hidden="true"></div>
  </div>
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <Logo tone="light" height={70} />
      <p><strong>ArbCut</strong>, arboristas aukštalipys {site.savininkas} su komanda. Bazė Kaune, dirbame iki {site.zona.km} km aplink.</p>
      <a class="ftr__rep" href="/atsiliepimai"><span>{rating} iš 5 · {bendrasKiekis} atsiliepimai</span></a>
      <p class="ftr__press">Apie mus rašė <a href={lrt.url} target="_blank" rel="noopener">LRT.lt</a> ir <a href={valstietis.url} target="_blank" rel="noopener">Valstietis.lt</a></p>
    </div>
    {grupes.map((g) => (
      <div class="ftr__col">
        <p class="ftr__h">{g.pavadinimas}</p>
        <ul role="list">{g.slugs.map((s) => <li><a href={`/paslaugos/${s}`}>{detales[s]?.trumpas || byslug[s].pavadinimas}</a></li>)}</ul>
      </div>
    ))}
    <div class="ftr__col">
      <p class="ftr__h">Miestai</p>
      <ul role="list">{vietoves.map((v) => <li><a href={`/${v.slug}`}>Medžių pjovimas {v.kur}</a></li>)}</ul>
    </div>
    <div class="ftr__col">
      <p class="ftr__h">Kontaktai</p>
      <ul role="list" class="ftr__contact">
        <li><a href={site.telefonasHref} data-loc="footer-call">{site.telefonas}</a></li>
        <li><a href={site.smsHref}>SMS su nuotraukomis</a></li>
        <li><a href={`mailto:${site.elPastas}`} set:html={site.elPastas.replace('@', '<wbr>@')} /></li>
        <li>Kasdien 08:00–18:00</li>
        <li>{site.zona.trumpai}</li>
      </ul>
      <ul role="list" class="ftr__more">
        <li><a href="/galerija">Darbų nuotraukos</a></li>
        <li><a href="/kainos">Kainos</a></li>
        <li><a href="/atsiliepimai">Atsiliepimai</a></li>
        <li><a href="/apie">Apie Mantą</a></li>
        <li><a href="/tinklarastis">Patarimai</a></li>
        <li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr__base">
    <span>© {year} ArbCut · {site.savininkas}</span>
    <span><a href="/privatumo-politika">Privatumo politika</a> · <a href="/taisykles">Taisyklės</a></span>
  </div>
</footer>
<style>
  .ftr { background: var(--spruce-950); color: var(--on-dark-2); }
  .ftr__top { position: relative; background: var(--spruce-900); padding-top: clamp(64px, 7vw, 110px); padding-bottom: clamp(110px, 11vw, 170px); overflow: hidden; isolation: isolate; }
  .ftr__call { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(28px, 4vw, 72px); align-items: center; }
  .ftr__sym img { width: 100%; height: auto; transform: rotate(-3deg); }
  .ftr__call-t { display: grid; gap: 18px; justify-items: start; }
  .ftr__call-h { font-family: var(--display); font-weight: 800; font-variation-settings: 'opsz' 96, 'wdth' 92; font-size: clamp(2.2rem, 1.4rem + 3vw, 4.2rem); line-height: 1; letter-spacing: -.025em; color: #fff; }
  .ftr__call-h span { color: var(--gold); }
  .ftr__tel { display: inline-flex; align-items: center; gap: 16px; font-family: var(--display); font-weight: 800; font-size: clamp(2rem, 1.5rem + 2vw, 3.4rem); color: #fff; letter-spacing: -.02em; padding: 10px 26px 10px 12px; border-radius: 16px; background: var(--orange); box-shadow: 0 5px 0 var(--orange-ink), 0 16px 40px rgba(0,0,0,.3); transition: transform var(--t); }
  .ftr__tel:hover { transform: translateY(-2px); }
  .ftr__tel .ico-c { box-shadow: none; }
  .ftr__call-s { color: var(--on-dark-2); }
  .ftr__call-s a { color: #fff; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 3px; }
  .ftr__trees { position: absolute; left: 0; right: 0; bottom: -2px; height: clamp(90px, 10vw, 150px); background: url('/assets/v5-brand/raster/texture/treeline.png') center bottom / auto 100% repeat-x; z-index: -1; }
  .ftr__grid { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(5, minmax(0, 1fr)); gap: 32px 28px; padding-block: clamp(40px, 5vw, 64px); }
  .ftr__brand { display: grid; gap: 14px; align-content: start; }
  .ftr__brand p { font-size: .98rem; line-height: 1.55; }
  .ftr__brand strong { color: #fff; }
  .ftr__rep { display: inline-block; justify-self: start; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.15); padding: 10px 14px; border-radius: 10px; color: #fff; font-weight: 700; font-size: .95rem; }
  .ftr__rep:hover { border-color: var(--gold); }
  .ftr__press a { color: #fff; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 3px; }
  .ftr__h { font-family: var(--display); font-weight: 800; color: var(--gold); margin-bottom: 12px; font-size: 1.05rem; }
  .ftr__col ul { display: grid; gap: 7px; font-size: .95rem; }
  .ftr__col a:hover { color: #fff; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 3px; }
  .ftr__contact a { color: #fff; font-weight: 700; }
  .ftr__more { margin-top: 14px; }
  .ftr__base { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-block: 20px 28px; border-top: 1px solid rgba(255,255,255,.1); font-size: .9rem; }
  .ftr__base a:hover { color: #fff; }
  @media (max-width: 1100px) { .ftr__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .ftr__brand { grid-column: 1 / -1; } }
  @media (max-width: 860px) { .ftr__call { grid-template-columns: 1fr; } .ftr__sym { max-width: 440px; } }
  @media (max-width: 560px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__tel { font-size: 1.75rem; width: 100%; } }
</style>
