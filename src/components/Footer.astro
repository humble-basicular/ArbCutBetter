---
import { site } from '@data/site.js';
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import { atsiliepimuKiekis, atsiliepimuVidurkis } from '@data/atsiliepimai.js';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const year = new Date().getFullYear();
---
<footer class="ftr on-dark">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <Logo tone="light" height={46} />
      <p>Arboristas aukštalipys {site.savininkas} su komanda. Medžių pjovimas, genėjimas, kelmai ir darbai aukštyje iki 20 m.</p>
      <a class="ftr__rep" href={site.atsiliepimai.profilis} target="_blank" rel="noopener">
        <Icon name="star" size={16} /> {atsiliepimuVidurkis.toFixed(1).replace('.', ',')} · {atsiliepimuKiekis} atsiliepimai Paslaugos.lt <Icon name="external" size={14} />
      </a>
    </div>
    {grupes.map((g) => (
      <div>
        <p class="ftr__h">{g.pavadinimas}</p>
        <ul role="list">{g.slugs.map((s) => <li><a href={`/paslaugos/${s}`}>{detales[s]?.trumpas || byslug[s].pavadinimas}</a></li>)}</ul>
      </div>
    ))}
    <div>
      <p class="ftr__h">Kontaktai</p>
      <ul role="list" class="ftr__contact">
        <li><a href={site.telefonasHref} data-loc="footer-call"><Icon name="phone" size={16} /> {site.telefonas}</a></li>
        <li><a href={`mailto:${site.elPastas}`}><Icon name="mail" size={16} /> {site.elPastas}</a></li>
        <li><Icon name="clock" size={16} /> Kasdien 08:00–18:00</li>
        <li><Icon name="pin" size={16} /> Kaunas, Kauno apskritis</li>
      </ul>
      <p class="ftr__h ftr__h--sp">Svetainė</p>
      <ul role="list">
        <li><a href="/galerija">Darbai</a></li>
        <li><a href="/atsiliepimai">Atsiliepimai</a></li>
        <li><a href="/kainos">Kainos</a></li>
        <li><a href="/apie">Apie</a></li>
        <li><a href="/tinklarastis">Patarimai</a></li>
        <li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr__base">
    <span>© {year} ArbCut · {site.savininkas}</span>
    <span><a href="/privatumo-politika">Privatumo politika</a> · <a href="/taisykles">Taisyklės</a></span>
  </div>
</footer>
<style>
  .ftr { background: var(--ink-2); color: var(--mute-light); padding-top: clamp(56px, 7vw, 88px); font-size: .97rem; }
  .ftr__grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr 1.1fr; gap: 40px; padding-bottom: 48px; }
  .ftr__brand { display: grid; gap: 18px; align-content: start; }
  .ftr__brand p { max-width: 30ch; }
  .ftr__rep { display: inline-flex; align-items: center; gap: 8px; color: var(--paper); font-weight: 600; }
  .ftr__rep svg:first-child { color: var(--sand); }
  .ftr__h { font-size: .76rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--sand); margin-bottom: 12px; }
  .ftr__h--sp { margin-top: 26px; }
  .ftr li + li { margin-top: 8px; }
  .ftr a:hover { color: var(--paper); }
  .ftr__contact li { display: flex; align-items: center; gap: 10px; }
  .ftr__contact a { display: inline-flex; align-items: center; gap: 10px; color: var(--paper); word-break: break-all; }
  .ftr__base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; padding-block: 20px; border-top: 1px solid var(--line-dark); font-size: .88rem; }
  @media (max-width: 960px) { .ftr__grid { grid-template-columns: 1fr 1fr; } .ftr__brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ftr__grid { grid-template-columns: 1fr; } }
</style>
