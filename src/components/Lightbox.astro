<dialog class="lb" id="lightbox" aria-label="Nuotraukos peržiūra">
  <button type="button" class="lb__btn lb__x" data-lb-close>Uždaryti</button>
  <button type="button" class="lb__btn lb__prev" data-lb-prev aria-label="Ankstesnė nuotrauka">Ankstesnė</button>
  <figure class="lb__fig"><img class="lb__img" alt="" /><figcaption class="lb__cap"></figcaption></figure>
  <button type="button" class="lb__btn lb__next" data-lb-next aria-label="Kita nuotrauka">Kita</button>
</dialog>
<style>
  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 24px; border: 0; background: rgba(15, 42, 32, .96); color: #fff; }
  .lb[open] { display: grid; grid-template-columns: 120px minmax(0, 1fr) 120px; align-items: center; gap: 12px; }
  .lb::backdrop { background: transparent; }
  .lb :focus-visible { outline-color: #fff; }
  .lb__fig { display: grid; gap: 12px; justify-items: center; }
  .lb__img { max-height: 78dvh; width: auto; max-width: 100%; object-fit: contain; min-width: min(560px, 100%); }
  .lb__cap { font-size: .98rem; color: var(--on-dark-2); text-align: center; }
  .lb__btn { min-height: 48px; padding: 10px 16px; font-weight: 700; color: #fff; border: 2px solid rgba(255,255,255,.7); border-radius: var(--radius); }
  .lb__btn:hover { background: #fff; color: var(--spruce-900); }
  .lb__x { position: absolute; top: 16px; right: 16px; }
  @media (max-width: 640px) {
    .lb[open] { grid-template-columns: 1fr; padding: 72px 12px 92px; }
    .lb__prev, .lb__next { position: absolute; bottom: 20px; width: calc(50% - 18px); }
    .lb__prev { left: 12px; } .lb__next { right: 12px; }
    .lb__img { min-width: 100%; }
  }
</style>
