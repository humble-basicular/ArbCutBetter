---
import Icon from './Icon.astro';
---
<dialog class="lb" id="lightbox" aria-label="Nuotraukos peržiūra">
  <button type="button" class="lb__btn lb__x" data-lb-close aria-label="Uždaryti"><Icon name="close" size={26} /></button>
  <button type="button" class="lb__btn lb__prev" data-lb-prev aria-label="Ankstesnė nuotrauka"><Icon name="prev" size={28} /></button>
  <figure class="lb__fig"><img class="lb__img" src="" alt="" /><figcaption class="lb__cap"></figcaption></figure>
  <button type="button" class="lb__btn lb__next" data-lb-next aria-label="Kita nuotrauka"><Icon name="next" size={28} /></button>
</dialog>
<style>
  .lb { width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 24px; border: 0; background: rgba(13, 22, 17, .94); color: var(--paper); }
  .lb[open] { display: grid; grid-template-columns: 56px minmax(0, 1fr) 56px; align-items: center; gap: 12px; }
  .lb::backdrop { background: transparent; }
  .lb__fig { display: grid; gap: 12px; justify-items: center; }
  .lb__img { max-height: 78dvh; width: auto; max-width: 100%; object-fit: contain; image-rendering: auto; min-width: min(560px, 100%); }
  .lb__cap { font-size: .95rem; color: var(--mute-light); text-align: center; }
  .lb__btn { width: 52px; height: 52px; display: grid; place-items: center; background: rgba(243, 239, 231, .1); color: var(--paper); }
  .lb__btn:hover { background: rgba(243, 239, 231, .22); }
  .lb__x { position: absolute; top: 16px; right: 16px; }
  @media (max-width: 640px) {
    .lb[open] { grid-template-columns: 1fr; padding: 64px 12px 84px; }
    .lb__prev, .lb__next { position: absolute; bottom: 18px; }
    .lb__prev { left: calc(50% - 64px); } .lb__next { right: calc(50% - 64px); }
    .lb__img { min-width: 100%; }
  }
</style>
