---
import '../styles/global.css';
import { site, PREVIEW } from '@data/site.js';
import { localBusiness } from '@data/jsonld.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteDialog from '../components/QuoteDialog.astro';
import MobileActions from '../components/MobileActions.astro';
import Lightbox from '../components/Lightbox.astro';
import ChatLauncher from '../components/ChatLauncher.astro';
import fontDisplay from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import fontDisplayExt from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-ext-standard-normal.woff2?url';
import fontText from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';

const { title, description, ogImage, noindex = false, schemas, bare = false, preload } = Astro.props;
const pageTitle = title || site.metaTitle;
const desc = description || site.metaDescription;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImg = new URL(ogImage || site.ogImage, site.url).href;
const schemaList = schemas && schemas.length ? schemas : [localBusiness()];
const robots = PREVIEW || noindex ? 'noindex, nofollow' : null;
const B = '/assets/v5-brand/logo';
---
<!doctype html>
<html lang="lt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {!PREVIEW && <meta name="jw-site" content="arbcut" />}

    <meta property="og:site_name" content="ArbCut" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="lt_LT" />
    <meta property="og:image" content={ogImg} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={fontDisplay} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontDisplayExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontText} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0F2E23" />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={`${B}/mark-a-egle.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${B}/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${B}/apple-touch-icon.png`} />

    {schemaList.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    <script is:inline>document.documentElement.classList.add('js');</script>
    {PREVIEW && <script is:inline>(function(){var m=location.search.match(/[?&]logo=(\d)/);var v=m?m[1]:(sessionStorage.getItem('arbcut-logo')||'1');sessionStorage.setItem('arbcut-logo',v);document.documentElement.dataset.logo=v;})();</script>}
  </head>
  <body>
    <a href="#main" class="skip-link">Pereiti prie turinio</a>
    {!bare && <Header />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer />}
    <QuoteDialog />
    <Lightbox />
    <MobileActions />
    {!bare && <ChatLauncher />}
    <script src="../scripts/site.js"></script>
    <script src="../scripts/motion.js"></script>
    <script>
      /* Sąlyga čia, ne šablone: sąlyginis <script> Astro sumaišo skriptų numeraciją
         ir peržiūroje vietoje site.js įkeliamas sekimas. */
      if (import.meta.env.PUBLIC_PREVIEW !== '1') import('../scripts/inquiry-track.ts');
    </script>
    {!PREVIEW && <script is:inline src="https://js.hcaptcha.com/1/api.js" async defer></script>}
  </body>
</html>
