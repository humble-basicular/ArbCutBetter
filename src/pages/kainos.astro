---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '@data/site.js';
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import { atsiliepimai, atsiliepimuSinchronizuota } from '@data/atsiliepimai.js';
import { localBusiness, faqPage, breadcrumbs } from '@data/jsonld.js';
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const pavyzdys = atsiliepimai.find((a) => a.tekstas && a.tekstas.includes('kaina 470'));
const duk = [
  { klausimas: 'Ar galite pasakyti kainą pagal nuotraukas?', atsakymas: 'Dažnai taip. Atsiųskite kelias nuotraukas ar trumpą vaizdo įrašą, kuriame matytųsi medis ir aplinka, — pasakysime preliminarią kainą. Sudėtingesniais atvejais atvažiuojame apžiūrėti.' },
  { klausimas: 'Ar kaina gali pasikeisti darbo metu?', atsakymas: 'Kainą ir darbų apimtį sutariame iš anksto. Jei vietoje paaiškėja, kad reikia papildomų darbų, juos aptariame prieš pradėdami.' },
  { klausimas: 'Ar išvežimas įskaičiuotas?', atsakymas: 'Išvežimas Kaune ir Kauno rajone yra atskira paslauga (nuo 80 €). Galime jį įtraukti į bendrą kainą — sutariame iš anksto. Toliau už Kauno rajono medieną sukrauname krūvoje.' },
  { klausimas: 'Kiek kainuoja kelmo pašalinimas?', atsakymas: 'Kelmų frezavimas — nuo 75 €. Kaina priklauso nuo kelmo skersmens, kiekio ir prieigos.', nuoroda: '/paslaugos/kelmu-naikinimas-frezavimas' },
  { klausimas: 'Ar kaina priklauso nuo atstumo?', atsakymas: 'Taip, tolimesniems išvykimams įtakos turi kelionė. Todėl išvykimo datą suderiname iš anksto, o kelių kaimynų darbus galime atlikti per vieną atvykimą.' },
];
---
<BaseLayout
  title="Medžių pjovimo kainos ir kas jas lemia | ArbCut"
  description="Orientacinės ArbCut kainos: medžių pjovimas ir genėjimas nuo 50 €, kelmų frezavimas nuo 75 €, išvežimas nuo 80 €. Kas lemia galutinę kainą ir kaip ją sužinoti greičiau."
  schemas={[localBusiness(), faqPage(duk), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Kainos', path: '/kainos' }])]}
>
  <PageHero
    title="Kainos ir kas jas lemia"
    kicker="Orientacinės kainos"
    lead="Kiekvienas medis kitoks, todėl skelbiame kainas „nuo“ ir aiškiai sakome, kas jas didina. Tikslią kainą pasakome pamatę darbą vietoje arba nuotraukose."
    crumbs={[{ label: 'Kainos' }]}
    photo="azuolai-prie-namo"
    photoAlt="Ąžuolai prie namo, kuriuos prižiūri ArbCut"
    photoPos="50% 45%"
  />

  <section class="sec">
    <div class="wrap pr">
      <div>
        {grupes.map((g) => (
          <div class="pr__grp">
            <h2>{g.pavadinimas}</h2>
            <table class="pr__t">
              <thead><tr><th scope="col">Paslauga</th><th scope="col">Kaina</th></tr></thead>
              <tbody>
                {g.slugs.map((s) => (
                  <tr><th scope="row"><a href={`/paslaugos/${s}`}>{detales[s].h1}</a></th><td>{byslug[s].kaina}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        ))}
        <p class="pr__src">Kainos „nuo“ paimtos iš ArbCut profilio Paslaugos.lt (duomenys {atsiliepimuSinchronizuota}). Galutinė kaina sutariama prieš darbus.</p>
      </div>
      <aside class="pr__side">
        <div class="panel cut">
          <h2 class="pr__h">Kas lemia kainą</h2>
          <ol class="steps" role="list">
            <li><strong>Medžio dydis.</strong> Aukštus, storus medžius pjauname dalimis — tai užtrunka ilgiau.</li>
            <li><strong>Vieta ir prieiga.</strong> Prie namo, tvoros ar laidų reikia nuleisti kiekvieną dalį virvėmis.</li>
            <li><strong>Technika.</strong> Ar privažiuoja autobokštelis, ar reikia lipti su alpinistine įranga.</li>
            <li><strong>Sutvarkymas.</strong> Išvežimas (Kaune ir Kauno rajone) ir kelmo frezavimas.</li>
          </ol>
        </div>
        {pavyzdys && (
          <figure class="pr__ex">
            <p class="kicker">Pavyzdys iš atsiliepimo</p>
            <blockquote>„{pavyzdys.tekstas}“</blockquote>
            <figcaption>{pavyzdys.vardas}, Paslaugos.lt, {pavyzdys.data.slice(0, 7)}</figcaption>
          </figure>
        )}
      </aside>
    </div>
  </section>

  <section class="sec sec--stone">
    <div class="wrap two">
      <div class="sec-head">
        <p class="kicker">Kaip sužinoti kainą greičiau</p>
        <h2>Atsiųskite tai, ką matote</h2>
        <ul class="ticks">
          <li>2–3 nuotraukos iš toliau, kad matytųsi medis ir kas aplink</li>
          <li>Adresas arba vietovė</li>
          <li>Ar reikia išvežti medieną ir pašalinti kelmą</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.telefonasHref} data-loc="prices-call"><span class="btn__num">{site.telefonas}</span></a>
          <button type="button" class="btn btn--line" data-quote>Gauti kainą</button>
        </div>
        <p class="mute">Nuotraukas galite siųsti el. paštu <a href={`mailto:${site.elPastas}`}>{site.elPastas}</a>.</p>
      </div>
      <div>
        <h2 class="pr__h2">Klausimai apie kainą</h2>
        <Faq items={duk} />
        <p class="mute pr__more">Plačiau: <a href="/tinklarastis/kiek-kainuoja-medzio-pasalinimas">Kiek kainuoja medžio pašalinimas Lietuvoje?</a></p>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .pr { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .pr__grp + .pr__grp { margin-top: 48px; }
  .pr__grp h2 { font-size: clamp(1.45rem, 1.25rem + .8vw, 1.9rem); margin-bottom: 14px; color: var(--spruce-900); }
  .pr__t { width: 100%; border-collapse: separate; border-spacing: 0 6px; }
  .pr__t thead th { text-align: left; font-size: 1rem; color: var(--ink-2); padding: 0 16px 2px; font-weight: 700; }
  .pr__t thead th:last-child, .pr__t td { text-align: right; }
  .pr__t tbody th, .pr__t td { padding: 15px 16px; background: var(--stone); vertical-align: baseline; }
  .pr__t tbody th { text-align: left; font-weight: 650; line-height: 1.3; }
  .pr__t tbody th a { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; text-decoration-color: var(--orange); }
  .pr__t tbody th a:hover { color: var(--orange-ink); }
  .pr__t td { font-stretch: var(--wide); font-weight: 800; font-size: 1.15rem; white-space: nowrap; color: var(--spruce-900); }
  .pr__src { margin-top: 20px; font-size: 1rem; color: var(--ink-2); }
  .pr__side { display: grid; gap: 14px; position: sticky; top: calc(64px + 20px); }
  .pr__h { font-size: clamp(1.4rem, 1.2rem + .6vw, 1.7rem); margin-bottom: 14px; color: var(--spruce-900); }
  .pr__ex { background: var(--spruce-900); color: #fff; padding: clamp(22px, 3vw, 30px); display: grid; gap: 10px; }
  .pr__ex .kicker { color: var(--on-dark-2); }
  .pr__ex blockquote { font-size: 1.2rem; line-height: 1.4; overflow-wrap: anywhere; }
  .pr__ex figcaption { color: var(--on-dark-2); font-size: 1rem; }
  .two .sec-head { gap: 18px; }
  .two a:not(.btn) { color: var(--spruce-900); font-weight: 650; text-decoration: underline; text-decoration-color: var(--orange); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .pr__h2 { font-size: clamp(1.5rem, 1.25rem + 1vw, 2.05rem); margin-bottom: 14px; color: var(--spruce-900); }
  .pr__more { margin-top: 16px; }
  @media (max-width: 960px) { .pr { grid-template-columns: 1fr; } .pr__side { position: static; } }
  @media (max-width: 600px) {
    .pr__t thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .pr__t, .pr__t tbody { display: block; }
    .pr__t tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 12px; align-items: baseline; padding: 14px 14px; background: var(--stone); margin-bottom: 6px; }
    .pr__t tbody th, .pr__t td { padding: 0; background: none; }
  }
</style>
