---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Emergency from '../components/home/Emergency.astro';
import Services from '../components/home/Services.astro';
import Moments from '../components/home/Moments.astro';
import Press from '../components/home/Press.astro';
import SendPhotos from '../components/home/SendPhotos.astro';
import ReviewBoard from '../components/home/ReviewBoard.astro';
import AreaMap from '../components/home/AreaMap.astro';
import Faq from '../components/Faq.astro';
import { site } from '@data/site.js';
import { dukPradzia } from '@data/turinys.js';
import { localBusiness, faqPage } from '@data/jsonld.js';
---
<BaseLayout
  title="Medžių pjovimas Kaune ir darbai aukštyje iki 20 m | ArbCut"
  description="Arboristas aukštalipys Mantas Gerulis su komanda: pavojingų medžių pjovimas dalimis, genėjimas, kelmai, autobokštelis iki 20 m. Kaunas ir iki 200 km. +370 603 66901."
  schemas={[localBusiness(), faqPage(dukPradzia)]}
>
  <Hero />
  <Emergency />
  <Services />
  <Moments />
  <Press />
  <SendPhotos />
  <ReviewBoard />
  <AreaMap />

  <section class="faqs on-stone" id="duk" aria-labelledby="duk-h">
    <div class="wrap faqs__grid">
      <div class="faqs__side">
        <h2 id="duk-h">Klausimai prieš skambinant</h2>
        <div class="call cut">
          <p class="call__h">Neradote atsakymo? Paklauskite Manto.</p>
          <a class="call__tel" href={site.telefonasHref} data-loc="faq-call">{site.telefonas}</a>
          <p class="call__s">Kasdien 08:00–18:00</p>
          <div class="call__btns">
            <a class="btn btn--primary btn--sm" href={site.smsHref} data-loc="faq-sms">Siųsti nuotraukas</a>
            <button type="button" class="btn btn--line btn--sm" data-quote>Gauti kainą raštu</button>
          </div>
        </div>
      </div>
      <Faq items={dukPradzia} openFirst />
    </div>
  </section>
</BaseLayout>

<style>
  .faqs { background: var(--stone); padding-block: var(--sec); }
  .faqs__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .faqs__side { display: grid; gap: 28px; position: sticky; top: calc(var(--header-h) + 24px); }
  .faqs h2 { color: var(--spruce-900); }
  .call { background: var(--paper); padding: 28px 28px 30px; display: grid; gap: 10px; }
  .call__h { font-stretch: var(--wide); font-size: 1.3rem; font-weight: 800; line-height: 1.2; color: var(--spruce-900); }
  .call__tel { justify-self: start; font-stretch: var(--wide); font-weight: 800; font-size: clamp(2rem, 1.5rem + 1.6vw, 3rem); line-height: 1.1; letter-spacing: -.015em; color: var(--spruce-900); white-space: nowrap; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 3px; text-underline-offset: 7px; }
  .call__tel:hover { color: var(--orange-ink); }
  .call__s { color: var(--ink-2); }
  .call__btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  @media (max-width: 960px) {
    .faqs__grid { grid-template-columns: 1fr; }
    .faqs__side { display: contents; }
    .call { order: 3; }
  }
  @media (max-width: 480px) { .call { padding: 22px 16px; } .call__btns .btn { width: 100%; } .call__tel { font-size: 1.85rem; } }
</style>
