---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Sequences from '../components/Sequences.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '@data/site.js';
import { vietoves } from '@data/vietoves.js';
import { situacijos } from '@data/paslaugu-turinys.js';
import { duk } from '@data/turinys.js';
import { atsiliepimuKiekis, atsiliepimuVidurkis, patirtisMetai } from '@data/atsiliepimai.js';
import { atrinkti } from '@data/atrinkti.js';
import { localBusiness, faqPage } from '@data/jsonld.js';

const reviews = atrinkti({ n: 3, min: 160, max: 520 });
const rating = atsiliepimuVidurkis.toFixed(1).replace('.', ',');
---
<BaseLayout
  title="Medžių pjovimas, genėjimas ir darbai aukštyje Kaune | ArbCut"
  description="Arboristas aukštalipys Mantas Gerulis su komanda: pavojingų medžių pjovimas dalimis, genėjimas, kelmų frezavimas ir darbai nuosavu autobokšteliu iki 20 m. +370 603 66901."
  schemas={[localBusiness(), faqPage(duk)]}
>
  <!-- HERO: situacija → paslauga, reali Manto nuotrauka -->
  <section class="hero on-dark">
    <div class="hero__l">
      <div class="hero__txt">
        <p class="kicker">Arboristas aukštalipys {site.savininkas} su komanda</p>
        <h1>Medis kelia nerimą? Nuimsime jį saugiai&nbsp;— dalimis.</h1>
        <p class="lead">Pjauname pavojingus medžius prie namų, tvorų ir elektros laidų, genime, frezuojame kelmus. Dirbame alpinistine įranga ir nuosavu autobokšteliu iki 20&nbsp;m.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={site.telefonasHref} data-loc="hero-call"><Icon name="phone" size={18} /> {site.telefonas}</a>
          <button type="button" class="btn btn--line" data-quote>Gauti kainą</button>
        </div>
      </div>
      <nav class="sit" aria-labelledby="sit-h">
        <p class="sit__h" id="sit-h">Koks jūsų atvejis?</p>
        <ul role="list" class="sit__list">
          {situacijos.map((s) => (
            <li><a href={`/paslaugos/${s.slug}`}>{s.tekstas}<Icon name="arrow" size={18} /></a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="hero__r ph">
      <Photo name="mantas-portretas" alt="Arboristas Mantas Gerulis su alpinistine įranga ir pjūklu" sizes="(max-width: 960px) 100vw, 45vw" loading="eager" fetchpriority="high" position="50% 22%" />
      <a class="hero__badge" href={site.atsiliepimai.profilis} target="_blank" rel="noopener">
        <span class="serif hero__badge-n">{rating}</span>
        <span><strong>{atsiliepimuKiekis} atsiliepimai</strong><br />Paslaugos.lt profilyje <Icon name="external" size={13} /></span>
      </a>
    </div>
  </section>

  <!-- Faktai -->
  <section class="facts" aria-label="Svarbiausi faktai">
    <div class="wrap facts__in">
      <div><strong>Dalimis, virvėmis</strong><span>prie pastatų ir laidų</span></div>
      <div><strong>Autobokštelis iki 20 m</strong><span>nuosavas, aukščiau — alpinistinė įranga</span></div>
      <div><strong>Išvežame medieną</strong><span>Kaune ir Kauno rajone</span></div>
      <div><strong>{patirtisMetai} m. patirtis</strong><span>kasdien 08:00–18:00</span></div>
    </div>
  </section>

  <!-- Paslaugos -->
  <section class="sec" id="paslaugos">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="kicker">Paslaugos</p>
          <h2>Ką darome</h2>
        </div>
        <p class="mute" style="max-width:34rem">Kainos „nuo“ — iš mūsų Paslaugos.lt profilio. Tikslią kainą pasakome pamatę medį ar darbą vietoje arba nuotraukose.</p>
      </div>
      <ServiceIndex />
    </div>
  </section>

  <!-- Darbo eiga -->
  <section class="sec sec--white rule-top" id="darbai">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div>
          <p class="kicker">Darbai</p>
          <h2>Kaip atrodo darbas</h2>
        </div>
        <a class="btn btn--line" href="/galerija">Visos darbų nuotraukos</a>
      </div>
      <Sequences />
    </div>
  </section>

  <!-- Kaip dirbame + technika -->
  <section class="sec">
    <div class="wrap how">
      <div class="how__ph">
        <div class="ph how__big"><Photo name="autobokstelis-prie-namo" alt="ArbCut autobokštelis dirba prie namo" sizes="(max-width: 860px) 100vw, 40vw" position="50% 60%" /></div>
        <div class="ph how__small"><Photo name="du-arboristai-lajoje" alt="Du arboristai dirba didelio medžio lajoje" sizes="(max-width: 860px) 50vw, 20vw" position="50% 35%" /></div>
      </div>
      <div class="how__txt">
        <p class="kicker">Kaip dirbame</p>
        <h2>Nuo skambučio iki sutvarkyto kiemo</h2>
        <ol class="steps" role="list">
          <li><strong>Skambutis ar užklausa.</strong> Trumpai papasakokite, kas nutiko. Padeda kelios nuotraukos ar vaizdo įrašas.</li>
          <li><strong>Įvertinimas ir kaina.</strong> Įvertiname vietoje arba pagal nuotraukas ir pasakome kainą iš anksto.</li>
          <li><strong>Darbas.</strong> Atvykstame sutartu laiku. Medį pjauname dalimis, šakas nuleidžiame virvėmis arba nuimame nuo autobokštelio.</li>
          <li><strong>Sutvarkymas.</strong> Surenkame šakas. Kaune ir Kauno rajone medieną išvežame fiskaru, toliau sukrauname tvarkingai krūvoje.</li>
        </ol>
        <a class="link-arrow" href="/apie">Apie Mantą ir komandą <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Atsiliepimai -->
  <section class="sec sec--paper2">
    <div class="wrap"><Reviews items={reviews} heading="Ką sako klientai po darbų" /></div>
  </section>

  <!-- Kur dirbame -->
  <section class="sec">
    <div class="wrap area">
      <div>
        <p class="kicker">Kur dirbame</p>
        <h2>Bazė — Kaunas. Išvykstame ir toliau.</h2>
        <p class="lead">Dažniausiai dirbame Kaune ir Kauno apskrityje. Į kitus miestus išvykstame suderinę datą iš anksto — kelių kaimynų darbus galima atlikti per vieną atvykimą.</p>
        <p class="area__note"><strong>Medienos išvežimas</strong> — tik Kaune ir Kauno rajone. Kitur medį nupjauname, sutvarkome, o šakas ir medieną sukrauname krūvoje.</p>
      </div>
      <ul role="list" class="area__list">
        {vietoves.map((v) => (
          <li><a href={`/${v.slug}`}><span>{v.miestas}</span><small>{v.pagrindinis ? 'Bazė' : 'Medžių pjovimas'}</small><Icon name="arrow" size={16} /></a></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- DUK -->
  <section class="sec sec--white rule-top">
    <div class="wrap faqwrap">
      <div class="sec-head">
        <p class="kicker">DUK</p>
        <h2>Dažniausi klausimai</h2>
        <a class="link-arrow" href="/kainos">Kas lemia kainą <Icon name="arrow" size={16} /></a>
      </div>
      <Faq items={duk} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); background: var(--ink); color: var(--paper); min-height: min(760px, calc(100svh - 114px)); }
  .hero__l { display: grid; gap: 36px; align-content: center; padding: clamp(40px, 6vw, 80px) clamp(24px, 5vw, 72px) clamp(40px, 5vw, 64px) max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter))); }
  .hero__txt { display: grid; gap: 20px; }
  .hero h1 { max-width: 15ch; }
  .sit__h { font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--sand); margin-bottom: 12px; }
  .sit__list { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .sit__list a { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 54px; padding: 12px 16px; border: 1px solid var(--line-dark); font-weight: 600; transition: background var(--t), border-color var(--t); }
  .sit__list a:hover { background: var(--ink-3); border-color: var(--sand); }
  .sit__list a svg { color: var(--sand); flex: 0 0 auto; transition: transform var(--t); }
  .sit__list a:hover svg { transform: translateX(3px); }
  .hero__r { min-height: 420px; }
  .hero__r :global(img) { position: absolute; inset: 0; }
  .hero__badge { position: absolute; left: 24px; bottom: 24px; display: flex; align-items: center; gap: 14px; background: var(--paper); color: var(--ink); padding: 14px 18px; line-height: 1.3; font-size: .92rem; box-shadow: 0 10px 30px rgba(0,0,0,.2); }
  .hero__badge-n { font-size: 2.4rem; font-weight: 650; line-height: 1; }

  .facts { background: var(--paper); border-bottom: 1px solid var(--line); }
  .facts__in { display: grid; grid-template-columns: repeat(4, 1fr); }
  .facts__in > div { display: grid; gap: 2px; padding: 22px 24px; border-left: 1px solid var(--line); }
  .facts__in > div:first-child { border-left: 0; padding-left: 0; }
  .facts strong { font-size: 1.05rem; }
  .facts span { color: var(--mute); font-size: .92rem; }

  .how { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .how__ph { display: grid; grid-template-columns: 1.4fr 1fr; gap: 12px; align-items: end; }
  .how__big { aspect-ratio: 4 / 5; }
  .how__small { aspect-ratio: 3 / 5; }
  .how__txt { display: grid; gap: 20px; }
  .how .steps li strong { display: block; font-size: 1.05rem; }

  .area { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .area > div { display: grid; gap: 18px; }
  .area__note { padding: 16px 18px; background: var(--white); border-left: 4px solid var(--timber); }
  .area__list { border-top: 2px solid var(--ink); }
  .area__list a { display: grid; grid-template-columns: 1fr auto 20px; gap: 16px; align-items: center; padding: 14px 4px; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: 1.2rem; font-weight: 600; }
  .area__list small { font-family: var(--sans); font-size: .85rem; color: var(--mute); font-weight: 450; }
  .area__list a:hover span { color: var(--timber); }
  .faqwrap { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 72px); align-items: start; }

  @media (max-width: 960px) {
    .hero { grid-template-columns: 1fr; min-height: 0; }
    .hero__l { padding: 40px var(--gutter); }
    .hero__r { order: -1; min-height: 0; aspect-ratio: 4 / 3; }
    .facts__in { grid-template-columns: 1fr 1fr; }
    .facts__in > div { padding: 16px 0 16px 16px; }
    .facts__in > div:nth-child(odd) { border-left: 0; padding-left: 0; }
    .facts__in > div:nth-child(n+3) { border-top: 1px solid var(--line); }
    .how, .area, .faqwrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .sit__list { grid-template-columns: 1fr; }
    .hero__r { aspect-ratio: 1 / 1; }
    .hero__badge { left: 12px; bottom: 12px; padding: 10px 14px; }
    .hero__badge-n { font-size: 1.9rem; }
  }
</style>
