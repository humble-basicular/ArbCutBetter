---
/* v5 pradžia: pardavimo puslapio stuburas (dizaino smegenys v5, C1).
   Tvarka: pirmas ekranas + forma → skubu → paslaugos → darbai → eiga → Mantas → spauda → atsiliepimai
   → zona su žemėlapiu → DUK → poraštė su Lietuvos simboliu (audito pastaba 2026-11-06: darbai prieš eigą). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Emergency from '../components/home/Emergency.astro';
import Services from '../components/home/Services.astro';
import SendPhotos from '../components/home/SendPhotos.astro';
import MantoPazadas from '../components/home/MantoPazadas.astro';
import Moments from '../components/home/Moments.astro';
import Press from '../components/home/Press.astro';
import ReviewBoard from '../components/home/ReviewBoard.astro';
import AreaMap from '../components/home/AreaMap.astro';
import Faq from '../components/Faq.astro';
import { site } from '@data/site.js';
import { dukPradzia } from '@data/turinys.js';
import { localBusiness, faqPage, person } from '@data/jsonld.js';
import { Image } from 'astro:assets';
import face from '../assets/photos/mantas-portretas.jpg';
const I = '/assets/v5-brand/raster/icons';
---
<BaseLayout
  title="Medžių pjovimas Kaune ir darbai aukštyje iki 20 m | ArbCut"
  description={`Arboristas aukštalipys Mantas Gerulis su komanda: pavojingų medžių pjovimas dalimis, genėjimas, kelmai, autobokštelis iki 20 m. Kaunas ir iki ${site.zona.km} km. ${site.telefonas}.`}
  schemas={[localBusiness(), faqPage(dukPradzia), person()]}
>
  <Hero />
  <Emergency />
  <Services />
  <Moments />
  <SendPhotos />
  <MantoPazadas />
  <Press />
  <ReviewBoard />
  <AreaMap />

  <section class="faqs" id="duk" aria-labelledby="duk-h">
    <div class="wrap faqs__grid">
      <div class="faqs__side">
        <p class="kick">DUK</p>
        <h2 id="duk-h">Klausimai prieš skambinant</h2>
        <div class="call">
          <div class="call__who">
            <Image class="call__face" src={face} alt="" widths={[96, 192]} sizes="80px" format="webp" quality={80} style="object-position: 50% 18%" />
            <p class="call__h">Neradote atsakymo? <span class="hand">Paklauskite Manto.</span></p>
          </div>
          <a class="call__tel" href={site.telefonasHref} data-loc="faq-call"><span class="ico-c" style="--cs:44px"><img src={`${I}/ui-phone-160.png`} alt="" width="30" height="30" /></span>{site.telefonas}</a>
          <p class="call__s">Kasdien 08:00–18:00</p>
          <div class="call__btns">
            <a class="btn btn--primary btn--sm" href={site.smsHref} data-loc="faq-sms">Siųsti nuotraukas</a>
            <button type="button" class="btn btn--line btn--sm" data-quote>Gauti kainą</button>
          </div>
        </div>
      </div>
      <Faq items={dukPradzia} openFirst />
    </div>
  </section>
</BaseLayout>

<style>
  .faqs { background: var(--spruce-50); padding-block: clamp(72px, 8vw, 128px); }
  .faqs__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .faqs__side { display: grid; gap: 16px; position: sticky; top: calc(var(--header-h) + 24px); }
  .faqs h2 { color: var(--spruce-900); margin-bottom: 12px; }
  .call { background: var(--spruce-900); color: #fff; border-radius: var(--r-lg); padding: 26px 26px 28px; display: grid; gap: 12px; box-shadow: var(--sh-2); }
  .call__who { display: flex; align-items: center; gap: 14px; }
  .call__face { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 3px solid var(--gold); flex: 0 0 auto; }
  .call__h { font-weight: 700; font-size: 1.1rem; line-height: 1.2; color: var(--on-dark-2); }
  .call__h .hand { display: block; color: #fff; font-size: 2rem; }
  .call__tel { justify-self: start; display: inline-flex; align-items: center; gap: 12px; font-family: var(--display); font-weight: 800; font-size: clamp(1.9rem, 1.4rem + 1.6vw, 2.7rem); line-height: 1.1; letter-spacing: -.015em; color: #fff; white-space: nowrap; }
  .call__tel:hover { color: var(--gold); }
  .call__s { color: var(--on-dark-2); }
  .call__btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  .call .btn--line { color: #fff; border-color: rgba(255,255,255,.6); background: transparent; }
  .call .btn--line:hover { background: #fff; color: var(--spruce-900); }
  @media (max-width: 960px) {
    .faqs__grid { grid-template-columns: 1fr; }
    .faqs__side { display: contents; }
    .call { order: 3; }
  }
  @media (max-width: 480px) { .call { padding: 22px 16px; } .call__btns .btn { width: 100%; } .call__tel { font-size: 1.7rem; } }
</style>
