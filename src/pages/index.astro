---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Emergency from '../components/home/Emergency.astro';
import Services from '../components/home/Services.astro';
import Moments from '../components/home/Moments.astro';
import Press from '../components/home/Press.astro';
import SendPhotos from '../components/home/SendPhotos.astro';
import ReviewBoard from '../components/home/ReviewBoard.astro';
import AreaMap from '../components/home/AreaMap.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { site } from '@data/site.js';
import { dukPradzia } from '@data/turinys.js';
import { localBusiness, faqPage } from '@data/jsonld.js';
---
<BaseLayout
  title="Medžių pjovimas Kaune ir darbai aukštyje iki 20 m | ArbCut"
  description="Arboristas aukštalipys Mantas Gerulis su komanda: pavojingų medžių pjovimas dalimis, genėjimas, kelmai, autobokštelis iki 20 m. Kaunas ir iki 200 km. +370 603 66901."
  schemas={[localBusiness(), faqPage(dukPradzia)]}
>
  <Hero />
  <Emergency />
  <Services />
  <Moments />
  <Press />
  <SendPhotos />
  <ReviewBoard />
  <AreaMap />

  <section class="faqs" id="duk" aria-labelledby="duk-h">
    <div class="wrap faqs__grid">
      <div class="faqs__side">
        <h2 id="duk-h">Klausimai prieš skambinant</h2>
        <div class="call">
          <p class="call__h">Neradote atsakymo? Paklauskite Manto.</p>
          <a class="call__tel" href={site.telefonasHref} data-loc="faq-call"><Icon name="phone" size={34} /> {site.telefonas}</a>
          <p class="call__s">Kasdien 08:00–18:00</p>
          <div class="call__btns">
            <a class="btn btn--primary btn--sm" href={site.smsHref} data-loc="faq-sms"><Icon name="sms" size={20} /> Siųsti nuotraukas</a>
            <button type="button" class="btn btn--line btn--sm" data-quote>Gauti kainą raštu</button>
          </div>
        </div>
      </div>
      <Faq items={dukPradzia} openFirst />
    </div>
  </section>
</BaseLayout>

<style>
  .faqs { background: var(--cream); padding-block: var(--sec); }
  .faqs__grid { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .faqs__side { display: grid; gap: 28px; position: sticky; top: calc(var(--header-h) + 24px); }
  .faqs h2 { font-size: clamp(2.6rem, 1.4rem + 4vw, 5rem); font-weight: 700; color: var(--f0); }
  .call { background: var(--f0); color: var(--cream); padding: 28px 28px 30px; border-top: 8px solid var(--rust); display: grid; gap: 10px; box-shadow: var(--shadow); }
  .call :focus-visible { outline-color: var(--amber); }
  .call__h { font-family: var(--display); font-size: 1.6rem; font-weight: 600; text-transform: uppercase; line-height: 1.12; }
  .call__tel { display: inline-flex; align-items: center; gap: 12px; font-family: var(--display); font-weight: 700; font-size: clamp(2.3rem, 1.6rem + 2vw, 3.4rem); line-height: 1.12; color: var(--amber); white-space: nowrap; }
  .call__tel:hover { color: #ffc77a; }
  .call__s { color: var(--on-dark-2); }
  .call__btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .call .btn--line { color: var(--cream); }
  .call .btn--line:hover { background: var(--cream); color: var(--f0); border-color: var(--cream); }
  @media (max-width: 960px) {
    .faqs__grid { grid-template-columns: 1fr; }
    .faqs__side { display: contents; }
    .call { order: 3; }
  }
  @media (max-width: 480px) { .call { padding: 22px 16px; } .call__btns .btn { width: 100%; } .call__tel { font-size: 2rem; } }
</style>
