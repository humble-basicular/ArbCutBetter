---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { site } from '@data/site.js';
import { vietoves } from '@data/vietoves.js';
import { localBusiness, breadcrumbs } from '@data/jsonld.js';
---
<BaseLayout
  title="Kontaktai — ArbCut, Kaunas · +370 603 66901"
  description="Susisiekite su ArbCut: +370 603 66901, aukstuminiai.darbai@yahoo.com. Kasdien 08:00–18:00. Bazė Kaune, išvykstame ir į kitus miestus."
  schemas={[localBusiness(), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Kontaktai', path: '/kontaktai' }])]}
>
  <PageHero title="Kontaktai" kicker="Susisiekite" lead="Greičiausia — paskambinti. Jei patogiau rašyti, užpildykite formą ir, jei galite, atsiųskite nuotraukų el. paštu." crumbs={[{ label: 'Kontaktai' }]} actions={false} />
  <section class="sec">
    <div class="wrap ct">
      <div class="ct__info">
        <a class="ct__big cut" href={site.telefonasHref} data-loc="contact-call"><small>Telefonas</small><span>{site.telefonas}</span></a>
        <dl class="ct__facts">
          <div><dt>El. paštas</dt><dd><a class="textlink" href={`mailto:${site.elPastas}`}>{site.elPastas}</a></dd></div>
          <div><dt>Darbo laikas</dt><dd>Kasdien 08:00–18:00</dd></div>
          <div><dt>Bazė</dt><dd>Kaunas, Kauno apskritis. Išvykstame ir į kitus miestus.</dd></div>
        </dl>
        <div class="ct__links">
          <a class="link-arrow" href={site.facebook} target="_blank" rel="noopener">Facebook<span class="sr-only"> (atsidaro naujame lange)</span></a>
          <a class="link-arrow" href="/atsiliepimai">Klientų atsiliepimai</a>
        </div>
        <div class="ct__towns">
          <p class="kicker">Miestai</p>
          <ul role="list" class="linkcols">{vietoves.map((v) => <li><a href={`/${v.slug}`}>{v.miestas}</a></li>)}</ul>
        </div>
      </div>
      <div class="panel cut ct__form">
        <h2>Užklausa</h2>
        <p class="mute">Atsakome darbo valandomis. Skubiu atveju skambinkite.</p>
        <QuoteForm id="contact-form" prefix="c" />
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .ct { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .ct__info { display: grid; gap: 28px; }
  .ct__big { display: grid; gap: 4px; padding: clamp(22px, 3vw, 32px); background: var(--spruce-900); color: #fff; }
  .ct__big small { font-size: 1rem; font-weight: 600; color: var(--on-dark-2); }
  .ct__big span { font-family: var(--display); font-weight: 800; font-size: clamp(1.7rem, 1.25rem + 2vw, 2.7rem); line-height: 1.1; white-space: nowrap; text-decoration: underline; text-decoration-color: var(--orange); text-decoration-thickness: 3px; text-underline-offset: 7px; }
  .ct__facts { display: grid; gap: 18px; }
  .ct__facts dt { font-size: 1rem; font-weight: 700; color: var(--spruce-700); }
  .ct__facts dd { margin: 0; overflow-wrap: anywhere; }
  .ct__links { display: flex; gap: 12px 24px; flex-wrap: wrap; }
  .ct__towns { display: grid; gap: 8px; }
  .ct__form { display: grid; gap: 12px; position: sticky; top: calc(64px + 20px); }
  .ct__form h2 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); color: var(--spruce-900); }
  @media (max-width: 960px) { .ct { grid-template-columns: 1fr; } .ct__form { position: static; } }
</style>
