---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '@data/site.js';
import { breadcrumbs } from '@data/jsonld.js';

const title = 'Privatumo politika — ArbCut';
const description = 'Kaip ArbCut renka ir naudoja per svetainės užklausos formą pateiktus duomenis.';
const schemas = [breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Privatumo politika', path: '/privatumo-politika' }])];
---
<BaseLayout title={title} description={description} noindex={true} schemas={schemas}>
    <PageHero kicker="Teisinė informacija" title="Privatumo politika" crumbs={[{ label: 'Privatumo politika' }]} actions={false} />
    <section class="sec">
      <div class="wrap"><div class="prose">
        <p><em>Atnaujinta: 2026 m.</em></p>
        <p>Ši privatumo politika paaiškina, kaip {site.pavadinimas} ({site.savininkas}) tvarko asmens duomenis, pateiktus per šios svetainės užklausos formą ar susisiekus telefonu bei el. paštu.</p>

        <h2>Kokius duomenis renkame</h2>
        <ul>
          <li>Vardą;</li>
          <li>Kontaktinius duomenis (telefono numerį ir (arba) el. paštą);</li>
          <li>Jūsų žinutę ir su darbu susijusią informaciją (pvz. miestą, darbo aprašymą).</li>
        </ul>
        <p>Renkame tik tuos duomenis, kuriuos pateikiate savanoriškai, norėdami gauti pasiūlymą ar konsultaciją.</p>

        <h2>Kam naudojame duomenis</h2>
        <ul>
          <li>Susisiekti su jumis ir atsakyti į užklausą;</li>
          <li>Pateikti paslaugos pasiūlymą ir suderinti darbus.</li>
        </ul>
        <p>Duomenų nenaudojame reklamai be jūsų sutikimo ir neperduodame trečiosioms šalims, išskyrus tiek, kiek būtina užklausai pristatyti (formos pranešimus tvarko paslauga „Web3Forms", o apsaugai nuo šiukšlių naudojamas „hCaptcha").</p>
        <p>Rašant adresą, įvesti simboliai siunčiami paslaugai „Photon“ (Komoot), kad būtų parodyti adresų pasiūlymai. Paspaudus „Mano vieta“, naršyklė, jums leidus, nustato jūsų vietą: koordinatės siunčiamos tai pačiai paslaugai adresui rasti ir kartu su užklausa perduodamos Mantui. Be jūsų paspaudimo vietos nenustatome.</p>

        <h2>Saugojimas</h2>
        <p>Užklausų duomenis saugome tiek, kiek reikia jūsų užklausai išnagrinėti ir įprastam bendravimui dėl paslaugų. Vėliau jie pašalinami arba nuasmeninami.</p>

        <h2>Jūsų teisės</h2>
        <p>Galite bet kada kreiptis ir paprašyti susipažinti su savo duomenimis, juos ištaisyti arba ištrinti. Tam susisiekite: <a href={site.telefonasHref} data-loc="privacy-rights">{site.telefonas}</a> arba <a href={`mailto:${site.elPastas}`}>{site.elPastas}</a>.</p>

        <h2>Slapukai</h2>
        <p>Svetainė nenaudoja sekimo ar rinkodaros slapukų. Funkciniai trečiųjų šalių komponentai (pvz. „hCaptcha") gali naudoti techninius slapukus savo veikimui užtikrinti.</p>
        <p>Anonimiškai skaičiuojame, kiek kartų paspaudžiamas skambučio mygtukas, atidaroma ir išsiunčiama užklausos forma (puslapis, mygtuko vieta, ar atėjote iš paieškos, ir ar įrenginys mobilus). Nenaudojame slapukų, nefiksuojame IP adreso ir jokių asmens duomenų.</p>

        <h2>Kontaktai</h2>
        <p>{site.pavadinimas}, {site.savininkas}<br />Tel.: <a href={site.telefonasHref} data-loc="privacy-contact">{site.telefonas}</a><br />El. paštas: <a href={`mailto:${site.elPastas}`}>{site.elPastas}</a></p>
      </div></div>
    </section>
</BaseLayout>

