---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ReviewCard from '../components/ReviewCard.astro';
import Stars from '../components/v5/Stars.astro';
import { site } from '@data/site.js';
import { visiAtsiliepimai, bendrasKiekis, bendrasIvertinimas } from '@data/atsiliepimai-visi.js';
import { localBusiness, breadcrumbs } from '@data/jsonld.js';
const rating = bendrasIvertinimas.toFixed(1).replace('.', ',');
const suTekstu = visiAtsiliepimai.filter((a) => a.tekstas && a.tekstas.trim() && !a.vardas.startsWith('Paslaugos.lt'));
const PIRMI = 24;
---
<BaseLayout
  title={`Atsiliepimai apie ArbCut: ${rating} iš 5, ${bendrasKiekis} atsiliepimai`}
  description={`Ką klientai rašo apie ArbCut ir Mantą Gerulį: ${rating} iš 5, ${bendrasKiekis} atsiliepimai. Originalūs tekstai, prie kiekvieno nurodytas šaltinis.`}
  schemas={[localBusiness(), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Atsiliepimai', path: '/atsiliepimai' }])]}
>
  <PageHero title="Ką rašo klientai" kicker="Atsiliepimai" lead="Originalūs klientų tekstai, nieko nekeitėme. Prie kiekvieno atsiliepimo matote, kur jis parašytas." crumbs={[{ label: 'Atsiliepimai' }]} actions={false}>
    <div class="sc">
      <span class="sc__n">{rating}</span>
      <span class="sc__t"><Stars size={20} /><br />{bendrasKiekis} atsiliepimai</span>
    </div>
    <div class="btn-row">
      <button type="button" class="btn btn--primary" data-quote>Gauti kainą</button>
      <a class="btn btn--line" href={site.atsiliepimai.ivertinimas} data-loc="reviews-page-write">Parašyti atsiliepimą</a>
    </div>
  </PageHero>
  <section class="sec sec--stone">
    <div class="wrap">
      <ul role="list" class="all" data-all>
        {suTekstu.map((a, i) => <li class:list={{ 'all__more': i >= PIRMI }}><ReviewCard a={a} /></li>)}
      </ul>
      {suTekstu.length > PIRMI && <p class="all__btn"><button type="button" class="btn btn--ink" data-all-more>Rodyti daugiau atsiliepimų</button></p>}
    </div>
  </section>
</BaseLayout>
<script>
  const list = document.querySelector('[data-all]');
  const btn = document.querySelector('[data-all-more]');
  if (list && btn) btn.addEventListener('click', () => {
    const next = [...list.querySelectorAll('.all__more')].slice(0, 24);
    next.forEach((li) => li.classList.remove('all__more'));
    if (!list.querySelector('.all__more')) btn.closest('p').remove();
    const first = next[0] && next[0].querySelector('blockquote');
    if (first) { first.setAttribute('tabindex', '-1'); first.focus({ preventScroll: true }); }
  });
</script>
<style>
  .sc { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; color: var(--spruce-900); }
  .sc__n { font-family: var(--display); font-weight: 800; font-size: 3.4rem; line-height: 1; }
  .sc__t { font-weight: 700; line-height: 1.4; }
  .all { columns: 3 300px; column-gap: 16px; }
  .all li { break-inside: avoid; margin-bottom: 16px; }
  :global(.js) .all__more { display: none; }
  .all__btn { margin-top: 12px; text-align: center; }
</style>
