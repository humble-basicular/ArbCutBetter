---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { vietoves } from '@data/vietoves.js';
import { paslaugos } from '@data/paslaugos.js';
import { grupes, detales } from '@data/paslaugu-turinys.js';
import { duk } from '@data/turinys.js';
import { atrinkti } from '@data/atrinkti.js';
import { localBusiness, breadcrumbs, faqPage } from '@data/jsonld.js';

export function getStaticPaths() {
  return vietoves.map((v) => ({ params: { vietove: v.slug }, props: { v } }));
}
const { v } = Astro.props;
const byslug = Object.fromEntries(paslaugos.map((p) => [p.slug, p]));
const kitos = vietoves.filter((x) => x.slug !== v.slug);
const reviews = atrinkti({ n: 3, min: 140, max: 480 });
const isBase = !!v.pagrindinis;
const townFaq = [
  isBase
    ? { klausimas: `Ar išvežate medieną ${v.kur}?`, atsakymas: 'Taip. Kaune ir Kauno rajone po darbų išvežame šakas ir medieną nuosavu fiskaru (talpa nuo 20 m³). Kas išvežama ir už kokią kainą, sutariame iš anksto.' }
    : { klausimas: `Ar išvežate medieną ${v.kur}?`, atsakymas: 'Medienos išvežimą fiskaru atliekame Kaune ir Kauno rajone. Kitur medį nupjauname, sutvarkome, o šakas ir medieną sukrauname tvarkingoje krūvoje.' },
  { klausimas: `Kaip greitai galite atvykti ${v.kur}?`, atsakymas: isBase ? 'Kaunas — mūsų bazė, todėl čia atvykstame greičiausiai. Tikslų laiką pasakome telefonu pagal tos dienos darbus.' : 'Išvykimo datą suderiname iš anksto. Avariniu atveju paskambinkite — pasakysime, kada realiai galime būti.' },
  ...duk.filter((q) => /elektros|savaitgal/.test(q.klausimas)),
];
const title = `Medžių pjovimas ${v.kur} — arboristas aukštalipys | ArbCut`;
const description = `Medžių pjovimas ${v.kur}: pavojingi medžiai prie namų ir laidų, genėjimas, kelmų frezavimas, darbai autobokšteliu iki 20 m. ${isBase ? 'Išvežame medieną.' : ''} +370 603 66901.`.replace('  ', ' ');
---
<BaseLayout title={title} description={description} schemas={[localBusiness(), faqPage(townFaq), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: `Medžių pjovimas ${v.kur}`, path: `/${v.slug}` }])]}>
  <PageHero
    title={`Medžių pjovimas ${v.kur}`}
    kicker={isBase ? 'Mūsų bazė' : `Arboristas aukštalipys · ${v.miestas}`}
    lead={v.intro}
    crumbs={[{ label: `Medžių pjovimas ${v.kur}` }]}
    photo={isBase ? 'pjovimas-prie-laidu' : 'pusis-alpinistas'}
    photoAlt="Arboristas pjauna aukštą pušį dalimis"
    photoPos="50% 30%"
  />
  <section class="sec">
    <div class="wrap town">
      <div class="town__txt">
        <h2>{isBase ? 'Kaunas ir Kauno rajonas' : `Ką darome ${v.kur}`}</h2>
        <p class="lead">{v.tekstas}</p>
        <div class="town__note">
          {isBase
            ? <p><strong>Išvežame patys.</strong> Kaune ir Kauno rajone šakas ir medieną išvežame fiskaru — kiemas lieka tvarkingas.</p>
            : <p><strong>Medienos išvežimas</strong> — tik Kaune ir Kauno rajone. {v.kur} medieną ir šakas sukrauname tvarkingoje krūvoje.</p>}
        </div>
      </div>
      <div class="town__svc">
        {grupes.map((g) => (
          <div>
            <p class="kicker">{g.pavadinimas}</p>
            <ul role="list" class="rows">
              {g.slugs.filter((s) => isBase || s !== 'saku-isvezimas').map((s) => (
                <li><a href={`/paslaugos/${s}`}><span>{detales[s].trumpas}</span><small>{byslug[s].kaina}</small></a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="sec sec--paper2"><div class="wrap"><Reviews items={reviews} heading="Ką sako klientai" /></div></section>
  <section class="sec">
    <div class="wrap two two--faq">
      <div class="sec-head"><p class="kicker">DUK</p><h2>Klausimai apie darbus {v.kur}</h2></div>
      <Faq items={townFaq} />
    </div>
  </section>
  <section class="sec sec--stone">
    <div class="wrap">
      <p class="kicker">Kiti miestai</p>
      <ul role="list" class="linkcols others">{kitos.map((k) => <li><a href={`/${k.slug}`}>Medžių pjovimas {k.kur}</a></li>)}</ul>
    </div>
  </section>
  <CtaBand title={`Medis ${v.kur}? Aptarkime.`} />
</BaseLayout>
<style>
  .town { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .town__txt { display: grid; gap: 20px; }
  .town__txt h2 { color: var(--spruce-900); }
  .town__note { padding: 18px 20px; background: var(--spruce-100); }
  .town__svc { display: grid; gap: 28px; }
  .town__svc .kicker { margin-bottom: 8px; }
  .others { margin-top: 12px; columns: 3 240px; }
  @media (max-width: 960px) { .town { grid-template-columns: 1fr; } }
</style>
