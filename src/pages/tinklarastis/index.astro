---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { straipsniai } from '@data/straipsniai.js';
import { localBusiness, breadcrumbs } from '@data/jsonld.js';
---
<BaseLayout
  title="Patarimai apie medžius: kainos, leidimai, pavojingi medžiai | ArbCut"
  description="Praktiški arboristo patarimai: kiek kainuoja medžio pašalinimas, ar reikia leidimo, kaip atpažinti pavojingą medį ir ką daryti, jei medis užvirto ant namo."
  schemas={[localBusiness(), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Tinklaraštis', path: '/tinklarastis' }])]}
>
  <PageHero title="Patarimai" kicker="Tinklaraštis" lead="Atsakymai į klausimus, kuriuos klientai užduoda dažniausiai." crumbs={[{ label: 'Tinklaraštis' }]} actions={false} />
  <section class="sec">
    <div class="wrap">
      <ul role="list" class="bl">
        {straipsniai.map((s, i) => (
          <li><a href={`/tinklarastis/${s.slug}`}>
            <span class="bl__n serif">{String(i + 1).padStart(2, '0')}</span>
            <span class="bl__t"><span class="bl__h serif">{s.title}</span><span class="mute">{s.aprasymas}</span></span>
            <span class="bl__m">{s.skaitymas}</span>
            <Icon name="arrow" size={20} />
          </a></li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .bl { border-top: 2px solid var(--ink); }
  .bl a { display: grid; grid-template-columns: 56px minmax(0, 1fr) 70px 24px; gap: 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .bl__n { color: var(--timber); font-size: 1.3rem; font-weight: 650; }
  .bl__t { display: grid; gap: 4px; }
  .bl__h { font-size: 1.35rem; font-weight: 620; line-height: 1.25; }
  .bl a:hover .bl__h { color: var(--timber); }
  .bl__m { font-size: .9rem; color: var(--mute); }
  @media (max-width: 640px) { .bl a { grid-template-columns: 1fr 20px; } .bl__n, .bl__m { display: none; } }
</style>
