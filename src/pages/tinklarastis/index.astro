---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { straipsniai } from '@data/straipsniai.js';
import { localBusiness, breadcrumbs } from '@data/jsonld.js';
---
<BaseLayout
  title="Patarimai apie medžius: kainos, leidimai, pavojingi medžiai | ArbCut"
  description="Praktiški arboristo patarimai: kiek kainuoja medžio pašalinimas, ar reikia leidimo, kaip atpažinti pavojingą medį ir ką daryti, jei medis užvirto ant namo."
  schemas={[localBusiness(), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Tinklaraštis', path: '/tinklarastis' }])]}
>
  <PageHero title="Patarimai" kicker="Tinklaraštis" lead="Atsakymai į klausimus, kuriuos klientai užduoda dažniausiai." crumbs={[{ label: 'Tinklaraštis' }]} actions={false} />
  <section class="sec">
    <div class="wrap">
      <ul role="list" class="bl">
        {straipsniai.map((s) => (
          <li><a href={`/tinklarastis/${s.slug}`}>
            <span class="bl__h">{s.title}</span>
            <span class="bl__d">{s.aprasymas}</span>
            <span class="bl__m">{s.skaitymas}</span>
          </a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
<style>
  .bl { display: grid; gap: 8px; max-width: 58rem; }
  .bl a { display: grid; gap: 6px; padding: clamp(20px, 2.6vw, 28px); background: var(--stone); transition: background var(--t); }
  .bl a:hover { background: var(--spruce-100); }
  .bl__h { font-family: var(--display); font-weight: 800; font-size: clamp(1.25rem, 1.1rem + .7vw, 1.65rem); line-height: 1.18; color: var(--spruce-900); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 4px; text-decoration-color: transparent; transition: text-decoration-color var(--t); }
  .bl a:hover .bl__h { text-decoration-color: var(--orange); }
  .bl__d { color: var(--ink-2); }
  .bl__m { font-size: .98rem; font-weight: 700; color: var(--spruce-700); }
</style>
