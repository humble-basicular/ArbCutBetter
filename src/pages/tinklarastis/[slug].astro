---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Faq from '../../components/Faq.astro';
import { straipsniai } from '@data/straipsniai.js';
import { localBusiness, articleSchema, faqPage, breadcrumbs } from '@data/jsonld.js';

export function getStaticPaths() {
  return straipsniai.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const kiti = straipsniai.filter((x) => x.slug !== s.slug);
const fmt = new Date(s.data).toLocaleDateString('lt-LT', { year: 'numeric', month: 'long', day: 'numeric' });
const schemas = [
  localBusiness(),
  articleSchema(s),
  ...(s.duk && s.duk.length ? [faqPage(s.duk)] : []),
  breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Tinklaraštis', path: '/tinklarastis' }, { name: s.title, path: `/tinklarastis/${s.slug}` }]),
];
---
<BaseLayout title={`${s.title} | ArbCut`} description={s.aprasymas} schemas={schemas}>
  <PageHero title={s.title} kicker={`${fmt} · ${s.skaitymas}`} crumbs={[{ label: 'Tinklaraštis', href: '/tinklarastis' }, { label: s.title }]} actions={false} />
  <section class="sec">
    <div class="wrap art">
      <article class="prose" set:html={s.turinys} />
      <aside class="art__side">
        <div class="panel cut">
          <p class="art__q">Turite klausimą apie savo medį?</p>
          <p class="mute">Atsiųskite nuotrauką arba paskambinkite.</p>
          <div class="art__btns">
            <a class="btn btn--primary" href="tel:+37060366901" data-loc="blog-cta"><span class="btn__num">+370 603 66901</span></a>
            <button type="button" class="btn btn--line" data-quote>Gauti kainą</button>
          </div>
        </div>
      </aside>
    </div>
  </section>
  {s.duk && s.duk.length > 0 && (
    <section class="sec sec--stone"><div class="wrap two two--faq"><h2>Dažni klausimai</h2><Faq items={s.duk} /></div></section>
  )}
  <section class="sec">
    <div class="wrap">
      <p class="kicker">Skaitykite taip pat</p>
      <ul role="list" class="rows more">{kiti.map((k) => <li><a href={`/tinklarastis/${k.slug}`}><span>{k.title}</span></a></li>)}</ul>
    </div>
  </section>
</BaseLayout>
<style>
  .art { display: grid; grid-template-columns: minmax(0, 46rem) 340px; justify-content: space-between; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .art__side { position: sticky; top: calc(64px + 20px); }
  .art__q { font-family: var(--display); font-size: 1.35rem; font-weight: 800; line-height: 1.2; color: var(--spruce-900); margin-bottom: 8px; }
  .art__btns { display: grid; gap: 10px; margin-top: 16px; }
  .more { margin-top: 14px; max-width: 58rem; }
  @media (max-width: 1040px) { .art { grid-template-columns: minmax(0, 1fr); } .art__side { position: static; } }
</style>
