---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Sequences from '../components/Sequences.astro';
import CtaBand from '../components/CtaBand.astro';
import { galerijosKategorijos, galerijosAlt } from '@data/paslaugu-turinys.js';
import { localBusiness, breadcrumbs } from '@data/jsonld.js';
const G = (n) => `/assets/images/galerija/galerija-${String(n).padStart(2, '0')}.jpg`;
const tiles = galerijosKategorijos.flatMap((k) => k.nr.map((n) => ({ src: G(n), cat: k.id, alt: galerijosAlt[k.id] })));
---
<BaseLayout
  title="Atlikti darbai: medžių pjovimas ir darbai aukštyje | ArbCut"
  description="Realios ArbCut darbų nuotraukos: pavojingų medžių pjovimas dalimis, audros padariniai, darbai aukštyje, kelmų frezavimas ir gyvatvorės."
  schemas={[localBusiness(), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Darbai', path: '/galerija' }])]}
>
  <PageHero title="Atlikti darbai" kicker="Realios nuotraukos" lead="Nuotraukos iš mūsų darbų — be stockinių vaizdų. Pirmiausia trys darbai nuo pradžios iki pabaigos, žemiau — visa galerija pagal darbų tipą." crumbs={[{ label: 'Darbai' }]} photo="lajoje-vasara" photoAlt="Mantas dirba žaliuojančio medžio lajoje" photoPos="50% 30%" />

  <section class="sec">
    <div class="wrap">
      <div class="sec-head"><p class="kicker">Darbo eiga</p><h2>Nuo pradžios iki sutvarkytos vietos</h2></div>
      <Sequences />
    </div>
  </section>

  <section class="sec sec--stone">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><p class="kicker">Galerija</p><h2>Visos nuotraukos</h2></div>
        <p class="mute"><span data-gallery-count>{tiles.length}</span> nuotr.</p>
      </div>
      <div class="flt" role="group" aria-label="Rodyti nuotraukas">
        <button type="button" data-filter="visi" aria-pressed="true">Visos</button>
        {galerijosKategorijos.map((k) => <button type="button" data-filter={k.id} aria-pressed="false">{k.pavadinimas} <small>{k.nr.length}</small></button>)}
      </div>
      <ul role="list" class="gal tiles" data-lb-group>
        {tiles.map((t) => (
          <li data-cat={t.cat}>
            <button type="button" data-lightbox={t.src} data-caption={t.alt} aria-label={`Padidinti: ${t.alt}`}>
              <img src={t.src} alt={t.alt} width="283" height="230" loading="lazy" decoding="async" />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .flt { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .flt button { min-height: 44px; padding: 8px 16px; background: var(--paper); font-weight: 650; border-radius: var(--radius); transition: background var(--t), color var(--t); }
  .flt button:hover { background: var(--spruce-100); }
  .flt button small { color: var(--ink-2); font-size: .95rem; font-weight: 600; margin-left: 4px; }
  .flt button[aria-pressed='true'] { background: var(--spruce-900); color: #fff; }
  .flt button[aria-pressed='true'] small { color: var(--on-dark-2); }
  .gal li[hidden] { display: none; }
</style>
