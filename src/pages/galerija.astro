---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Sequences from '../components/Sequences.astro';
import Darbai from '../components/Darbai.astro';
import { galerijosKategorijos, galerijosAlt } from '@data/paslaugu-turinys.js';
import { localBusiness, breadcrumbs } from '@data/jsonld.js';
const G = (n) => `/assets/images/galerija/galerija-${String(n).padStart(2, '0')}.jpg`;
/* Mantas atsiuntė 2026-11-06; nuotraukos ir autobokštelis jo (patvirtinta 2026-11-06). */
const N = (f) => ({ src: `/assets/images/galerija-naujos/${f}.jpg`, thumb: `/assets/images/galerija-naujos/${f}-m.jpg` });
const naujos = [
  { ...N('pusis-bokstelis-virves'), alt: 'Arboristai pušies lajoje: vienas bokštelyje, kitas ant virvių' },
  { ...N('arboristas-bokstelyje'), alt: 'Arboristas ArbCut autobokštelio krepšyje pušies lajoje' },
  { ...N('bokstelis-prie-azuolo'), alt: 'ArbCut autobokštelis pakeltas prie aukšto ąžuolo' },
  { ...N('bokstelis-prie-pastato'), alt: 'ArbCut autobokštelis prie medžio šalia pastato' },
  { ...N('aukstas-medis-lajoje'), alt: 'Arboristas aukštai plikame medyje, šalia ArbCut autobokštelis' },
  { ...N('aukstas-medis-is-toli'), alt: 'Aukštas medis ir ArbCut autobokštelis pievoje' },
].map((t) => ({ ...t, cat: 'naujos' }));
const tiles = [...naujos, ...galerijosKategorijos.flatMap((k) => k.nr.map((n) => ({ src: G(n), cat: k.id, alt: galerijosAlt[k.id] })))];
---
<BaseLayout
  title="Atlikti darbai: medžių pjovimas ir darbai aukštyje | ArbCut"
  description="Realios ArbCut darbų nuotraukos: pavojingų medžių pjovimas dalimis, audros padariniai, darbai aukštyje, kelmų frezavimas ir gyvatvorės."
  schemas={[localBusiness(), breadcrumbs([{ name: 'Pradžia', path: '/' }, { name: 'Darbai', path: '/galerija' }])]}
>
  <PageHero title="Atlikti darbai" kicker="Realios nuotraukos" lead="Nuotraukos iš mūsų darbų — be stockinių vaizdų. Pirmiausia visa galerija pagal darbų tipą, žemiau — darbo eiga ir keli darbai klientų žodžiais." crumbs={[{ label: 'Darbai' }]} photo="lajoje-vasara" photoAlt="Mantas dirba žaliuojančio medžio lajoje" photoPos="50% 30%" />

  <section class="sec" id="nuotraukos">
    <div class="wrap">
      <div class="sec-head sec-head--split">
        <div><p class="kicker">Galerija</p><h2>Visos nuotraukos</h2></div>
        <p class="mute"><span data-gallery-count>{tiles.length}</span> nuotr.</p>
      </div>
      <div class="flt" role="group" aria-label="Rodyti nuotraukas">
        <button type="button" data-filter="visi" aria-pressed="true">Visos</button>
        <button type="button" data-filter="naujos" aria-pressed="false">Naujausios <small>{naujos.length}</small></button>
        {galerijosKategorijos.map((k) => <button type="button" data-filter={k.id} aria-pressed="false">{k.pavadinimas} <small>{k.nr.length}</small></button>)}
      </div>
      <ul role="list" class="gal tiles" data-lb-group>
        {tiles.map((t) => (
          <li data-cat={t.cat}>
            <button type="button" data-lightbox={t.src} data-caption={t.alt} aria-label={`Padidinti: ${t.alt}`}>
              <img src={t.thumb || t.src} alt={t.alt} width="283" height="230" loading="lazy" decoding="async" />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="sec sec--stone">
    <div class="wrap">
      <div class="sec-head"><p class="kicker">Darbo eiga</p><h2>Nuo pradžios iki sutvarkytos vietos</h2></div>
      <Sequences />
    </div>
  </section>

  <section class="sec" id="darbai">
    <div class="wrap">
      <div class="sec-head"><p class="kicker">Atrinkti darbai</p><h2>Keli darbai klientų žodžiais</h2><p class="mute">Aprašyta pagal klientų atsiliepimus. Vietos ir kainos nurodome tik tada, kai jas parašė pats klientas.</p></div>
      <Darbai />
    </div>
  </section>

</BaseLayout>
<style>
  .flt { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .flt button { min-height: 44px; padding: 8px 16px; background: var(--paper); font-weight: 650; border-radius: var(--radius); transition: background var(--t), color var(--t); }
  .flt button:hover { background: var(--spruce-100); }
  .flt button small { color: var(--ink-2); font-size: .95rem; font-weight: 600; margin-left: 4px; }
  .flt button[aria-pressed='true'] { background: var(--spruce-900); color: #fff; }
  .flt button[aria-pressed='true'] small { color: var(--on-dark-2); }
  .gal li[hidden] { display: none; }
</style>
